.crm-agenda-week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));min-height:470px}.crm-agenda-week-col{border-right:1px solid rgba(11,29,58,.08);min-width:0}.crm-agenda-week-col:last-child{border-right:0}.crm-agenda-week-col>header{height:58px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-bottom:1px solid rgba(11,29,58,.08);background:#F8FAFC}.crm-agenda-week-col>header span{font-size:8px;text-transform:uppercase;color:#7D8998}.crm-agenda-week-col>header strong{font-size:17px;margin-top:3px}.crm-agenda-week-col.today>header strong{width:28px;height:28px;border-radius:999px;background:#0B1D3A;color:#fff;display:grid;place-items:center}.crm-agenda-week-events{padding:8px;display:grid;align-content:start;gap:7px}.crm-agenda-day-empty{font:italic 8px Montserrat,Arial,sans-serif;color:#A1AAB5;text-align:center;padding:18px 0}
.crm-agenda-day-view>header{padding:18px 20px;border-bottom:1px solid rgba(11,29,58,.08);display:flex;align-items:baseline;gap:8px;text-transform:capitalize}.crm-agenda-day-view>header span{color:#7B8795;font-size:10px}.crm-agenda-day-view>header strong{font-size:18px}.crm-agenda-day-list{padding:16px 20px;display:grid;gap:10px}.crm-agenda-day-list>article{display:grid;grid-template-columns:90px minmax(0,1fr);align-items:start;gap:12px}.crm-agenda-day-list time{padding-top:8px;color:#667385;font-size:10px;font-weight:700}
.crm-agenda-year{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.crm-agenda-year-card{background:#fff;border:1px solid rgba(11,29,58,.09);border-radius:11px;overflow:hidden;min-height:155px}.crm-agenda-year-card>header{padding:11px 13px;border-bottom:1px solid rgba(11,29,58,.07);display:flex;justify-content:space-between;gap:8px;text-transform:capitalize}.crm-agenda-year-card>header strong{font-size:11px}.crm-agenda-year-card>header span{font-size:8px;color:#7B8795}.crm-agenda-year-card>div{padding:9px;display:grid;gap:5px}.crm-agenda-year-card>div>small{font:italic 8px Montserrat,Arial,sans-serif;color:#9CA6B1;padding:12px 2px}
