  function crmAgendaFormModal(mode,item){
    const edit=mode==='edit';
    const e=item || {type:'',status:'agendado',title:'',participants:'',startDate:'',startTime:'',endDate:'',endTime:'',venue:'',venueContactId:'',contact:'',address:'',capacity:'',cache:'',expected:'',description:'',notes:''};
    const pj=crmAgendaPJContacts();
    return `<div class="crm-agenda-modal-backdrop" data-action="crm-agenda-close"></div><section class="crm-agenda-modal crm-agenda-form-modal" role="dialog" aria-modal="true" aria-label="${edit?'Editar Evento':'Novo Evento na Agenda'}">
      <header><div><h2>${edit?'Editar Evento':'Novo Evento na Agenda'}</h2></div><button type="button" data-action="crm-agenda-close" aria-label="Fechar">×</button></header>
      <form id="crm-agenda-form" data-mode="${mode}" data-id="${esc(e.id||'')}">
        <div class="crm-agenda-modal-body">
          <div class="crm-agenda-form-grid two">
            <label class="crm-agenda-field full"><span>Título do Evento *</span><input name="title" value="${esc(e.title||'')}" placeholder="Digite o título do evento" required></label>
            ${crmAgendaSelect('Tipo de Evento *','type',e.type,[['','Selecione o tipo'],...CRM_AGENDA_TYPES],'required')}
            ${crmAgendaField('Participantes do Evento','participants',e.participants||'','text','placeholder="Selecione participantes"')}
            ${crmAgendaSelect('Status','status',e.status,CRM_AGENDA_STATUSES)}
          </div>

          <div class="crm-agenda-form-grid two">
            ${crmAgendaField('Data de Início *','startDate',e.startDate||'','date','required')}
            ${crmAgendaField('Horário de Início','startTime',e.startTime||'','time')}
            ${crmAgendaField('Data de Fim','endDate',e.endDate||'','date')}
            ${crmAgendaField('Horário de Fim','endTime',e.endTime||'','time')}
          </div>

          <div id="crm-agenda-location-fields" class="crm-agenda-form-grid two" hidden>
            <label id="crm-agenda-local-crm-field" class="crm-agenda-field"><span>Nome do Local</span><select name="venueContactId"><option value="">Selecione o local (CRM)</option>${pj.map((c)=>`<option value="${esc(c.id)}" ${String(e.venueContactId||'')===String(c.id)?'selected':''}>${esc(c.company||c.name)}</option>`).join('')}</select></label>
            <label id="crm-agenda-local-free-field" class="crm-agenda-field"><span>Nome do Local</span><input name="venue" value="${esc(e.venue||'')}" placeholder="Nome do venue / casa de show"></label>
            ${crmAgendaField('Contato do Local','contact',e.contact||'','text','placeholder="Telefone / WhatsApp do local"')}
            <label class="crm-agenda-field full"><span>Endereço Completo</span><input name="address" value="${esc(e.address||'')}" placeholder="Endereço completo do local"></label>
          </div>

          <div id="crm-agenda-show-fields" class="crm-agenda-form-grid three" hidden>
            ${crmAgendaField('Capacidade do Público','capacity',e.capacity||'','number','min="0" placeholder="Capacidade máxima do local"')}
            ${crmAgendaField('Valor do Cachê','cache',e.cache||'','number','min="0" step="0.01" placeholder="0,00"')}
            ${crmAgendaField('Público Esperado','expected',e.expected||'','number','min="0" placeholder="Quantidade de pessoas esperadas"')}
          </div>

          <div class="crm-agenda-form-grid two">
            ${crmAgendaTextarea('Descrição','description',e.description||'','Descrição do evento')}
            ${crmAgendaTextarea('Observações','notes',e.notes||'','Observações sobre o evento')}
          </div>
        </div>
        <footer><button type="button" class="secondary" data-action="crm-agenda-close">Cancelar</button><button type="submit" class="primary">Salvar Evento</button></footer>
      </form>
    </section>`;
  }

  function crmAgendaViewRow(label,value){ return `<div class="crm-agenda-view-row"><span>${label}</span><strong>${value || '—'}</strong></div>`; }
  function crmAgendaViewSection(title,content){ return `<section class="crm-agenda-view-section"><h3>${title}</h3>${content}</section>`; }

  function crmAgendaViewModal(e){
    const participantCards=String(e.participants||'').split(',').map((v)=>v.trim()).filter(Boolean).map((name)=>`<article class="crm-agenda-participant"><div>${icon('users',16)}</div><strong>${esc(name)}</strong></article>`).join('');
    return `<div class="crm-agenda-modal-backdrop" data-action="crm-agenda-close"></div><section class="crm-agenda-modal crm-agenda-view-modal" role="dialog" aria-modal="true" aria-label="Visualizar Evento">
      <header class="crm-agenda-view-header"><div><h2>${esc(e.title)}</h2><p>Detalhes completos do evento</p></div><div class="crm-agenda-view-badges"><span>${esc(crmAgendaTypeLabel(e.type))}</span><b class="${crmAgendaStatusClass(e.status)}">${esc(crmAgendaStatusLabel(e.status))}</b></div><button type="button" data-action="crm-agenda-close" aria-label="Fechar">×</button></header>
      <div class="crm-agenda-modal-body">
        ${crmAgendaViewSection('Quando',`<div class="crm-agenda-view-grid four">${crmAgendaViewRow('Data Início',crmAgendaFormatDate(e.startDate))}${crmAgendaViewRow('Horário Início',esc(e.startTime||'—'))}${crmAgendaViewRow('Data Fim',crmAgendaFormatDate(e.endDate))}${crmAgendaViewRow('Horário Fim',esc(e.endTime||'—'))}</div>`)}
        ${(e.venue||e.address)?crmAgendaViewSection('Onde',`<div class="crm-agenda-view-grid two">${crmAgendaViewRow('Local',esc(e.venue||'—'))}${crmAgendaViewRow('Endereço',esc(e.address||'—'))}</div>`):''}
        ${participantCards?crmAgendaViewSection('Participantes do Evento',`<div class="crm-agenda-participants">${participantCards}</div>`):''}
        ${(e.contact)?crmAgendaViewSection('Contato no Local',`<div class="crm-agenda-view-grid three">${crmAgendaViewRow('Responsável / Contato',esc(e.contact))}${crmAgendaViewRow('Telefone','—')}${crmAgendaViewRow('E-mail','—')}</div>`):''}
        ${(e.cache||e.capacity||e.expected)?crmAgendaViewSection('Detalhes Operacionais',`<div class="crm-agenda-ops">${e.cache?`<article><span>Cachê</span><strong>${crmAgendaMoney(e.cache)}</strong></article>`:''}${e.capacity?`<article><span>Capacidade</span><strong>${Number(e.capacity).toLocaleString('pt-BR')}</strong></article>`:''}${e.expected?`<article><span>Público Esperado</span><strong>${Number(e.expected).toLocaleString('pt-BR')}</strong></article>`:''}</div>`):''}
        ${e.description?crmAgendaViewSection('Descrição',`<p class="crm-agenda-view-text">${esc(e.description)}</p>`):''}
        ${e.notes?crmAgendaViewSection('Observações',`<p class="crm-agenda-view-text muted">${esc(e.notes)}</p>`):''}
      </div>
      <footer><button type="button" class="secondary" data-action="crm-agenda-close">Fechar</button><button type="button" class="primary" data-action="crm-agenda-edit" data-id="${esc(e.id)}">${icon('edit',14)} Editar</button></footer>
    </section>`;
  }

  function crmAgendaToggleConditionalFields(){
    const form=document.getElementById('crm-agenda-form'); if(!form) return;
    const type=form.elements.type?.value || '';
    const showLocal=CRM_AGENDA_ARTIST_RELATED.includes(type) || type==='reunioes';
    const useCRM=CRM_AGENDA_LOCAL_CRM.includes(type);
    const local=document.getElementById('crm-agenda-location-fields');
    const show=document.getElementById('crm-agenda-show-fields');
    if(local) local.hidden=!showLocal;
    if(show) show.hidden=type!=='shows';
    const crmField=document.getElementById('crm-agenda-local-crm-field');
    const freeField=document.getElementById('crm-agenda-local-free-field');
    const crmSelect=form.elements.venueContactId;
    const freeInput=form.elements.venue;
    if(crmField) crmField.hidden=!useCRM;
    if(freeField) freeField.hidden=useCRM;
    if(crmSelect) crmSelect.disabled=!useCRM;
    if(freeInput) freeInput.disabled=useCRM;
    if(type==='reunioes' && freeInput) freeInput.placeholder='Nome do local da reunião';
    else if(freeInput) freeInput.placeholder='Nome do venue / casa de show';
  }

  function crmAgendaFillCRMVenue(){
    const form=document.getElementById('crm-agenda-form'); if(!form) return;
