.crm-agenda-kpi span{display:block;color:#687588;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.crm-agenda-kpi strong{display:block;margin-top:5px;color:#0B1D3A;font-size:22px;line-height:1}.crm-agenda-kpi small{display:block;margin-top:5px;color:#8A95A3;font:9px/1.35 Montserrat,Arial,sans-serif}
.crm-agenda-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;background:rgba(233,237,242,.62);border:1px solid rgba(11,29,58,.07);border-radius:10px;padding:10px;margin-bottom:18px}.crm-agenda-toolbar>button,.crm-agenda-toolbar>select{height:34px;border:1px solid rgba(11,29,58,.14);background:#fff;color:#0B1D3A;border-radius:8px;padding:0 10px;font:700 10px Raleway,Arial,sans-serif;cursor:pointer}.crm-agenda-toolbar>button.icon-only{width:34px;padding:0;font-size:18px}.crm-agenda-period{min-width:155px;padding:0 3px;color:#667385;font-size:11px;font-weight:700;text-transform:capitalize}.crm-agenda-search{height:34px;flex:1;min-width:220px;display:flex;align-items:center;gap:7px;border:1px solid rgba(11,29,58,.13);background:#fff;border-radius:8px;padding:0 10px;color:#7C8796}.crm-agenda-search input{border:0!important;outline:0!important;background:#fff!important;color:#0B1D3A!important;width:100%;height:100%;padding:0!important;font:10px Montserrat,Arial,sans-serif}.crm-agenda-toolbar select{min-width:110px}.crm-agenda-toolbar select:nth-of-type(2),.crm-agenda-toolbar select:nth-of-type(3){min-width:145px}
.crm-agenda-calendar{background:#fff;border:1px solid rgba(11,29,58,.09);border-radius:12px;overflow:hidden}.crm-agenda-weekdays{display:grid;grid-template-columns:repeat(7,1fr);background:#F8FAFC;border-bottom:1px solid rgba(11,29,58,.08)}.crm-agenda-weekdays span{padding:10px 12px;color:#7A8594;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;text-align:center}.crm-agenda-month-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.crm-agenda-day{min-height:128px;border-right:1px solid rgba(11,29,58,.07);border-bottom:1px solid rgba(11,29,58,.07);padding:8px;min-width:0}.crm-agenda-day:nth-child(7n){border-right:0}.crm-agenda-day.muted{background:#FBFCFD;color:#A2ABB6}.crm-agenda-day.today>header span{background:#0B1D3A;color:#fff}.crm-agenda-day>header{display:flex;justify-content:flex-end;margin-bottom:6px}.crm-agenda-day>header span{width:25px;height:25px;border-radius:999px;display:grid;place-items:center;font-size:10px;font-weight:800}.crm-agenda-day>div{display:grid;gap:4px}.crm-agenda-more{font-size:8px;color:#7D8896;padding:3px 2px}
.crm-agenda-event-chip{width:100%;border:1px solid rgba(11,29,58,.09);border-radius:7px;background:#F8FAFC;text-align:left;padding:7px 8px;display:grid;gap:2px;cursor:pointer;color:#0B1D3A;overflow:hidden}.crm-agenda-event-chip span{font:8px/1.2 Montserrat,Arial,sans-serif;color:#7A8796}.crm-agenda-event-chip strong{font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crm-agenda-event-chip small{font-size:8px;color:#8290A0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crm-agenda-event-chip.confirmed{background:#ECF8F1;border-color:#CFEBDD}.crm-agenda-event-chip.done{background:#EEF7FD;border-color:#D3E9F8}.crm-agenda-event-chip.pending{background:#FFF8E9;border-color:#F1E2BB}.crm-agenda-event-chip.cancelled{background:#FFF0F1;border-color:#F1D0D3}.crm-agenda-event-chip.compact{padding:4px 5px;border-radius:5px}.crm-agenda-event-chip.compact span{font-size:7px}.crm-agenda-event-chip.compact strong{font-size:8px}
