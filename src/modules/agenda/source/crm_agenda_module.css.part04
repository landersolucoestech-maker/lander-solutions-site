
/* AGENDA REFERENCE FIDELITY + LIGHT CONTROLS */
.crm-agenda-workspace,.crm-agenda-modal-root{color-scheme:light!important}.crm-agenda-form-modal{width:min(768px,100%)!important}.crm-agenda-view-modal{width:min(896px,100%)!important;border-radius:28px!important}
html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-toolbar{background:rgba(233,237,242,.62)!important;border-color:rgba(11,29,58,.07)!important}
html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-kpi,html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-calendar,html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-year-card,html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-empty,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-modal,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-modal-body,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-modal footer{background:#fff!important;color:#0B1D3A!important}
html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-toolbar>button,html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-toolbar>select,html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-search,html[data-theme="dark"] .crm-agenda-workspace .crm-agenda-search input,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-modal input:not([type="checkbox"]),html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-modal select,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-modal textarea,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-picker-trigger,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-picker-menu,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-picker-search,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-picker-search input,html[data-theme="dark"] .crm-agenda-modal-root .crm-agenda-venue-option{background:#fff!important;background-color:#fff!important;color:#0B1D3A!important;border-color:rgba(11,29,58,.14)!important;color-scheme:light!important}
html[data-theme="dark"] .crm-agenda-workspace select option,html[data-theme="dark"] .crm-agenda-modal-root select option{background:#fff!important;color:#0B1D3A!important}html[data-theme="dark"] .crm-agenda-workspace input::placeholder,html[data-theme="dark"] .crm-agenda-modal-root input::placeholder,html[data-theme="dark"] .crm-agenda-modal-root textarea::placeholder{color:#64748B!important;opacity:1!important}
.crm-agenda-picker{position:relative;min-width:0}.crm-agenda-picker-trigger{width:100%;height:38px;border:1px solid rgba(11,29,58,.14);border-radius:8px;background:#fff;color:#0B1D3A;padding:0 10px;display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left;font:11px Montserrat,Arial,sans-serif;cursor:pointer}.crm-agenda-picker-trigger>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crm-agenda-picker-trigger .placeholder{color:#64748B;font-weight:500}.crm-agenda-picker-trigger:focus{outline:0;border-color:#D4AF37;box-shadow:0 0 0 2px rgba(212,175,55,.12)}
.crm-agenda-picker-menu{position:absolute;z-index:500;left:0;right:0;top:calc(100% + 5px);background:#fff;border:1px solid rgba(11,29,58,.14);border-radius:8px;box-shadow:0 12px 30px rgba(11,29,58,.14);padding:6px;max-height:288px;overflow:auto}.crm-agenda-picker-menu[hidden]{display:none!important}.crm-agenda-picker-search{height:32px;display:flex;align-items:center;gap:6px;border:1px solid rgba(11,29,58,.12);border-radius:7px;padding:0 8px;background:#fff;color:#526174}.crm-agenda-picker-search input{height:30px!important;border:0!important;outline:0!important;box-shadow:none!important;padding:0!important;background:#fff!important;color:#0B1D3A!important;font:11px Montserrat,Arial,sans-serif!important}.crm-agenda-picker-list{display:grid;gap:2px;margin-top:5px}
.crm-agenda-picker-option{min-height:34px;padding:6px 8px;border-radius:6px;display:flex;align-items:center;gap:9px;background:#fff;color:#0B1D3A;cursor:pointer}.crm-agenda-picker-option:hover,.crm-agenda-venue-option:hover{background:#F5F7FA}.crm-agenda-picker-option input[type="checkbox"]{appearance:auto!important;-webkit-appearance:checkbox!important;accent-color:auto!important;width:auto!important;height:auto!important;background:initial!important;border:initial!important;box-shadow:none!important}.crm-agenda-picker-option>span{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0;width:100%}.crm-agenda-picker-option strong{font-size:11px}.crm-agenda-picker-option small,.crm-agenda-venue-option small{font:500 11px/1.4 Montserrat,Arial,sans-serif;color:#526174}.crm-agenda-picker-empty{margin:0;padding:10px 8px;color:#526174;font:500 11px/1.45 Montserrat,Arial,sans-serif}
.crm-agenda-venue-option{width:100%;min-height:38px;border:0;border-radius:6px;padding:7px 8px;background:#fff;color:#0B1D3A;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:2px}.crm-agenda-money-input{position:relative;display:flex;align-items:center}.crm-agenda-money-input>span{position:absolute;left:10px;color:#526174;font:500 11px Montserrat,Arial,sans-serif;pointer-events:none}.crm-agenda-money-input>input{padding-left:34px!important;width:100%}
.crm-agenda-view-header{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:18px!important;padding:24px 24px 16px!important;border-bottom:1px solid rgba(11,29,58,.08)!important}.crm-agenda-view-header>div{min-width:0;flex:1}.crm-agenda-view-header h2{font-size:24px!important;font-weight:600!important;letter-spacing:-.02em}.crm-agenda-view-badges{margin-top:12px!important}.crm-agenda-view-body{padding:20px 24px!important;gap:24px!important}.crm-agenda-view-section{gap:12px!important}.crm-agenda-view-section h3{text-transform:none!important;letter-spacing:.03em!important;font-size:11px!important;color:#475569!important}.crm-agenda-participant{background:#fff!important;display:flex!important;align-items:center!important;gap:10px!important}.crm-agenda-participant>div:first-child{width:40px!important;height:40px!important;flex:0 0 auto}.crm-agenda-participant-copy{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1}.crm-agenda-participant-copy small{font:500 11px/1.4 Montserrat,Arial,sans-serif;color:#526174}.crm-agenda-participant-contact{display:flex;flex-direction:column;gap:3px;text-align:right;color:#526174;font:500 11px/1.4 Montserrat,Arial,sans-serif}.crm-agenda-ops article,.crm-agenda-view-text{background:#fff!important;border:1px solid rgba(11,29,58,.09)!important}
@media(max-width:760px){.crm-agenda-view-header{padding:19px 18px 14px!important}.crm-agenda-view-header h2{font-size:20px!important}.crm-agenda-view-body{padding:16px 18px!important}.crm-agenda-participant-contact{display:none}}
