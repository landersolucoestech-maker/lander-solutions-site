teNewRevision(a.id);e.service.submitToReview(b.id);e.service.approve(b.id);const feed=e.service.obligationsFeed();eq(feed.length,1);eq(feed[0].participationCalculationId,b.id);});
test('demo não entra no feed',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1',isDemo:true});r.workflowStatus='approved';r.consistencyStatus='consistent';eq(e.service.obligationsFeed().length,0);});
test('feed preserva participante amount moeda período',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(r.id);e.service.approve(r.id);const f=e.service.obligationsFeed()[0];eq(f.participantPartyId,'p1');close(f.amountDue,r.participationAmount);eq(f.currency,'BRL');eq(f.periodStart,'2026-08-01');eq(f.periodEnd,'2026-08-31');});
test('dueDate é null sem prazo contratual explícito',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(r.id);e.service.approve(r.id);eq(e.service.obligationsFeed()[0].dueDate,null);});
test('feed de Repasses é read-only sobre Participações',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(r.id);e.service.approve(r.id);const before=JSON.stringify(e.state);const feed=e.service.obligationsFeed();feed[0].amountDue=999999;eq(JSON.stringify(e.state),before);});
test('feed não cria Repasse nem Transação',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(r.id);e.service.approve(r.id);e.service.obligationsFeed();assert(!('payouts' in e.state));assert(!('transactions' in e.state));});

// Legacy/demo/separation.
test('legado sem Contrato/Versão/Regra não migra',()=>{const e=makeEnv({rules:[percentageRule()]});const result=e.service.migrateLegacy([{id:'legacy1',partner:'Sócio',percentage:50}]);eq(result.migrated,0);assert(e.state.metadata.legacySkipped.some(x=>x.reason==='insufficient_contract_traceability'));});
test('legado rastreável ainda exige recálculo explícito',()=>{const e=makeEnv({rules:[percentageRule()]});const result=e.service.migrateLegacy([{id:'legacy2',contractId:'ctr1',contractVersionId:'v1',economicRuleId:'r1',participantPartyId:'p1',periodStart:'2026-08-01',periodEnd:'2026-08-31',basisType:'gross_revenue'}]);eq(result.migrated,0);assert(e.state.metadata.legacySkipped.some(x=>x.reason==='legacy_requires_explicit_recalculation'));});
test('Participação não possui status de pagamento',()=>{for(const bad of ['paid','partially_paid','paying'])assert(!Core.WORKFLOW_STATUSES.includes(bad));});
test('core não cria payment/payout/transaction',()=>{const src=fs.readFileSync(__filename.replace('test_crm_economic_participations.js','crm_economic_participations_core.js'),'utf8');assert(!src.includes('createTransaction('));assert(!src.includes('createPayout('));assert(!src.includes('paidAmount'));});
test('core não usa Societário como fonte automática',()=>{const src=fs.readFileSync(__filename.replace('test_crm_economic_participations.js','crm_economic_participations_core.js'),'utf8').toLowerCase();for(const token of ['shareholder','partnerownership','equitypercentage','sharepercentage','quota societ'])assert(!src.includes(token));});
test('regra econômica não é duplicada em participationRules',()=>{const src=fs.readFileSync(__filename.replace('test_crm_economic_participations.js','crm_economic_participations_core.js'),'utf8');for(const token of ['participationRules','partnerPercentages','revenueShareRules','productPartnerRules'])assert(!src.includes(token));});

if(process.argv.includes('--materialized')){
  const app=fs.readFileSync(path.resolve(__dirname,'..','app.js'),'utf8');
  test('bundle contém domínio canônico de Participações',()=>{assert(app.includes('VALTREN ECONOMIC PARTICIPATIONS START'));assert(app.includes('ValtrenParticipationCore'));assert(app.includes('state.crmEconomicParticipations'));});
  test('rota canônica Participações está materializada',()=>{assert(app.includes("if(path==='/crm/financeiro/participacoes')return crmEconomicParticipationsPage();"));});
  test('placeholder de Participações não sobrevive',()=>{assert(!app.includes("if(path==='/crm/financeiro/participacoes')return crmArchitecturePlaceholderPage"));});
  test('Repasses permanece placeholder',()=>{assert(app.includes("if(path==='/crm/financeiro/repasses')return crmArchitecturePlaceholderPage('accounting','repasses','Repasses');"));});
  test('Contratos continua canônico',()=>{assert(app.includes("if(path==='/crm/juridico/contratos')return crmLegalContractsPage();"));});
  test('Rateios continua canônico',()=>{assert(app.includes("if(path==='/crm/financeiro/rateios'){const page=crmCostAllocationsPage();"));});
  test('Notas Fiscais continua canônica',()=>{assert(app.includes("if(path==='/crm/financeiro/notas-fiscais')return crmFiscalDocumentsPage();"));});
  test('Contabilidade continua canônica',()=>{assert(app.includes("if(path==='/crm/financeiro/accounting')return crmAccountingPage();"));});
  test('Transações continua canônica',()=>{assert(app.includes("if(path==='/crm/financeiro')return crmTransactionsPage();"));});
  test('feed futuro de Repasses está no bundle',()=>{assert(app.includes('function crmParticipationObligationsFeed(filters={})'));});
  test('bundle não cria Repasse/Transação em Participações',()=>{const start=app.indexOf('// VALTREN ECONOMIC PARTICIPATIONS START'),end=app.indexOf('// VALTREN ECONOMIC PARTICIPATIONS END',start),block=app.slice(start,end);assert(!block.includes('createTransaction('));assert(!block.includes('createPayout('));assert(!block.includes('paidAmount'));});
  test('Configurações mantém seis abas canônicas atuais',()=>{const start=app.indexOf('function crmCanonicalSettingsPage()'),end=app.indexOf('function crmCanonicalProfilePage()',start),settings=app.slice(start,end),canonical=["['empresa','Empresa']","['notificacoes','Notificações']","['seguranca','Segurança']","['integracoes','Integrações']","['auditoria','Auditoria']","['usuarios','Usuários']"];assert(start>=0&&end>start);for(const label of canonical)assert(settings.includes(label));assert(!settings.includes("['billing','Billing']"));});
  test('Administração mantém dois itens canônicos atuais',()=>{const start=app.lastIndexOf('const administration=['),end=app.indexOf('];',start),admin=app.slice(start,end);for(const item of ["['structure','Estrutura Organizacional','#/crm/administracao']","['assets','Patrimônio e Licenças','#/crm/administracao/patrimonio-licencas']"])assert(admin.includes(item));assert(!admin.includes('Auditoria'));});
}
console.log(`Economic Participations domain tests: ${passed} passed`);
