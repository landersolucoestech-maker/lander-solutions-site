
  // VALTREN CRM AGENDA FIDELITY START
  function crmAgendaSplitParticipants(value){ return String(value||'').split(',').map((v)=>v.trim()).filter(Boolean); }
  function crmAgendaParticipantOptions(){
    if(typeof crmRelEnsureState==='function') crmRelEnsureState();
    const contacts=Array.isArray(state.crmRelContacts)?state.crmRelContacts:[];
    const rows=contacts.map((c)=>({label:String(c.name||c.company||c.email||''),category:String(c.segment||c.profile||'Contato'),email:String(c.email||''),phone:String(c.phone||'')}));
    rows.push({label:String(state.crmUserName||'Administrador'),category:'Usuário',email:'',phone:''});
    const seen=new Set();
    return rows.filter((r)=>{const k=r.label.trim().toLowerCase();if(!k||seen.has(k))return false;seen.add(k);return true;}).sort((a,b)=>a.label.localeCompare(b.label,'pt-BR'));
  }
  function crmAgendaParticipantSummary(value){ const a=crmAgendaSplitParticipants(value);return !a.length?'':a.length<=2?a.join(', '):`${a[0]}, ${a[1]} +${a.length-2}`; }
  function crmAgendaParticipantPicker(value=''){
    const selected=crmAgendaSplitParticipants(value), options=crmAgendaParticipantOptions(), summary=crmAgendaParticipantSummary(value);
    return `<label class="crm-agenda-field"><span>Participantes do Evento</span><div class="crm-agenda-picker crm-agenda-participant-picker"><input type="hidden" name="participants" value="${esc(value||'')}"><button type="button" class="crm-agenda-picker-trigger" data-action="crm-agenda-participants-toggle"><span data-crm-agenda-participant-summary class="${summary?'':'placeholder'}">${esc(summary||'Selecione participantes')}</span><b>⌄</b></button><div class="crm-agenda-picker-menu" data-crm-agenda-participants-menu hidden><label class="crm-agenda-picker-search">${icon('search',14)}<input type="search" data-crm-agenda-participant-search placeholder="Buscar artista ou funcionário…" autocomplete="off"></label><div class="crm-agenda-picker-list">${options.length?options.map((o)=>`<label class="crm-agenda-picker-option" data-search="${esc([o.label,o.category,o.email,o.phone].join(' ').toLowerCase())}"><input type="checkbox" data-action="crm-agenda-participant-toggle" data-name="${esc(o.label)}" ${selected.includes(o.label)?'checked':''}><span><strong>${esc(o.label)}</strong>${o.category?`<small>${esc(o.category)}</small>`:''}</span></label>`).join(''):'<p class="crm-agenda-picker-empty">Nenhum participante encontrado</p>'}</div></div></div></label>`;
  }
  function crmAgendaVenuePicker(valueId=''){
    const rows=crmAgendaPJContacts(), selected=rows.find((c)=>String(c.id)===String(valueId));
    return `<label id="crm-agenda-local-crm-field" class="crm-agenda-field"><span>Nome do Local</span><div class="crm-agenda-picker crm-agenda-venue-picker"><input type="hidden" name="venueContactId" value="${esc(valueId||'')}"><button type="button" class="crm-agenda-picker-trigger" data-action="crm-agenda-venue-toggle"><span data-crm-agenda-venue-summary class="${selected?'':'placeholder'}">${esc(selected?(selected.company||selected.name):'Selecione o local (CRM)')}</span><b>⌄</b></button><div class="crm-agenda-picker-menu" data-crm-agenda-venue-menu hidden><label class="crm-agenda-picker-search">${icon('search',14)}<input type="search" data-crm-agenda-venue-search placeholder="Buscar local…" autocomplete="off"></label><div class="crm-agenda-picker-list">${rows.length?rows.map((c)=>`<button type="button" class="crm-agenda-venue-option" data-action="crm-agenda-venue-select" data-id="${esc(c.id)}" data-name="${esc(c.company||c.name)}" data-search="${esc([c.company,c.name,c.city,c.email,c.phone].join(' ').toLowerCase())}"><strong>${esc(c.company||c.name)}</strong>${c.city?`<small>${esc(c.city)}</small>`:''}</button>`).join(''):'<p class="crm-agenda-picker-empty">Nenhum local encontrado no CRM</p>'}</div></div></div></label>`;
  }
  function crmAgendaFormModal(mode,item){
    const edit=mode==='edit';
    const e=item||{type:'',status:'agendado',title:'',participants:'',startDate:'',startTime:'',endDate:'',endTime:'',venue:'',venueContactId:'',contact:'',address:'',capacity:'',cache:'',expected:'',description:'',notes:''};
    return `<div class="crm-agenda-modal-backdrop" data-action="crm-agenda-close"></div><section class="crm-agenda-modal crm-agenda-form-modal" role="dialog" aria-modal="true"><header><div><h2>${edit?'Editar Evento':'Novo Evento na Agenda'}</h2></div><button type="button" data-action="crm-agenda-close" aria-label="Fechar">×</button></header><form id="crm-agenda-form" data-mode="${mode}" data-id="${esc(e.id||'')}"><div class="crm-agenda-modal-body">
      <div class="crm-agenda-form-grid two"><label class="crm-agenda-field full"><span>Título do Evento *</span><input name="title" value="${esc(e.title||'')}" placeholder="Digite o título do evento" required></label>${crmAgendaSelect('Tipo de Evento *','type',e.type,[['','Selecione o tipo'],...CRM_AGENDA_TYPES],'required')}${crmAgendaParticipantPicker(e.participants||'')}${crmAgendaSelect('Status','status',e.status,CRM_AGENDA_STATUSES)}</div>
      <div class="crm-agenda-form-grid two">${crmAgendaField('Data de Início *','startDate',e.startDate||'','date','required')}${crmAgendaField('Horário de Início','startTime',e.startTime||'','time')}${crmAgendaField('Data de Fim','endDate',e.endDate||'','date')}${crmAgendaField('Horário de Fim','endTime',e.endTime||'','time')}</div>
      <div id="crm-agenda-location-fields" class="crm-agenda-form-grid two" hidden>${crmAgendaVenuePicker(e.venueContactId||'')}<label id="crm-agenda-local-free-field" class="crm-agenda-field"><span>Nome do Local</span><input name="venue" value="${esc(e.venue||'')}" placeholder="Nome do venue / casa de show"></label>${crmAgendaField('Contato do Local','contact',e.contact||'','text','placeholder="Telefone / WhatsApp do local"')}<label class="crm-agenda-field full"><span>Endereço Completo</span><input name="address" value="${esc(e.address||'')}" placeholder="Endereço completo do local"></label></div>
      <div id="crm-agenda-show-fields" class="crm-agenda-form-grid three" hidden>${crmAgendaField('Capacidade do Público','capacity',e.capacity||'','number','min="0" placeholder="Capacidade máxima do local"')}<label class="crm-agenda-field"><span>Valor do Cachê</span><div class="crm-agenda-money-input"><span>R$</span><input type="number" name="cache" value="${esc(e.cache||'')}" min="0" step="0.01" placeholder="0,00"></div></label>${crmAgendaField('Público Esperado','expected',e.expected||'','number','min="0" placeholder="Quantidade de pessoas esperadas"')}</div>
      <div class="crm-agenda-form-grid two">${crmAgendaTextarea('Descrição','description',e.description||'','Descrição do evento')}${crmAgendaTextarea('Observações','notes',e.notes||'','Observações sobre o evento')}</div>
      </div><footer><button type="button" class="secondary" data-action="crm-agenda-close">Cancelar</button><button type="submit" class="primary">Salvar Evento</button></footer></form></section>`;
  }
  function crmAgendaViewSection(title,content){ return `<section class="crm-agenda-view-section"><h3>${title}</h3>${content}</section>`; }
  function crmAgendaViewModal(e){
    if(typeof crmRelEnsureState==='function')crmRelEnsureState();
    const contacts=Array.isArray(state.crmRelContacts)?state.crmRelContacts:[];
    const cards=crmAgendaSplitParticipants(e.participants).map((name)=>{const c=contacts.find((x)=>String(x.name||x.company||'').toLowerCase()===name.toLowerCase());return `<article class="crm-agenda-participant"><div>${icon('users',16)}</div><div class="crm-agenda-participant-copy"><strong>${esc(name)}</strong>${c?.segment?`<small>${esc(c.segment)}</small>`:''}</div>${(c?.email||c?.phone)?`<div class="crm-agenda-participant-contact">${c.email?`<span>${esc(c.email)}</span>`:''}${c.phone?`<span>${esc(c.phone)}</span>`:''}</div>`:''}</article>`;}).join('');
    const venue=crmAgendaPJContacts().find((c)=>String(c.id)===String(e.venueContactId||''));
    const responsible=venue?.responsible||venue?.name||'', phone=venue?.phone||e.contact||'', email=venue?.email||'';
    return `<div class="crm-agenda-modal-backdrop" data-action="crm-agenda-close"></div><section class="crm-agenda-modal crm-agenda-view-modal" role="dialog" aria-modal="true"><header class="crm-agenda-view-header"><div><h2>${esc(e.title)}</h2><p>Detalhes completos do evento</p><div class="crm-agenda-view-badges"><span>${esc(crmAgendaTypeLabel(e.type))}</span><b class="${crmAgendaStatusClass(e.status)}">${esc(crmAgendaStatusLabel(e.status))}</b></div></div><button type="button" data-action="crm-agenda-close">×</button></header><div class="crm-agenda-modal-body crm-agenda-view-body">
      ${crmAgendaViewSection('Quando',`<div class="crm-agenda-view-grid four">${crmAgendaViewRow('Data Início',crmAgendaFormatDate(e.startDate))}${crmAgendaViewRow('Horário Início',esc(e.startTime||'—'))}${crmAgendaViewRow('Data Fim',crmAgendaFormatDate(e.endDate))}${crmAgendaViewRow('Horário Fim',esc(e.endTime||'—'))}</div>`)}
      ${crmAgendaViewSection('Onde',`<div class="crm-agenda-view-grid two">${crmAgendaViewRow('Local',esc(e.venue||'—'))}${crmAgendaViewRow('Endereço',esc(e.address||'—'))}</div>`)}
      ${cards?crmAgendaViewSection('Participantes do Evento',`<div class="crm-agenda-participants">${cards}</div>`):''}
      ${(responsible||phone||email)?crmAgendaViewSection('Contato no Local',`<div class="crm-agenda-view-grid three">${crmAgendaViewRow('Responsável',esc(responsible||'—'))}${crmAgendaViewRow('Telefone',esc(phone||'—'))}${crmAgendaViewRow('E-mail',esc(email||'—'))}</div>`):''}
      ${(e.cache||e.capacity||e.expected)?crmAgendaViewSection('Detalhes Operacionais',`<div class="crm-agenda-ops">${e.cache?`<article><span>Cachê</span><strong>${crmAgendaMoney(e.cache)}</strong></article>`:''}${e.capacity?`<article><span>Capacidade</span><strong>${Number(e.capacity).toLocaleString('pt-BR')}</strong></article>`:''}${e.expected?`<article><span>Público Esperado</span><strong>${Number(e.expected).toLocaleString('pt-BR')}</strong></article>`:''}</div>`):''}
      ${e.description?crmAgendaViewSection('Descrição',`<p class="crm-agenda-view-text">${esc(e.description)}</p>`):''}${e.notes?crmAgendaViewSection('Observações',`<p class="crm-agenda-view-text muted">${esc(e.notes)}</p>`):''}
      </div><footer><button type="button" class="secondary" data-action="crm-agenda-close">Fechar</button><button type="button" class="primary" data-action="crm-agenda-edit" data-id="${esc(e.id)}">${icon('edit',14)} Editar</button></footer></section>`;
  }
  if(!window.__valtrenCrmAgendaFidelityBound){
    window.__valtrenCrmAgendaFidelityBound=true;
    document.addEventListener('click',(event)=>{
      const t=event.target.closest('[data-action]');
      if(!t){if(!event.target.closest('.crm-agenda-picker'))document.querySelectorAll('.crm-agenda-picker-menu').forEach((m)=>m.hidden=true);return;}
      const a=t.dataset.action;
      if(a==='crm-agenda-participants-toggle'||a==='crm-agenda-venue-toggle'){event.preventDefault();event.stopPropagation();const sel=a.includes('participants')?'[data-crm-agenda-participants-menu]':'[data-crm-agenda-venue-menu]';const m=t.closest('.crm-agenda-picker')?.querySelector(sel);if(m){const opening=m.hidden;document.querySelectorAll('.crm-agenda-picker-menu').forEach((x)=>x.hidden=true);m.hidden=!opening;if(opening)setTimeout(()=>m.querySelector('input[type="search"]')?.focus(),0);}return;}
      if(a==='crm-agenda-participant-toggle'){event.stopPropagation();const f=t.closest('form'),h=f?.elements.participants;if(!h)return;const s=new Set(crmAgendaSplitParticipants(h.value)),n=t.dataset.name||'';t.checked?s.add(n):s.delete(n);h.value=Array.from(s).join(', ');const v=crmAgendaParticipantSummary(h.value),x=f.querySelector('[data-crm-agenda-participant-summary]');if(x){x.textContent=v||'Selecione participantes';x.classList.toggle('placeholder',!v);}return;}
      if(a==='crm-agenda-venue-select'){event.preventDefault();event.stopPropagation();const f=t.closest('form'),h=f?.elements.venueContactId;if(h)h.value=t.dataset.id||'';const x=f?.querySelector('[data-crm-agenda-venue-summary]');if(x){x.textContent=t.dataset.name||'Selecione o local (CRM)';x.classList.remove('placeholder');}t.closest('.crm-agenda-picker-menu')?.setAttribute('hidden','');crmAgendaFillCRMVenue();return;}
    },true);
    document.addEventListener('input',(event)=>{const p=event.target.closest?.('[data-crm-agenda-participant-search]'),v=event.target.closest?.('[data-crm-agenda-venue-search]');if(p){const q=p.value.toLowerCase();p.closest('.crm-agenda-picker-menu')?.querySelectorAll('.crm-agenda-picker-option').forEach((r)=>r.hidden=!!q&&!String(r.dataset.search||'').includes(q));}if(v){const q=v.value.toLowerCase();v.closest('.crm-agenda-picker-menu')?.querySelectorAll('.crm-agenda-venue-option').forEach((r)=>r.hidden=!!q&&!String(r.dataset.search||'').includes(q));}},true);
  }
  // VALTREN CRM AGENDA FIDELITY END
