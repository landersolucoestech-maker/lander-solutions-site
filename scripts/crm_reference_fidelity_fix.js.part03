  function crmRefMusicChatPage(){return crmRefValtrenChatPage();}

  function crmRefReportsPage(){const entities=Array.isArray(state.crmReportEntities)?state.crmReportEntities:[];const list=entities.length?`<section class="crm-ref-entity-list crm-fidelity-entity-list">${entities.filter(e=>e.reportable!==false).map(e=>{const name=e.label??e.tableName??'Entidade';const unavailable=e.available===false;return `<article><div>${icon('database',15)}</div><div class="crm-ref-entity-copy"><strong>${esc(name)}</strong>${unavailable?'<small>Temporariamente indisponível</small>':''}</div><span></span><button ${(!e.supportsImport||unavailable)?'disabled':''} data-action="crm-ref-open" data-kind="import" data-id="${esc(name)}">${icon('upload',13)} Importar</button><button ${(!e.supportsExport||unavailable)?'disabled':''}>${icon('download',13)} Exportar</button></article>`;}).join('')}</section>`:`<div class="crm-ref-reports-empty">Nenhuma entidade reportável disponível.</div>`;return crmFidelityPage('reports','reports','Relatórios','Exportação e importação por entidade — dirigido pelo backend','',list);}
  function crmRefImportModal(entity){return `<div class="crm-ref-modal-backdrop" data-action="crm-ref-modal-close"></div><section class="crm-ref-modal wide crm-fidelity-import-modal" role="dialog" aria-modal="true"><header><h2>${icon('upload',16)} Importar ${esc(entity)}</h2><button type="button" data-action="crm-ref-modal-close">×</button></header><form id="crm-ref-import-form"><div class="crm-ref-modal-body"><div class="crm-ref-import-head"><button type="button">${icon('download',13)} Baixar template</button></div><label class="crm-ref-dropzone"><input type="file" accept=".xlsx" hidden><div>${icon('upload',28)}</div><strong>Clique para selecionar o arquivo</strong><span>XLSX</span></label><div class="crm-fidelity-import-preview" hidden><span>Total: <b>0</b></span><span>Válidas: <b>0</b></span><span>Inválidas: <b>0</b></span></div></div><footer><button type="button" class="secondary" data-action="crm-ref-modal-close">Cancelar</button><button type="button" class="secondary">Validar</button><button type="submit" class="primary" disabled>Importar</button></footer></form></section>`;}

  function crmRefSettingsPage(){const tab=state.crmRefSettingsTab||'company';const tabs=[['company','Empresa'],['automations','Automações'],['security','Segurança'],['integrations','Integrações'],['public','Cadastro Público'],['billing','Billing'],['users','Usuários']];let body='';if(tab==='company')body=`<div class="crm-ref-grid settings-company-grid">${crmFidelityPanel('Identidade Visual','Logo exibida nas áreas públicas e internas',`<div class="crm-ref-logo-upload"><img src="assets/valtren-logo.svg" alt="Valtren"><h2>VALTREN SOLUTIONS</h2><button>Alterar logo</button></div>`)}${crmFidelityPanel('Dados da Empresa','Informações da empresa para contratos e documentos',`<div class="crm-ref-form-grid">${crmRefField('Razão Social','legalName')}${crmRefField('Nome Fantasia','tradeName','text','VALTREN SOLUTIONS')}${crmRefField('CNPJ','cnpj')}${crmRefField('Endereço Completo','address')}${crmRefField('Telefone/WhatsApp','phone')}${crmRefField('Responsável','responsible')}${crmRefField('Slug da organização','slug','text','valtren-solutions')}</div>`,'<button>Editar Dados</button>')}</div>`;if(tab==='automations')body=crmFidelityPanel('Automações & Notificações','Configure quando, como e por qual canal o sistema deve notificar',`<div class="crm-ref-settings-blocks">${['Canais de Notificação','Contratos','Financeiro','Relatórios & Resumos','Sistema','Frequência & Preferências'].map((x,i)=>`<article><h4>${x}</h4>${i<5?'<label><input type="checkbox" checked> Notificações no sistema</label><label><input type="checkbox"> E-mail</label>':'<label>Frequência de envio<select><option>Imediato</option><option>Diário</option><option>Semanal</option></select></label><label>Horário preferido de recebimento<input type="time"></label>'}</article>`).join('')}</div>`);if(tab==='security')body=crmFidelityPanel('Segurança da Conta','Gerencie a segurança e acesso da sua conta',`<div class="crm-ref-form-grid">${crmRefField('Senha Atual','currentPassword','password')}${crmRefField('Nova Senha','newPassword','password')}${crmRefField('Confirmar Nova Senha','confirmPassword','password')}</div><div class="crm-ref-settings-blocks"><article><h4>Autenticação em Duas Etapas</h4><p>Proteção adicional da conta.</p></article><article><h4>Sessões Ativas</h4><button>Encerrar Todas as Outras Sessões</button></article><article class="danger"><h4>Zona de Perigo</h4><button>Excluir</button></article></div>`);if(tab==='integrations')body=`${crmFidelityPanel('Integrações','Conecte e configure as integrações específicas deste workspace. Essas conexões pertencem apenas a este cliente.',`<div class="crm-ref-integration-grid">${['Soundcharts','Meta','Google Ads','TikTok Ads','YouTube Ads','Spotify Ads'].map(x=>`<article><strong>${x}</strong><span class="crm-ref-badge">Não conectado</span><button>Configurar</button></article>`).join('')}</div>`)}${crmFidelityPanel('Distribuidoras','Conecte sua conta nas distribuidoras para enviar lançamentos diretamente pela plataforma',crmRefEmpty('Nenhuma distribuidora conectada'))}`;if(tab==='public')body=crmFidelityPanel('Cadastro Público','Gere e compartilhe o link público de cadastro de artistas vinculado a este workspace.',`${crmRefField('Link público','publicLink','text','Defina um slug da organização na aba Empresa')}<div class="crm-ref-actions"><button>Copiar</button><button disabled>Visualizar</button><button disabled>Regenerar link</button></div>`);if(tab==='billing')body=crmFidelityBillingSettingsBody();if(tab==='users')body=`<div class="crm-ref-kpis four">${crmRefKpi('Usuários Ativos',0)}${crmRefKpi('Convites Pendentes',0)}${crmRefKpi('Papéis Configurados',0)}${crmRefKpi('Permissões Totais',0)}</div>${crmFidelityPanel('Gerenciar Equipe','Gerencie o acesso dos usuários',`<div class="crm-fidelity-invite-row"><label class="crm-ref-search">${icon('mail',14)}<input placeholder="Digite o endereço de email"></label><select><option>Papel</option></select><button class="primary">Convidar</button></div>${crmRefEmpty('Nenhum membro na equipe','Convide membros para sua equipe usando o campo acima.')}`)}${crmFidelityPanel('Papéis e Permissões','Crie e edite papéis com permissões específicas',crmRefEmpty('Nenhum papel disponível','Os papéis e permissões são gerenciados pelo RBAC do sistema. Crie um papel usando o botão acima ou aguarde a sincronização com o backend.'),'<button>Criar Papel</button>')}`;const tabnav=`<nav class="crm-ref-ai-tabs crm-fidelity-local-tabs">${tabs.map(([id,l])=>`<button class="${tab===id?'active':''}" data-action="crm-ref-settings-tab" data-tab="${id}">${l}</button>`).join('')}</nav>`;return crmFidelityPage('settings','settings','Configurações','Gerencie as configurações do sistema e preferências','',`${tabnav}${body}`);}

  function crmRefUsersPage(){crmRefEnsureState();const actions=`<button class="primary" data-action="crm-ref-open" data-kind="user">${crmRefIcon('plus')} Convidar usuário</button>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por nome ou e-mail…"></label><select><option>Todos os papéis</option></select><select><option>Todos os status</option><option>Ativo</option><option>Inativo</option></select>`);const table=crmFidelityTable('Usuários','Usuários cadastrados no tenant atual',['Nome','Papel','Telefone','Criado em','Status','Ações'],'Nenhum usuário encontrado');return crmFidelityPage('settings','users','Usuários','Gerencie usuários, convites e papéis do sistema',actions,`${filters}${table}`);}
  function crmRefProfilePage(){const body=`${crmFidelityPanel('Informações Pessoais','Seus dados cadastrados no sistema',`<div class="crm-ref-profile-head"><div>AD</div><div><h2>Administrador</h2><p>Usuário</p></div><button>Alterar foto</button><button>Remover</button></div><div class="crm-ref-form-grid">${crmRefField('Nome Completo','name','text','',state.crmUserName||'Administrador')}${crmRefField('E-mail','email','email')}${crmRefField('Telefone','phone')}${crmRefField('Setor','sector','text','Selecione o setor')}${crmRefField('Cargo','role','text','Selecione o cargo')}${crmRefField('Nível de Acesso','access','text','—')}</div>`)}${crmFidelityPanel('Segurança','Gerencie suas configurações de segurança','')}`;return crmFidelityPage('settings','profile','Meu Perfil','Gerencie suas informações pessoais','',body);}
  function crmRefAuditPage(){const filters=crmFidelityPanel('Filtros','',`${crmRefToolbar(`<input type="date" placeholder="Data início"><input type="date" placeholder="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Pesquisar por acção, actor, ID, correlation…"></label><select><option>Entidade</option></select><select><option>Tipo de acção</option></select><button>Limpar filtros</button>`)}`,'<button>Actualizar</button>');const table=crmFidelityTable('Eventos','Clique numa linha para expandir o diff before/after',['','Timestamp','Actor','Role','Acção','Entidade','ID','Método'],'Nenhum evento encontrado');return crmFidelityPage('settings','audit','Audit Trail','Histórico de alterações e ações do sistema','',`${filters}${table}`);}
  function crmFidelityBillingBody(){const planCards=`<div class="crm-ref-plan-grid three">${[['Starter','R$ 299','/mês','Para labels e publishers independentes'],['Professional','R$ 799','/mês','Para distribuidoras e selos em crescimento'],['Enterprise','Consultar','','Para grandes grupos fonográficos']].map(([name,price,period,desc],i)=>`<article class="${i===1?'featured':''}">${i===1?'<span class="crm-ref-badge">Mais popular</span>':''}<h3>${name}</h3><p>${desc}</p><strong>${price}</strong><small>${period}</small><ul>${(i===0?['Artistas ilimitados','Catálogo musical completo','Contratos e CRM','Suporte por e-mail']:i===1?['Tudo do Starter','Marketing e campanhas','Contabilidade e P&L','Monitoramento ECAD','RH, Eventos e Estoque','Suporte prioritário']:['Tudo do Professional','Análise avançada','Multi-tenant admin','Licenciamento musical','Analytics avançado','SLA dedicado']).map(x=>`<li>✓ ${x}</li>`).join('')}</ul><button>${i===2?'Falar com comercial':'Fazer upgrade'}</button></article>`).join('')}</div>`;return `${crmFidelityPanel('Plano actual','Detalhes da sua assinatura',`<div class="crm-ref-plan"><div><strong>Trial</strong><span>Status da assinatura</span></div><span class="crm-ref-badge">Trial</span><button>Gerir assinatura</button></div>`)}<section class="crm-fidelity-plans"><h2>Planos disponíveis</h2>${planCards}</section>`;}
  function crmFidelityBillingSettingsBody(){return `<div class="crm-ref-grid two">${crmFidelityPanel('Plano Atual','Detalhes da sua assinatura',`<div class="crm-ref-plan"><div><strong>Trial</strong><span>Status da assinatura</span></div><span class="crm-ref-badge">Trial</span><button>Gerenciar Assinatura</button></div>`)}${crmFidelityPanel('Uso de Assentos','',`<div class="crm-fidelity-seat-usage"><strong>0 / —</strong><span>assentos utilizados</span><button>Gerenciar usuários</button></div>`)}</div>${crmFidelityPanel('Método de Pagamento','Cartão guardado para cobranças automáticas',crmRefEmpty('Nenhum método de pagamento cadastrado'))}${crmFidelityTable('Histórico de Faturas','Faturas dos últimos 12 meses',['Fatura','Data','Valor','Status',''],'Nenhuma fatura disponível')}${crmFidelityPanel('Planos Disponíveis','Compare os planos e faça upgrade quando estiver pronto',crmFidelityBillingBody().replace(/^.*?<section class="crm-fidelity-plans"><h2>Planos disponíveis<\/h2>/,'').replace(/<\/section>$/,''))}`;}
  function crmRefBillingPage(){return crmFidelityPage('settings','billing','Billing','Gerencie o seu plano e assinatura','',crmFidelityBillingBody());}

  function crmRefInvoiceModal(){const body=`<section class="crm-ref-form-section"><h3>Tipo de Operação</h3><div class="crm-ref-choice-row"><label><input type="radio" name="op" checked> Saída</label><label><input type="radio" name="op"> Entrada</label></div></section><section class="crm-ref-form-section"><h3>Identificação</h3><div class="crm-ref-form-grid">${crmRefField('Número da Nota','number','text','000001234')}${crmRefField('Série','series','text','001')}${crmRefSelect('Tipo de Nota','invoiceType',[['servico','Serviço'],['produto','Produto']])}${crmRefField('Data de Emissão','issueDate','date','Selecione a data')}${crmRefSelect('Status','status',[['emitida','Emitida'],['pendente','Pendente'],['paga','Paga'],['cancelada','Cancelada']])}${crmRefField('Natureza da Operação','nature')}${crmRefField('CFOP','cfop','text','5933')}${crmRefField('Código Serviço Municipal','serviceCode')}${crmRefField('Código Município (IBGE)','ibge','text','3550308')}</div></section><section class="crm-ref-form-section"><h3>Tomador / Cliente</h3><div class="crm-ref-form-grid">${crmRefField('Cliente / Fornecedor','customer','text','Selecione um cliente')}${crmRefField('CNPJ / CPF','document','text','00.000.000/0001-00')}${crmRefField('Razão Social / Nome','legalName')}${crmRefField('Inscrição Estadual','ie')}${crmRefField('Inscrição Municipal','im')}${crmRefField('E-mail','email','email')}${crmRefField('Endereço','address','text','Av. Paulista, 1000')}${crmRefField('Cidade','city')}${crmRefField('UF','uf')}${crmRefField('CEP','zip','text','00000-000')}</div></section><section class="crm-ref-form-section"><h3>Serviços</h3>${crmRefTextarea('Descrição dos Serviços','services','Descrição completa dos serviços prestados...')}<section class="crm-ref-panel crm-ref-invoice-items"><header><h3>Itens da Nota</h3><button type="button">${crmRefIcon('plus')} Adicionar Item</button></header><div class="crm-ref-form-grid invoice-item">${crmRefField('Descrição','itemDescription')}${crmRefField('Cód. Serviço','itemCode')}${crmRefField('Qtd','itemQty','number','1')}${crmRefField('Vlr Unit.','itemUnit','number','0,00')}<div class="crm-ref-field"><span>Total</span><strong>${crmRefMoney(0)}</strong></div></div><div class="crm-ref-invoice-total"><span>Total dos Serviços</span><strong>${crmRefMoney(0)}</strong></div></section></section><section class="crm-ref-form-section"><h3>Tributos</h3><div class="crm-ref-tax-head"><p>Tributos calculados automaticamente sobre o valor dos serviços.</p><button type="button">${crmRefIcon('calculator')} Recalcular</button></div><div class="crm-ref-form-grid three">${crmRefField('Valor dos Serviços','value','number','0,00')}${crmRefField('Deduções','deductions','number','0,00')}${crmRefField('Base de Cálculo','base','number','0,00')}</div><section class="crm-ref-panel"><header><h3>ISS</h3></header><div class="crm-ref-form-grid three">${crmRefField('Alíquota ISS (%)','issRate','number','0')}${crmRefField('Valor ISS','iss','number','0,00')}<label class="crm-ref-field switch"><span>ISS Retido na Fonte?</span><input type="checkbox" name="issWithheld"></label></div></section><section class="crm-ref-panel"><header><h3>Retenções Federais</h3></header><div class="crm-ref-form-grid five">${crmRefField('PIS','pis','number','0,00')}${crmRefField('COFINS','cofins','number','0,00')}${crmRefField('IRRF','irrf','number','0,00')}${crmRefField('CSLL','csll','number','0,00')}${crmRefField('INSS','inss','number','0,00')}</div></section><div class="crm-ref-tax-summary"><div><span>Valor Líquido da Nota</span><strong>${crmRefMoney(0)}</strong></div><div><span>Bruto: ${crmRefMoney(0)}</span><span>Total Retenções: ${crmRefMoney(0)}</span></div></div></section><section class="crm-ref-form-section"><h3>Pagamento</h3><div class="crm-ref-form-grid three">${crmRefSelect('Forma de Pagamento','payment',[['dinheiro','Dinheiro'],['pix','PIX'],['transferencia','Transferência'],['boleto','Boleto'],['cartao_credito','Cartão de Crédito'],['cartao_debito','Cartão de Débito'],['cheque','Cheque']])}${crmRefField('Condição','condition','text','30 dias / À vista / 30/60/90')}${crmRefField('Vencimento','due','date','Selecione a data')}</div><label class="crm-ref-field full"><span>Arquivo PDF da Nota</span><input type="file" accept=".pdf,application/pdf"></label><p class="crm-ref-note">O PDF é enviado ao armazenamento antes de salvar a nota. Se o armazenamento não estiver configurado, o formulário deve mostrar o erro real e não simular sucesso.</p>${crmRefTextarea('Observações','notes','Observações adicionais...')}</section>`;return crmRefModal('Registrar Nota Fiscal',body,'crm-ref-invoice-form',true);}
