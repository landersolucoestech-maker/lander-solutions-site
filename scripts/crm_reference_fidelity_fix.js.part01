
  // VALTREN CRM REFERENCE FIDELITY FIX START
  function crmFidelityAccountingSub(){return [['finance','Financeiro'],['accounting','Contabilidade'],['invoices','Notas Fiscais'],['rules','Regras de Categorização'],['categories','Categorias Financeiras'],['automations','Automações Financeiras']];}
  function crmFidelityMarketingSub(){return [['overview','Visão Geral'],['campaigns','Campanhas'],['calendar','Calendário'],['metrics','Métricas'],['briefings','Briefings'],['tasks','Tarefas']];}
  function crmFidelitySettingsSub(){return [['settings','Configurações'],['users','Usuários'],['profile','Meu Perfil'],['audit','Audit Trail'],['billing','Billing']];}
  function crmFidelitySubtabs(items,current,base){return `<nav class="crm-ref-subtabs">${items.map(([id,label])=>`<a class="${current===id?'active':''}" href="#${base}${id==='overview'||id==='finance'||id==='settings'?'':'/'+id}">${esc(label)}</a>`).join('')}</nav>`;}
  function crmFidelityHeaderActions(content=''){return `<div class="crm-fidelity-header-actions">${content}</div>`;}
  function crmFidelityPage(active,sub,title,description,actions,body){return `<div class="crm-app-shell crm-ref-shell crm-fidelity-shell">${crmRelSidebar(active,sub)}<main class="crm-main"><header class="crm-topbar crm-fidelity-topbar"><div><h1>${esc(title)}</h1><p>${esc(description)}</p></div><div class="crm-fidelity-top-actions">${actions||''}${crmHeaderActions(active)}</div></header><section class="crm-workspace crm-ref-workspace crm-fidelity-workspace">${body}</section></main></div>`;}
  function crmFidelityTable(title,description,headers,empty,rows=''){return `<section class="crm-ref-table-card crm-fidelity-table"><header><div><h3>${esc(title)}</h3><p>${esc(description)}</p></div><span>${rows?1:0}</span></header><div class="crm-ref-table-wrap"><table><thead><tr>${headers.map((h)=>`<th class="${h==='Ações'?'right':''}">${esc(h)}</th>`).join('')}</tr></thead>${rows?`<tbody>${rows}</tbody>`:''}</table></div>${rows?'':crmRefEmpty(empty)}</section>`;}
  function crmFidelityPanel(title,description,body,action=''){return `<section class="crm-ref-panel crm-fidelity-panel"><header><div><h3>${esc(title)}</h3>${description?`<p>${esc(description)}</p>`:''}</div>${action}</header>${body}</section>`;}

  function crmRelSidebar(active='relationships',sub=''){
    const nav=(href,label,ic,key)=>`<a class="${active===key?'active':''}" href="${href}">${icon(ic,18)}<span>${label}</span></a>`;
    const subgroup=(key,label,ic,base,items)=>`<details class="crm-nav-group" ${active===key?'open':''}><summary>${icon(ic,18)}<span>${label}</span><b>⌄</b></summary><div>${items.map(([id,text])=>`<a class="${active===key&&sub===id?'active':''}" href="#${base}${id==='overview'||id==='finance'||id==='settings'?'':'/'+id}">${text}</a>`).join('')}</div></details>`;
    return `<aside class="crm-sidebar"><a class="crm-brand" href="#/crm/dashboard" aria-label="Valtren CRM Integrado"><img src="assets/valtren-mark.svg" alt="Valtren Solutions"><span><strong>VALTREN</strong><small>CRM Integrado</small></span></a><nav class="crm-nav" aria-label="Módulos do CRM">
      ${nav('#/crm/dashboard','Dashboard','layers','dashboard')}${nav('#/crm/relationships','CRM','users','relationships')}${nav('#/crm/agenda','Agenda','calendar','agenda')}
      ${subgroup('accounting','Financeiro','database','/crm/financeiro',crmFidelityAccountingSub())}
      ${subgroup('marketing','Marketing','globe','/crm/marketing',crmFidelityMarketingSub())}
      ${nav('#/crm/valtrenchat','ValtrenChat','message','valtrenchat')}${nav('#/crm/relatorios','Relatórios','file','reports')}
      ${subgroup('settings','Configurações','settings','/crm/configuracoes',crmFidelitySettingsSub())}
    </nav></aside>`;
  }

  function crmRefFinancePage(){crmRefEnsureState();const rows=state.crmRefTransactions||[];const actions=`<button class="secondary">${crmRefIcon('upload')} Importar OFX</button><a class="secondary" href="#/crm/financeiro/rules">${crmRefIcon('file')} Regras</a><a class="secondary" href="#/crm/financeiro/categories">${crmRefIcon('tags')} Categorias Financeiras</a><a class="secondary" href="#/crm/financeiro/automations">${crmRefIcon('zap')} Automações</a><button class="primary" data-action="crm-ref-open" data-kind="transaction">${crmRefIcon('plus')} Nova Transação</button>`;const k=`<div class="crm-ref-kpis five">${crmRefKpi('Receita Mensal',crmRefMoney(0),'receitas pagas','success')}${crmRefKpi('Despesas Mensais',crmRefMoney(0),'despesas pagas','danger')}${crmRefKpi('Lucro Líquido',crmRefMoney(0),'margem 0%','success')}${crmRefKpi('Contas a Receber',crmRefMoney(0),'0 pendentes','warning')}${crmRefKpi('Contas a Pagar',crmRefMoney(0),'0 pendentes','warning')}</div>`;const filters=crmRefToolbar(`<input type="date" aria-label="Data início"><input type="date" aria-label="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar transações…"></label><select><option>Tipo</option><option>Todos</option><option>Receita</option><option>Despesa</option></select><select><option>Status</option><option>Todos</option><option>Pago</option><option>Pendente</option></select><select><option>Categoria</option><option>Todas</option><option>Recebimentos externos de direitos</option><option>Produção</option><option>Shows</option><option>Licenciamento</option><option>Operacional</option><option>Marketing</option></select>`);const table=crmFidelityTable('Transações','Fluxo de receitas e despesas',['','Tipo','Descrição','Categoria','Status','Data','Valor','Ações'],'Nenhuma transação cadastrada',rows.map(r=>`<tr><td><input type="checkbox"></td><td>${esc(r.type||'')}</td><td>${esc(r.description||'')}</td><td>${esc(r.category||'')}</td><td>${esc(r.status||'')}</td><td>${esc(r.date||'')}</td><td class="right">${crmRefMoney(r.value)}</td><td class="right">•••</td></tr>`).join(''));return crmFidelityPage('accounting','finance','Financeiro','Controle financeiro e fluxo de caixa',actions,`${k}${filters}${table}`);}

  function crmRefAccountingPage(){const tab=state.crmRefAccountingTab||'all';const tabs=[['all','Todos'],['company','P&L Empresa'],['projects','P&L Projetos'],['artists','P&L Artistas']];const k=`<div class="crm-ref-kpis four">${crmRefKpi('Receita Total',crmRefMoney(0),'','success')}${crmRefKpi('Despesa Total',crmRefMoney(0),'','danger')}${crmRefKpi('Lucro Líquido',crmRefMoney(0),'','success')}${crmRefKpi('Margem Líquida','0.0%')}</div>`;const filters=crmRefToolbar(`<input type="date" aria-label="Data início"><input type="date" aria-label="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por descrição ou categoria…"></label><select><option>Todos</option><option>Receitas</option><option>Despesas</option><option>Lucro</option></select>`);const tabnav=`<nav class="crm-ref-ai-tabs crm-fidelity-local-tabs">${tabs.map(([id,l])=>`<button class="${tab===id?'active':''}" data-action="crm-ref-accounting-tab" data-tab="${id}">${l}</button>`).join('')}</nav>`;let body='';if(tab==='company'||tab==='all')body+=crmFidelityTable('Demonstrativo de Resultado (P&L)','Receitas e despesas por categoria no período',['Categoria','Valor','% Receita'],'Nenhum dado contábil disponível');if(tab==='projects'||tab==='all')body+=crmFidelityTable('P&L por Projeto','Resultado por lançamento e operação',['Nome do Projeto','Categoria','Receitas','Despesas','Resultado'],'Nenhum projeto com movimentação no período');if(tab==='artists'||tab==='all')body+=crmFidelityTable('P&L por Artista','Resultado por artista no período',['Artista','Receitas','Despesas','Resultado','Margem'],'Nenhum artista com movimentação no período');return crmFidelityPage('accounting','accounting','Contabilidade','', '',`${filters}${k}${tabnav}${body}`);}

  function crmRefInvoicesPage(){crmRefEnsureState();const rows=state.crmRefInvoices||[];const actions=`<details class="crm-fidelity-action-menu"><summary class="primary">${crmRefIcon('plus')} Registrar Nota</summary><div><button data-action="crm-ref-open" data-kind="invoice">Registrar Saída</button><button data-action="crm-ref-open" data-kind="invoice">Registrar Entrada</button></div></details>`;const k=`<div class="crm-ref-kpis six">${crmRefKpi('Total',rows.length)}${crmRefKpi('Saídas',0,'','success')}${crmRefKpi('Entradas',0,'','warning')}${crmRefKpi('Valor Saídas',crmRefMoney(0),'','success')}${crmRefKpi('Valor Entradas',crmRefMoney(0),'','warning')}${crmRefKpi('Saldo',crmRefMoney(0))}</div>`;const filters=crmRefToolbar(`<input type="date" placeholder="Data início"><input type="date" placeholder="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por número, cliente ou fornecedor…"></label><select><option>Tipo</option><option>Todas</option><option>Saída</option><option>Entrada</option></select><select><option>Status</option><option>Todos</option><option>Emitida</option><option>Pendente</option><option>Paga</option><option>Cancelada</option></select>`);const table=crmFidelityTable('Lista de Notas Fiscais','Registro de notas de entrada e saída',['','Número','Tipo','Cliente / Fornecedor','Valor','Data Emissão','Status','PDF','Ações'],'Nenhuma nota fiscal cadastrada');return crmFidelityPage('accounting','invoices','Notas Fiscais','Registro e controle de notas fiscais de entrada e saída',actions,`${k}${filters}${table}`);}

  function crmRefCategorizationRulesPage(){crmRefEnsureState();const rows=state.crmRefCategorizationRules||[];const actions=`<button class="primary" data-action="crm-ref-open" data-kind="categorization-rule">${crmRefIcon('plus')} Nova Regra</button>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por palavra-chave ou categoria"></label><select><option>Todos os tipos</option><option>Receita</option><option>Despesa</option></select><select><option>Todas as origens</option><option>Sistema</option><option>Personalizada</option></select><select><option>Todos</option><option>Ativas</option><option>Inativas</option></select>`);const table=crmFidelityTable('Regras de Categorização','Acompanhe regras, palavras-chave, categorias, origem e status',['','Palavras-chave','Categoria','Tipo','Origem','Ações'],'Nenhuma regra de categorização encontrada');return crmFidelityPage('accounting','rules','Regras de Categorização Financeira','Categorize receitas e despesas automaticamente por palavras-chave, tipo e prioridade.',actions,`${filters}${table}`);}

  function crmRefCategoriesPage(){crmRefEnsureState();const rows=state.crmRefCategories||[];const actions=`<a class="secondary" href="#/crm/financeiro">← Voltar ao Financeiro</a><button class="primary" data-action="crm-ref-open" data-kind="category">${crmRefIcon('plus')} Criar</button>`;const badges=`<div class="crm-fidelity-badges"><span>${rows.length} categorias</span><span>${rows.length} regras/subcategorias</span></div>`;const table=crmFidelityTable('Lista de Categorias Financeiras','Categorias e subcategorias cadastradas no sistema',['','Categoria','Subcategoria','Tipo','Contraparte','Status','Ações'],'Nenhuma categoria financeira encontrada');return crmFidelityPage('accounting','categories','Categorias Financeiras','Categorias e subcategorias da classificação de receitas e despesas',actions,`${badges}${table}`);}

  function crmRefFinancialRulesPage(){const actions=`<a class="secondary" href="#/crm/financeiro">← Voltar ao Financeiro</a><button class="primary" data-action="crm-ref-open" data-kind="financial-rule">${crmRefIcon('plus')} Nova Regra</button>`;const table=crmFidelityTable('Regras de Automação','Cada regra calcula um valor (percentual ou fixo) e notifica quando um dos eventos selecionados ocorre.',['Nome','Tipo','Cálculo','Eventos','Status','Ações'],'Nenhuma regra cadastrada');return crmFidelityPage('accounting','automations','Automações Financeiras','Regras que disparam automaticamente ao assinar contratos, criar/pagar transações e vencer notas fiscais',actions,table);}

  function crmRefMarketingOverview(){const k=`<div class="crm-ref-kpis four">${crmRefKpi('Campanhas ativas',0)}${crmRefKpi('Projetos musicais em divulgação',0)}${crmRefKpi('Conteúdos programados',0,'','warning')}${crmRefKpi('Tarefas pendentes',0,'','warning')}${crmRefKpi('Conteúdos publicados',0)}${crmRefKpi('Aprovações pendentes',0,'','danger')}${crmRefKpi('Entregas próximas',0)}${crmRefKpi('Performance do setor','0%','','success')}</div>`;const upper=`<div class="crm-ref-grid two">${crmFidelityPanel('Entregas próximas','Conteúdos a publicar',crmRefEmpty('Nenhuma entrega próxima'),'<a href="#/crm/marketing/calendar">Ver calendário</a>')}${crmFidelityPanel('Aprovações pendentes','Conteúdos aguardando aprovação',crmRefEmpty('Nenhuma aprovação pendente'))}</div>`;const quick=`<div class="crm-ref-grid two">${crmFidelityPanel('Atalhos rápidos','',`<div class="crm-ref-quick-links"><a href="#/crm/marketing/campaigns">Nova Campanha</a><a href="#/crm/marketing/calendar">Novo Conteúdo</a><a href="#/crm/marketing/tasks">Nova Tarefa</a></div>`)}${crmFidelityPanel('Atividades recentes','',crmRefEmpty('Nenhuma atividade recente'))}</div>`;return crmFidelityPage('marketing','overview','Visão Geral','Cockpit operacional do setor de marketing','',`${k}${upper}${quick}`);}
