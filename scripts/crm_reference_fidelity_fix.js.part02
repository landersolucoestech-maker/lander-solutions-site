
  function crmRefCampaignsPage(){crmRefEnsureState();const rows=state.crmRefCampaigns||[];const actions=`<button class="primary" data-action="crm-ref-open" data-kind="campaign">${crmRefIcon('plus')} Nova Campanha</button>`;const k=`<div class="crm-ref-kpis five">${crmRefKpi('Campanhas Ativas',0,'em execução')}${crmRefKpi('Budget Total',crmRefMoney(0),'investimento','success')}${crmRefKpi('Gasto Total',crmRefMoney(0),'executado','danger')}${crmRefKpi('Cliques',0,'total')}${crmRefKpi('CTR Médio','0%','taxa de clique')}</div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por nome ou descrição..."></label><select><option>Todos os status</option><option>Rascunho</option><option>Planejada</option><option>Ativa</option><option>Pausada</option><option>Concluída</option></select><select><option>Todas</option><option>Tráfego pago</option><option>Orgânica</option><option>Lançamento</option></select>`);const table=crmFidelityTable('Lista de Campanhas','Acompanhe campanhas, plataformas, investimento, status e performance',['','Nome','Contexto','Plataforma','Status','Budget','Gasto','Cliques','Ações'],'Nenhuma campanha encontrada');return crmFidelityPage('marketing','campaigns','Campanhas de Marketing','Planeje, execute e monitore campanhas e tráfego pago',actions,`${k}${filters}${table}`);}

  function crmRefCalendarPage(){const actions=`<button class="primary" data-action="crm-ref-open" data-kind="content">${crmRefIcon('plus')} Novo Conteúdo</button>`;const k=`<div class="crm-ref-kpis four">${crmRefKpi('Conteúdos',0,'no total')}${crmRefKpi('Agendados',0,'aguardando publicação','warning')}${crmRefKpi('Publicados',0,'conteúdos publicados','success')}${crmRefKpi('Próximos 7 dias',0,'na próxima semana')}</div>`;const toolbar=crmRefToolbar(`<button>Hoje</button><button aria-label="Período anterior">‹</button><button aria-label="Próximo período">›</button><span class="crm-ref-period">agosto de 2026</span><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar conteúdo..."></label><select><option>Dia</option><option>Semana</option><option selected>Mês</option><option>Ano</option></select><select><option>Todos os tipos</option></select><select><option>Todos os status</option></select><select><option>Todas plataformas</option></select>`);const weekdays=['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];const cal=`<section class="crm-ref-calendar crm-fidelity-calendar"><div class="crm-ref-weekdays">${weekdays.map(x=>`<span>${x}</span>`).join('')}</div><div class="crm-ref-calendar-grid">${Array.from({length:35},(_,i)=>`<div><b>${i<4?28+i:i-3}</b></div>`).join('')}</div></section>`;return crmFidelityPage('marketing','calendar','Marketing - Calendário de Conteúdo','Programação de conteúdos',actions,`${k}${toolbar}${cal}`);}

  function crmRefMetricsPage(){const platforms=['Visão Geral','YouTube','TikTok','Instagram','Google Ads','Spotify Ads'];const tabs=`<nav class="crm-ref-ai-tabs crm-fidelity-metric-tabs">${platforms.map((p,i)=>`<button class="${i===0?'active':''}">${p}</button>`).join('')}</nav>`;const k=`<div class="crm-ref-kpis five crm-fidelity-metrics-kpis">${['Audiência total','Views totais/mês','Engajamento médio','Alcance total','Impressões Ads','Cliques totais','CTR médio','Conversões totais','Investimento total','Melhor conteúdo'].map((x)=>crmRefKpi(x,'—')).join('')}</div>`;const panels=`<div class="crm-ref-grid metric-layout">${crmFidelityPanel('Evolução consolidada','Performance agregada das plataformas monitoradas',crmRefEmpty('Sem dados suficientes para exibir evolução no período.'))}${crmFidelityPanel('Resumo consolidado','Leitura rápida dos principais indicadores',crmRefEmpty('Sem resumo disponível.'))}</div>${crmFidelityPanel('Top Conteúdos','Ranking de performance por conteúdo, artista/campanha e plataforma',crmRefEmpty('Nenhum conteúdo encontrado para esta plataforma.'))}`;return crmFidelityPage('marketing','metrics','Métricas','Performance de marketing por plataforma','',`${tabs}${k}${panels}`);}

  function crmRefBriefingsPage(){const actions=`<button class="primary" data-action="crm-ref-open" data-kind="briefing">${crmRefIcon('plus')} Novo Briefing</button>`;const k=`<div class="crm-ref-kpis four">${crmRefKpi('Briefings abertos',0)}${crmRefKpi('Em revisao',0)}${crmRefKpi('Aprovados',0)}${crmRefKpi('Entregáveis planejados',0)}</div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar briefing, objetivo, público ou responsável..."></label><select><option>Todos os tipos</option></select><select><option>Todos os status</option></select>`);const table=crmFidelityTable('Lista de Briefings','Acompanhe briefings, tipos, objetivos, responsáveis e status',['','Briefing','Tipo','Status','Responsáveis','Plano','Prazo','Ações'],'Nenhum briefing encontrado');return crmFidelityPage('marketing','briefings','Briefings','Origem estratégica dos projetos',actions,`${k}${filters}${table}`);}

  function crmRefTasksPage(){const actions=`<button class="primary" data-action="crm-ref-open" data-kind="task">${crmRefIcon('plus')} Nova Tarefa</button>`;const k=`<div class="crm-ref-kpis five">${crmRefKpi('Total de Tarefas',0,'demandas cadastradas')}${crmRefKpi('Concluídas',0,'finalizadas','success')}${crmRefKpi('A Fazer',0,'backlog e a fazer')}${crmRefKpi('Em Andamento',0,'em execução','warning')}${crmRefKpi('Revisão',0,'em revisão','danger')}</div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar tarefa..."></label><select><option>Todos os tipos</option></select>`);const table=crmFidelityTable('Lista de Tarefas','Acompanhe tarefas, tipos, responsáveis, prazos e status',['','Tarefa','Status','Contexto','Prioridade','Setor','Responsável','Prazo','Ações'],'Nenhuma tarefa encontrada');return crmFidelityPage('marketing','tasks','Marketing · Tarefas','Núcleo operacional de tarefas',actions,`${k}${filters}${table}`);}

  function crmRefContentModal(){return `<div class="crm-ref-modal-backdrop" data-action="crm-ref-modal-close"></div><section class="crm-ref-modal crm-fidelity-content-modal" role="dialog" aria-modal="true"><form id="crm-ref-content-form"><div class="crm-fidelity-content-layout"><aside class="crm-fidelity-content-preview"><h3>Prévia do conteúdo</h3><div class="crm-fidelity-media-drop">${icon('image',28)}<strong>Adicionar mídia</strong><span>Selecione um arquivo ou asset produzido</span></div></aside><div class="crm-fidelity-content-form"><header><h2>Novo Conteúdo</h2><button type="button" data-action="crm-ref-modal-close">×</button></header><div class="crm-ref-modal-body"><label class="crm-ref-field full"><span>Título *</span><input name="title" maxlength="100" placeholder="Ex: Post de lançamento do novo single"></label><div class="crm-ref-form-grid">${crmRefSelect('Contexto *','targetType',[['empresa','Empresa'],['artista','Artista'],['projeto_musical','Projeto Musical']])}${crmRefField('Artista *','targetName','text','Selecione o artista')}</div><label class="crm-ref-field full"><span>Plataformas (publicação multiplataforma) *</span><div class="crm-ref-chip-select">${['Instagram','Facebook','TikTok','YouTube'].map(x=>`<button type="button">${x}</button>`).join('')}</div><small>Selecione uma ou mais plataformas. A primeira (principal) define o formato e a prévia.</small></label>${crmRefSelect('Tipo de conteudo *','type',[['post','Post'],['video','Vídeo'],['story','Story'],['reel','Reel'],['carrossel','Carrossel'],['short','Short']])}<div class="crm-ref-form-grid">${crmRefField('Data *','publishDate','date','Selecionar data')}${crmRefField('Hora *','publishTime','time')}</div>${crmRefTextarea('Legenda / Copy *','copy','Escreva a legenda da publicação...')}<details class="crm-ref-advanced full"><summary>Configurações avançadas <span>⌄</span></summary><div class="crm-ref-form-grid">${crmRefSelect('Conta integrada (publicação)','integratedAccountId',[['none','Nenhuma (apenas agendar)']])}${crmRefSelect('Status','status',[['ideia','Ideia'],['rascunho','Rascunho'],['agendado','Agendado'],['publicado','Publicado'],['cancelado','Cancelado']])}${crmRefField('Campanha relacionada','campaignId','text','Nome da campanha...')}${crmRefField('Hashtags','hashtags','text','#musica #lançamento...')}${crmRefField('Localização','location','text','Ex: São Paulo, Brasil')}</div></details></div></div></div><footer><button type="button" class="secondary" data-action="crm-ref-modal-close">Cancelar</button><button type="submit" class="secondary">Agendar Conteúdo</button><button type="button" class="primary" disabled>Publicar via Integração</button></footer></form></section>`;}
  function crmRefBriefingModal(){return crmRefModal('Novo Briefing',`<div class="crm-ref-form-grid">${crmRefField('Título *','title')}${crmRefSelect('Tipo *','type',[['campanha','Campanha'],['conteudo','Conteúdo'],['projeto','Projeto']])}${crmRefSelect('Status *','status',[['rascunho','Rascunho'],['revisao','Em revisão'],['aprovado','Aprovado']])}${crmRefField('Prazo *','deadline','date')}${crmRefField('Responsáveis','owners','text','Separe por vírgulas')}${crmRefTextarea('Objetivo','objective')}</div>`,'crm-ref-briefing-form',true);}
  function crmRefTaskModal(){return crmRefModal('Nova Tarefa',`<div class="crm-ref-form-grid">${crmRefField('Título *','title')}${crmRefSelect('Contexto *','targetType',[['empresa','Empresa'],['artista','Artista'],['projeto_musical','Projeto Musical']])}${crmRefField('Projeto musical, artista ou empresa *','targetName','text','Busque por projeto, artista ou empresa')}${crmRefField('Setor *','sector','text','Selecione antes o contexto')}${crmRefField('Tipo *','type','text','Selecione um setor primeiro')}${crmRefField('Responsável *','owner')}${crmRefSelect('Prioridade *','priority',[['baixa','Baixa'],['media','Média'],['alta','Alta'],['critica','Crítica']])}${crmRefField('Prazo *','deadline','date')}</div>`,'crm-ref-task-form');}

  function crmFidelityValtrenChatData(){return {enabled:true,welcome:'Olá! Seja bem-vindo(a) à Central de Atendimento da Valtren Solutions. Para direcionarmos seu atendimento, escolha uma das opções abaixo respondendo com o número correspondente.',menu:'1. Contratação de Shows\n2. Produção Musical\n3. Editora Musical e Distribuição\n4. Design Gráfico e Criação\n5. Financeiro\n6. Redação & Conteúdo\n7. Outros Assuntos\n8. Contato por Engano',invalid:'Não consegui identificar essa opção. Responda apenas com o número de uma das opções do menu principal.',absence:'No momento não identificamos uma resposta válida. Você pode responder com o número da opção desejada para continuar.',outHours:'Recebemos sua mensagem fora do horário de atendimento. Sua solicitação foi registrada e será tratada no próximo período útil.',closing:'Atendimento encerrado. Obrigado por falar com a Valtren Solutions.',returnNumber:'0',returnCommands:'menu, voltar, inicio',menuOptions:[['Contratação de Shows','Comercial','Shows','Alta'],['Produção Musical','Produção Musical','Produção','Média'],['Editora Musical e Distribuição','Catálogo','Editora/Distribuição','Média'],['Design Gráfico e Criação','Marketing','Criação','Média'],['Financeiro','Financeiro','Financeiro','Alta'],['Redação & Conteúdo','Marketing','Conteúdo','Média'],['Outros Assuntos','Atendimento','Suporte','Média'],['Contato por Engano','Atendimento','Triagem','Baixa']],escalations:[{minutes:5,level:'supervisor',recipient:'Supervisor',active:true},{minutes:10,level:'manager',recipient:'Gestor',active:true}],required:['Nome do contratante ou empresa','Nome do responsável','Cidade e Estado','Data do evento','Local do evento','Tipo de evento','Artista desejado','Público estimado','Telefone para contato','E-mail']};}
  function crmRefValtrenChatPage(){crmRefEnsureState();if(!state.crmRefValtrenChat)state.crmRefValtrenChat=crmFidelityValtrenChatData();const d=state.crmRefValtrenChat;const tab=(state.crmRefMusicChat?.tab)||'messages';let body='';if(tab==='messages')body=`${crmFidelityPanel('Fluxo inicial','',`${crmRefTextarea('Mensagem inicial de boas-vindas','welcome','',d.welcome)}${crmRefTextarea('Menu principal de triagem','menu','',d.menu)}<label class="crm-ref-switch"><input type="checkbox" checked> Automação ativa</label>`)}${crmFidelityPanel('Mensagens de exceção e encerramento','',`<div class="crm-ref-form-grid">${crmRefTextarea('Opção inválida','invalid','',d.invalid)}${crmRefTextarea('Ausência de resposta','absence','',d.absence)}${crmRefTextarea('Fora do horário de atendimento','out','',d.outHours)}${crmRefTextarea('Encerramento','closing','',d.closing)}</div>`)}`;if(tab==='menu')body=`${crmFidelityPanel('Menu principal de triagem','Configure ordem, fila, setor, prioridade e template de cada opção.',`<div class="crm-ref-accordion">${d.menuOptions.map((o,i)=>`<details><summary><b>${i+1}</b><strong>${esc(o[0])}</strong><span>Fila ${esc(o[1])} · Setor ${esc(o[2])}</span><em>${esc(o[3])}</em><small>Ativa</small></summary><div class="crm-ref-form-grid">${crmRefField('Ordem','order','number','',String(i+1))}${crmRefField('Texto da opção','label','text','',o[0])}${crmRefField('Fila','queue','text','',o[1])}${crmRefField('Setor','sector','text','',o[2])}${crmRefField('Responsável padrão','assignee','text','ID do usuário')}${crmRefSelect('Prioridade','priority',[['baixa','Baixa'],['media','Média'],['alta','Alta'],['critica','Crítica']])}${crmRefField('Tags automáticas','tags')}</div></details>`).join('')}</div>`,'<button>Adicionar opção</button>')}${crmFidelityPanel('Retorno ao menu principal','',`<div class="crm-ref-form-grid">${crmRefField('Número','returnNumber','text','0',d.returnNumber)}${crmRefField('Comandos textuais aceitos','returnCommands','text','menu, voltar, inicio',d.returnCommands)}<label class="crm-ref-switch"><input type="checkbox" checked> Ativo</label></div>`)}`;if(tab==='escalation')body=`${crmFidelityPanel('Responsáveis padrão','',`<div class="crm-ref-form-grid">${crmRefField('Supervisor padrão','supervisor','text','ID do usuário supervisor')}${crmRefField('Gestor padrão','manager','text','ID do usuário gestor')}</div>`)}${crmFidelityPanel('Regras de escalonamento','Defina o tempo-limite e o destino de cada nível. Estas regras são avaliadas quando o escalonamento é executado manualmente (botão "Testar escalonamento" ou rotina de atendimento) — não há disparo automático por temporizador nesta versão.',`<div class="crm-ref-accordion">${d.escalations.map((r)=>`<details><summary><b>${r.minutes} min</b><strong>${esc(r.level)}</strong><span>Destino: ${esc(r.recipient)}</span><small>Ativa</small></summary><div class="crm-ref-form-grid">${crmRefField('Minutos','minutes','number','',String(r.minutes))}${crmRefField('Nível','level','text','',r.level)}${crmRefSelect('Destino','recipient',[['supervisor','Supervisor'],['manager','Gestor'],['custom','Usuário específico']])}${crmRefField('Usuário específico opcional','user','text','ID do usuário')}</div><div class="crm-ref-checks"><label><input type="checkbox" checked> Sistema</label><label><input type="checkbox"> WhatsApp preparado</label><label><input type="checkbox"> SMS preparado</label></div></details>`).join('')}</div>`,'<button>Adicionar regra</button>')}`;if(tab==='templates')body=crmFidelityPanel('Questionários por serviço','Abra um serviço do menu e configure quais perguntas serão coletadas inicialmente para ele.',`<div class="crm-ref-accordion">${d.menuOptions.map((o,i)=>`<details ${i===0?'open':''}><summary><strong>${i+1}. ${esc(o[0])}</strong><span>${d.required.length} campo(s)</span><small>Fila ${esc(o[1])} / Setor ${esc(o[2])}</small></summary><div class="crm-ref-form-section"><div class="crm-ref-actions right"><button class="danger">Excluir questionário</button></div><h3>Campos obrigatórios</h3><p>Perguntas que precisam ser respondidas para este tipo de serviço.</p>${i===0?`<div class="crm-fidelity-field-list">${d.required.map(f=>`<div><input value="${esc(f)}"><button type="button">×</button></div>`).join('')}</div><div class="crm-fidelity-add-row"><input placeholder="Ex.: Nome do contratante ou empresa"><button>Adicionar</button></div>`:''}${crmRefTextarea('Mensagem Automática','message')}</div></details>`).join('')}</div>`,'<button>Adicionar questionário</button>');const actions=`<button class="secondary">⚡ Testar escalonamento</button><button class="primary">${crmRefIcon('save')} Salvar configuração</button>`;const tabs=`<nav class="crm-ref-ai-tabs crm-fidelity-local-tabs">${[['messages','Mensagens'],['menu','Menu e filas'],['escalation','Escalonamento'],['templates','Templates']].map(([id,l])=>`<button class="${tab===id?'active':''}" data-action="crm-ref-musicchat-tab" data-tab="${id}">${l}</button>`).join('')}</nav>`;return crmFidelityPage('valtrenchat','valtrenchat','Automações do ValtrenChat','Configure mensagens automáticas, triagem, campos coletados, filas, templates, notificações e escalonamentos.',actions,`${tabs}${body}`);}
