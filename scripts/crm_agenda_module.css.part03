.crm-agenda-empty{background:#fff;border:1px solid rgba(11,29,58,.09);border-radius:12px;min-height:330px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8793A2}.crm-agenda-empty>div{opacity:.48}.crm-agenda-empty p{margin:12px 0 14px;font-size:12px}.crm-agenda-empty button{height:34px;border:1px solid rgba(11,29,58,.14);border-radius:8px;background:#fff;color:#0B1D3A;padding:0 12px;display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:800;cursor:pointer}
.crm-header-create-agenda{background:#D4AF37;color:#0B1D3A;border-color:#D4AF37}.crm-header-create-agenda:hover{background:#E0BE4B;border-color:#E0BE4B}
.crm-agenda-modal-root{position:fixed;inset:0;z-index:10020;display:grid;place-items:center;padding:24px}.crm-agenda-modal-backdrop{position:absolute;inset:0;background:rgba(7,20,40,.58);backdrop-filter:blur(2px)}.crm-agenda-modal{position:relative;width:min(860px,100%);max-height:90vh;background:#fff;border-radius:14px;box-shadow:0 24px 80px rgba(0,0,0,.26);overflow:hidden;display:flex;flex-direction:column;color:#0B1D3A}.crm-agenda-modal>header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:18px 22px;border-bottom:1px solid rgba(11,29,58,.09)}.crm-agenda-modal>header h2{margin:0;font-size:19px}.crm-agenda-modal>header p{margin:5px 0 0;color:#7D8998;font:9px/1.4 Montserrat,Arial,sans-serif}.crm-agenda-modal>header>button{width:32px;height:32px;border:0;border-radius:8px;background:#F2F5F7;color:#586576;cursor:pointer;font-size:18px}.crm-agenda-modal form{display:flex;flex-direction:column;min-height:0}.crm-agenda-modal-body{padding:18px 22px;overflow-y:auto;display:grid;gap:18px}.crm-agenda-form-grid{display:grid;gap:12px}.crm-agenda-form-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.crm-agenda-form-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.crm-agenda-field{display:grid;gap:6px;min-width:0}.crm-agenda-field.full{grid-column:1/-1}.crm-agenda-field>span{font-size:10px;font-weight:700;color:#4D5969}.crm-agenda-field input,.crm-agenda-field select,.crm-agenda-field textarea{width:100%;box-sizing:border-box;border:1px solid rgba(11,29,58,.14);border-radius:8px;background:#fff!important;color:#0B1D3A!important;font:10px Montserrat,Arial,sans-serif;padding:0 10px;outline:none}.crm-agenda-field input,.crm-agenda-field select{height:38px}.crm-agenda-field textarea{min-height:86px;padding-top:10px;resize:vertical}.crm-agenda-field input:focus,.crm-agenda-field select:focus,.crm-agenda-field textarea:focus{border-color:#D4AF37;box-shadow:0 0 0 2px rgba(212,175,55,.12)}.crm-agenda-modal footer{display:flex;justify-content:flex-end;gap:8px;padding:13px 22px;border-top:1px solid rgba(11,29,58,.09);background:#FBFCFD}.crm-agenda-modal footer button{height:36px;border-radius:8px;padding:0 13px;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:10px;font-weight:800;cursor:pointer}.crm-agenda-modal footer .secondary{background:#fff;border:1px solid rgba(11,29,58,.14);color:#0B1D3A}.crm-agenda-modal footer .primary{background:#0B1D3A;border:1px solid #0B1D3A;color:#fff}
.crm-agenda-view-header{display:grid!important;grid-template-columns:minmax(0,1fr) auto 32px;align-items:start!important}.crm-agenda-view-badges{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.crm-agenda-view-badges>span,.crm-agenda-view-badges>b{border-radius:999px;padding:5px 8px;font-size:8px;font-weight:800;border:1px solid rgba(11,29,58,.11);background:#F7F9FB}.crm-agenda-view-badges>b.confirmed{background:#ECF8F1;color:#28734E}.crm-agenda-view-badges>b.done{background:#EEF7FD;color:#26648F}.crm-agenda-view-badges>b.pending{background:#FFF8E9;color:#94631C}.crm-agenda-view-badges>b.cancelled{background:#FFF0F1;color:#A13B43}.crm-agenda-view-section{display:grid;gap:10px}.crm-agenda-view-section h3{margin:0;padding-bottom:7px;border-bottom:1px solid rgba(11,29,58,.09);color:#64748B;font-size:10px;text-transform:uppercase;letter-spacing:.07em}.crm-agenda-view-grid{display:grid;gap:8px 16px}.crm-agenda-view-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.crm-agenda-view-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.crm-agenda-view-grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.crm-agenda-view-row{display:grid;gap:4px}.crm-agenda-view-row span{font-size:8px;color:#85909E}.crm-agenda-view-row strong{font-size:10px}.crm-agenda-participants{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.crm-agenda-participant{border:1px solid rgba(11,29,58,.09);border-radius:8px;padding:10px;display:flex;align-items:center;gap:9px}.crm-agenda-participant>div{width:30px;height:30px;border-radius:999px;background:#F1F5F8;display:grid;place-items:center;color:#0B1D3A}.crm-agenda-participant strong{font-size:10px}.crm-agenda-ops{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.crm-agenda-ops article{border:1px solid rgba(11,29,58,.08);border-radius:9px;padding:12px;background:#FAFBFC}.crm-agenda-ops span{display:block;color:#7D8998;font-size:8px}.crm-agenda-ops strong{display:block;margin-top:5px;font-size:16px}.crm-agenda-view-text{margin:0;background:#F8FAFC;border-radius:8px;padding:12px;color:#344154;font:10px/1.6 Montserrat,Arial,sans-serif;white-space:pre-wrap}.crm-agenda-view-text.muted{color:#6A7686}
.crm-agenda-modal-root,.crm-agenda-modal-root *{scrollbar-color:auto!important;scrollbar-width:auto!important}.crm-agenda-modal-root *::-webkit-scrollbar,.crm-agenda-modal-root *::-webkit-scrollbar-thumb,.crm-agenda-modal-root *::-webkit-scrollbar-track,.crm-agenda-modal-root *::-webkit-scrollbar-corner{all:revert!important}
@media(max-width:1100px){.crm-agenda-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.crm-agenda-year{grid-template-columns:repeat(2,minmax(0,1fr))}.crm-agenda-week{overflow-x:auto;grid-template-columns:repeat(7,minmax(150px,1fr))}}
@media(max-width:760px){.crm-agenda-workspace{padding:18px 16px 32px!important}.crm-agenda-kpis{grid-template-columns:1fr}.crm-agenda-toolbar{align-items:stretch}.crm-agenda-period{width:100%}.crm-agenda-search{min-width:100%}.crm-agenda-toolbar select{flex:1 1 140px}.crm-agenda-month{overflow-x:auto}.crm-agenda-weekdays,.crm-agenda-month-grid{min-width:760px}.crm-agenda-year{grid-template-columns:1fr}.crm-agenda-modal-root{padding:10px}.crm-agenda-modal{max-height:94vh}.crm-agenda-form-grid.two,.crm-agenda-form-grid.three,.crm-agenda-view-grid.two,.crm-agenda-view-grid.three,.crm-agenda-view-grid.four,.crm-agenda-participants,.crm-agenda-ops{grid-template-columns:1fr}.crm-agenda-view-header{grid-template-columns:1fr 32px!important}.crm-agenda-view-badges{grid-column:1/-1;grid-row:2}}
