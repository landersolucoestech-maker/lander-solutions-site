el"><header><div><h3>Menu principal de triagem</h3><p>Configure ordem, fila, setor, prioridade e template de cada opção.</p></div><button>Adicionar opção</button></header><div class="crm-ref-accordion">${d.menuOptions.map((o,i)=>`<details><summary><b>${i+1}</b><strong>${esc(o[0])}</strong><span>Fila ${esc(o[1])} · Setor ${esc(o[2])}</span><em>${esc(o[3])}</em><small>Ativa</small></summary><div class="crm-ref-form-grid">${crmRefField('Ordem','order','number','',String(i+1))}${crmRefField('Texto da opção','label','text','',o[0])}${crmRefField('Fila','queue','text','',o[1])}${crmRefField('Setor','sector','text','',o[2])}${crmRefField('Responsável padrão','assignee','text','ID do usuário')}${crmRefSelect('Prioridade','priority',[['baixa','Baixa'],['media','Média'],['alta','Alta'],['critica','Crítica']])}${crmRefField('Tags automáticas','tags')}</div></details>`).join('')}</div></section><section class="crm-ref-panel"><header><h3>Retorno ao menu principal</h3></header><div class="crm-ref-form-grid">${crmRefField('Número','returnNumber','text','0',d.returnNumber)}${crmRefField('Comandos textuais aceitos','returnCommands','text','menu, voltar, inicio',d.returnCommands)}</div></section>`;if(tab==='escalation')body=`<section class="crm-ref-panel"><header><h3>Responsáveis padrão</h3></header><div class="crm-ref-form-grid">${crmRefField('Supervisor padrão','supervisor','text','ID do usuário supervisor',d.supervisor)}${crmRefField('Gestor padrão','manager','text','ID do usuário gestor',d.manager)}</div></section><section class="crm-ref-panel"><header><div><h3>Regras de escalonamento</h3><p>Defina o tempo-limite e o destino de cada nível.</p></div><button>Adicionar regra</button></header><div class="crm-ref-accordion">${d.escalations.map(r=>`<details><summary><b>${r.minutes} min</b><strong>${esc(r.level)}</strong><span>Destino: ${esc(r.recipient)}</span><small>${r.active?'Ativa':'Inativa'}</small></summary><div class="crm-ref-form-grid">${crmRefField('Minutos','minutes','number','',String(r.minutes))}${crmRefField('Nível','level','text','',r.level)}${crmRefSelect('Destino','recipient',[['supervisor','Supervisor'],['manager','Gestor'],['custom','Usuário específico']])}${crmRefField('Usuário específico opcional','user','text','ID do usuário')}</div><div class="crm-ref-checks"><label><input type="checkbox" checked> Sistema</label><label><input type="checkbox"> WhatsApp preparado</label><label><input type="checkbox"> SMS preparado</label></div></details>`).join('')}</div></section>`;if(tab==='templates')body=`<section class="crm-ref-panel"><header><div><h3>Questionários por serviço</h3><p>Abra um serviço do menu e configure quais perguntas serão coletadas inicialmente para ele.</p></div><button>Adicionar questionário</button></header><div class="crm-ref-accordion">${d.menuOptions.map((o,i)=>`<details><summary><strong>${i+1}. ${esc(o[0])}</strong><span>0 campo(s)</span><small>Fila ${esc(o[1])} / Setor ${esc(o[2])}</small></summary><div class="crm-ref-form-section"><h3>Campos obrigatórios</h3><p>Nenhum campo obrigatório configurado para este serviço.</p>${crmRefTextarea('Mensagem Automática','message')}</div></details>`).join('')}</div></section>`;const actions=`<div class="crm-ref-actions"><button>⚡ Testar escalonamento</button><button class="primary">Salvar configuração</button><button data-action="crm-ref-open" data-kind="conversation">Nova conversa</button></div>`;const tabs=`<nav class="crm-ref-ai-tabs">${[['messages','Mensagens'],['menu','Menu e filas'],['escalation','Escalonamento'],['templates','Templates']].map(([id,l])=>`<button class="${tab===id?'active':''}" data-action="crm-ref-musicchat-tab" data-tab="${id}">${l}</button>`).join('')}</nav>`;return crmRefPage('musicchat','musicchat','Automações do MusicChat','Configure mensagens automáticas, triagem, campos coletados, filas, templates, notificações e escalonamentos.',`${actions}${tabs}${body}`);}
  function crmRefConversationModal(){return crmRefModal('Nova conversa via WhatsApp',`<p class="crm-ref-note">Apenas WhatsApp tem envio externo real hoje — os demais canais ficam registrados apenas internamente (sem entrega ao cliente).</p><div class="crm-ref-form-grid">${crmRefField('Nome do contato','name','text','Opcional')}${crmRefField('Telefone (WhatsApp)','phone','text','+55 11 99999-9999')}${crmRefTextarea('Mensagem inicial','message','Opcional — a conversa pode ser criada sem enviar nada ainda')}</div>`,'crm-ref-conversation-form');}

  function crmRefReportsPage(){
    const entities=Array.isArray(state.crmReportEntities)?state.crmReportEntities:[];
    const list=entities.length?`<section class="crm-ref-entity-list">${entities.map(e=>{const name=e.label??e.tableName??'Entidade';const unavailable=e.available===false;return `<article><div>${icon('database',15)}</div><div class="crm-ref-entity-copy"><strong>${esc(name)}</strong>${unavailable?'<small>Temporariamente indisponível</small>':''}</div><span></span><button ${(!e.supportsImport||unavailable)?'disabled':''} data-action="crm-ref-open" data-kind="import" data-id="${esc(name)}">${icon('upload',13)} Importar</button><button ${(!e.supportsExport||unavailable)?'disabled':''}>${icon('download',13)} Exportar</button></article>`;}).join('')}</section>`:`<div class="crm-ref-reports-empty">Nenhuma entidade reportável disponível.</div>`;
    return crmRefPage('reports','reports','Relatórios','Exportação e importação por entidade — dirigido pelo backend',list);
  }
  function crmRefImportModal(entity){return crmRefModal(`Importar ${entity}`,`<div class="crm-ref-import-head"><button>↓ Baixar template</button></div><label class="crm-ref-dropzone"><input type="file" hidden><div>${icon('upload',28)}</div><strong>Selecionar arquivo</strong><span>Arraste ou clique para escolher XLSX/CSV</span></label><div class="crm-ref-import-stages"><span class="active">1. Upload</span><span>2. Validar</span><span>3. Confirmar importação</span></div>`,'crm-ref-import-form');}

  function crmRefSettingsPage(){const tab=state.crmRefSettingsTab||'company';let body='';if(tab==='company')body=`<div class="crm-ref-grid two"><section class="crm-ref-panel"><header><h3>Identidade Visual</h3><p>Logo exibida nas áreas públicas e internas</p></header><div class="crm-ref-logo-upload"><img src="assets/valtren-logo.svg" alt="Valtren"><button>Alterar logo</button></div></section><section class="crm-ref-panel"><header><h3>Dados da Empresa</h3><p>Informações da empresa para contratos e documentos</p></header><div class="crm-ref-form-grid">${crmRefField('Razão Social','legalName')}${crmRefField('Nome Fantasia','tradeName','text','VALTREN SOLUTIONS')}${crmRefField('CNPJ','cnpj')}${crmRefField('Endereço Completo','address')}${crmRefField('Telefone/WhatsApp','phone')}${crmRefField('Responsável','responsible')}${crmRefField('Slug da organização','slug','text','valtren-solutions')}</div></section></div>`;if(tab==='automations')body=`<section class="crm-ref-panel"><header><h3>Automações & Notificações</h3><p>Configure quando, como e por qual canal o sistema deve notificar</p></header><div class="crm-ref-settings-blocks">${['Canais de Notificação','Contratos','Financeiro','Relatórios & Resumos','Sistema','Frequência & Preferências'].map(x=>`<article><h4>${x}</h4><label><input type="checkbox" checked> Notificações no sistema</label><label><input type="checkbox"> E-mail</label></article>`).join('')}</div></section>`;if(tab==='security')body=`<section class="crm-ref-panel"><header><h3>Segurança da Conta</h3><p>Gerencie a segurança e acesso da sua conta</p></header><div class="crm-ref-form-grid">${crmRefField('Senha Atual','currentPassword','password','••••••••')}${crmRefField('Nova Senha','newPassword','password','••••••••')}${crmRefField('Confirmar Nova Senha','confirmPassword','password','••••••••')}</div><div class="crm-ref-settings-blocks"><article><h4>Autenticação em Duas Etapas</h4><p>Proteção adicional da conta.</p></article><article><h4>Sessões Ativas</h4><button>Encerrar Todas as Outras Sessões</button></article><article class="danger"><h4>Zona de Perigo</h4><button>Excluir</button></article></div></section>`;if(tab==='integrations')body=`<section class="crm-ref-panel"><header><h3>Integrações</h3><p>Conecte e configure as integrações específicas deste workspace. Essas conexões pertencem apenas a este cliente.</p></header><div class="crm-ref-integration-grid">${['Soundcharts','Meta','Google Ads','TikTok Ads','YouTube Ads','Spotify Ads'].map(x=>`<article><strong>${x}</strong><span class="crm-ref-badge">Não conectado</span><button>Configurar</button></article>`).join('')}</div></section><section class="crm-ref-panel"><header><h3>Distribuidoras</h3><p>Conecte sua conta nas distribuidoras para enviar lançamentos diretamente pela plataforma</p></header>${crmRefEmpty('Nenhuma distribuidora conectada')}</section>`;if(tab==='public')body=`<section class="crm-ref-panel"><header><h3>Cadastro Público</h3><p>Gere e compartilhe o link público de cadastro de artistas vinculado a este workspace.</p></header>${crmRefField('Link público','publicLink','text','Defina um slug da organização na aba Empresa')}<button>Copiar</button></section>`;if(tab==='billing')body=crmRefBillingContent();if(tab==='users')body=crmRefUsersContent();const tabs=[['company','Empresa'],['automations','Automações'],['security','Segurança'],['integrations','Integrações'],['public','Cadastro Público'],['billing','Billing'],['users','Usuários']];return crmRefPage('settings','settings','Configurações','Gerencie as configurações do sistema e preferências',`${crmRefSubtabs(CRM_REF_SETTINGS_SUB,'settings','#/crm/configuracoes')}<nav class="crm-ref-ai-tabs">${tabs.map(([id,l])=>`<button class="${tab===id?'active':''}" data-action="crm-ref-settings-tab" data-tab="${id}">${l}</button>`).join('')}</nav>${body}`);}
  function crmRefUsersContent(){crmRefEnsureState();return `<div class="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="user">Convidar usuário</button></div>${crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por nome ou e-mail…"></label><select><option>Todos os papéis</option></select><select><option>Todos os status</option><option>Ativo</option><option>Inativo</option></select>`)}<section class="crm-ref-table-card"><header><div><h3>Usuários</h3><p>Usuários cadastrados no tenant atual</p></div><span>${state.crmRefUsers.length}</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th>Nome</th><th>Papel</th><th>Telefone</th><th>Criado em</th><th>Status</th><th class="right">Ações</th></tr></thead></table></div>${state.crmRefUsers.length?'':crmRefEmpty('Nenhum usuário encontrado')}</section>`;}
  function crmRefUsersPage(){return crmRefPage('settings','users','Usuários','Gerencie usuários, convites e papéis do sistema',`${crmRefSubtabs(CRM_REF_SETTINGS_SUB,'users','#/crm/configuracoes')}${crmRefUsersContent()}`);}
  function crmRefProfilePage(){return crmRefPage('settings','profile','Meu Perfil','Gerencie suas informações pessoais',`${crmRefSubtabs(CRM_REF_SETTINGS_SUB,'profile','#/crm/configuracoes')}<section class="crm-ref-panel"><header><h3>Informações Pessoais</h3><p>Seus dados cadastrados no sistema</p></header><div class="crm-ref-profile-head"><div>AD</div><div><h2>Administrador</h2><p>Usuário</p></div><button>Alterar foto</button><button>Remover</button></div><div class="crm-ref-form-grid">${crmRefField('Nome Completo','name','text','',state.crmUserName||'Administrador')}${crmRefField('E-mail','email','email')}${crmRefField('Telefone','phone')}${crmRefField('Setor','sector','text','Selecione o setor')}${crmRefField('Cargo','role','text','Selecione o cargo')}${crmRefField('Nível de Acesso','access','text','—')}</div></section><section class="crm-ref-panel"><header><h3>Segurança</h3><p>Gerencie suas configurações de segurança</p></header></section>`);}
  function crmRefAuditPage(){return crmRefPage('settings','audit','Audit Trail','Histórico de alterações e ações do sistema',`${crmRefSubtabs(CRM_REF_SETTINGS_SUB,'audit','#/crm/configuracoes')}<section class="crm-ref-panel"><header><h3>Filtros</h3><button>Actualizar</button></header>${crmRefToolbar(`<input type="date" placeholder="Data início"><input type="date" placeholder="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Pesquisar por acção, actor, ID, correlation…"></label><select><option>Entidade</option></select><select><option>Tipo de acção</option></select><button>Limpar filtros</button>`)}</section><section class="crm-ref-table-card"><header><div><h3>Eventos</h3><p>Clique numa linha para expandir o diff before/after</p></div><span>0</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th>Timestamp</th><th>Actor</th><th>Role</th><th>Acção</th><th>Entidade</th><th>ID</th><th>Método</th></tr></thead></table></div>${crmRefEmpty('Nenhum evento encontrado')}</section>`);}
  function crmRefBillingContent(){return `<section class="crm-ref-panel"><header><h3>Plano actual</h3><p>Detalhes da sua assinatura</p></header><div class="crm-ref-plan"><div><strong>Plano atual</strong><span>Status da assinatura</span></div><button>Gerir assinatura</button></div></section><section class="crm-ref-panel"><header><h3>Planos disponíveis</h3></header><div class="crm-ref-plan-grid">${['Starter','Pro','Business','Enterprise'].map((x,i)=>`<article><h3>${x}</h3><p>${i===3?'Fale com comercial':'Recursos e limites do plano'}</p><button>${i===3?'Falar com comercial':'Fazer upgrade'}</button></article>`).join('')}</div></section>`;}
  function crmRefBillingPage(){return crmRefPage('settings','billing','Billing','Planos, cobrança e assinatura',`${crmRefSubtabs(CRM_REF_SETTINGS_SUB,'billing','#/crm/configuracoes')}${crmRefBillingContent()}`);}
  function crmRefUserModal(){return crmRefModal('Convidar usuário',`<div class="crm-ref-form-grid">${crmRefField('Nome Completo *','name')}${crmRefField('Email *','email','email','usuario@empresa.com')}${crmRefField('Telefone','phone','text','(00) 00000-0000')}${crmRefSelect('Status *','status',[['ativo','Ativo'],['inativo','Inativo'],['suspenso','Suspenso']])}${crmRefField('Setor','sector','text','Selecione o setor')}${crmRefField('Nível de Acesso (Perfil) *','access','text','Selecione o perfil')}</div>`,'crm-ref-user-form');}

  function crmReferenceRoute(path){
    if(path==='/crm/financeiro')return crmRefFinancePage(); if(path==='/crm/financeiro/accounting')return crmRefAccountingPage(); if(path==='/crm/financeiro/invoices')return crmRefInvoicesPage(); if(path==='/crm/financeiro/rules')return crmRefCategorizationRulesPage(); if(path==='/crm/financeiro/categories')return crmRefCategoriesPage(); if(path==='/crm/financeiro/automations')return crmRefFinancialRulesPage();
    if(path==='/crm/marketing')return crmRefMarketingOverview(); if(path==='/crm/marketing/campaigns')return crmRefCampaignsPage(); if(path==='/crm/marketing/calendar')return crmRefCalendarPage(); if(path==='/crm/marketing/metrics')return crmRefMetricsPage(); if(path==='/crm/marketing/briefings')return crmRefBriefingsPage(); if(path==='/crm/marketing/tasks')return crmRefTasksPage(); if(path==='/crm/marketing/ai')return crmRefAIPage();
    if(path==='/crm/musicchat')return crmRefMusicChatPage(); if(path==='/crm/relatorios')return crmRefReportsPage(); if(path==='/crm/configuracoes')return crmRefSettingsPage(); if(path==='/crm/configuracoes/users')return crmRefUsersPage(); if(path==='/crm/configuracoes/profile')return crmRefProfilePage(); if(path==='/crm/configuracoes/audit')return crmRefAuditPage(); if(path==='/crm/configuracoes/billing')return crmRefBillingPage(); return null;
  }
  if(!window.__valtrenCrmReferenceBound){window.__valtrenCrmReferenceBound=true;
    document.addEventListener('click',(event)=>{const t=event.target.closest('[data-action]');if(!t)return;const a=t.dataset.action;if(a==='crm-ref-open'){crmRefOpenModal(t.dataset.kind||'',t.dataset.id||'');return;}if(a==='crm-ref-modal-close'){crmRefCloseModal();retur