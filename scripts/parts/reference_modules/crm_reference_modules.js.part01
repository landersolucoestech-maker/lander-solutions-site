
  // VALTREN CRM REFERENCE MODULES START
  const CRM_REF_MARKETING_SUB=[['overview','Visão Geral'],['campaigns','Campanhas'],['calendar','Calendário'],['metrics','Métricas'],['briefings','Briefings'],['tasks','Tarefas'],['ai','IA Criativa']];
  const CRM_REF_ACCOUNTING_SUB=[['finance','Financeiro'],['accounting','Contabilidade'],['invoices','Notas Fiscais'],['rules','Regras de Categorização'],['categories','Categorias Financeiras'],['automations','Automações Financeiras']];
  const CRM_REF_SETTINGS_SUB=[['settings','Configurações'],['users','Usuários'],['profile','Meu Perfil'],['audit','Audit Trail'],['billing','Billing']];
  function crmRefEnsureState(){
    if(!Array.isArray(state.crmRefTransactions))state.crmRefTransactions=[];
    if(!Array.isArray(state.crmRefInvoices))state.crmRefInvoices=[];
    if(!Array.isArray(state.crmRefCategories))state.crmRefCategories=[];
    if(!Array.isArray(state.crmRefFinancialRules))state.crmRefFinancialRules=[];
    if(!Array.isArray(state.crmRefCategorizationRules))state.crmRefCategorizationRules=[];
    if(!Array.isArray(state.crmRefCampaigns))state.crmRefCampaigns=[];
    if(!Array.isArray(state.crmRefBriefings))state.crmRefBriefings=[];
    if(!Array.isArray(state.crmRefTasks))state.crmRefTasks=[];
    if(!Array.isArray(state.crmRefContents))state.crmRefContents=[];
    if(!Array.isArray(state.crmRefUsers))state.crmRefUsers=[];
    if(!Array.isArray(state.crmRefAudit))state.crmRefAudit=[];
    if(!state.crmRefMusicChat){state.crmRefMusicChat={enabled:true,welcome:'Olá! Como podemos ajudar?',menu:'Escolha uma opção para direcionarmos seu atendimento.',invalid:'Opção inválida. Tente novamente.',absence:'Não recebemos sua resposta.',outHours:'Estamos fora do horário de atendimento.',closing:'Atendimento encerrado. Obrigado!',returnNumber:'0',returnCommands:'menu, voltar, inicio',supervisor:'',manager:'',tab:'messages',menuOptions:[['Contratação de Shows','Comercial','Shows','Alta'],['Produção Musical','Produção Musical','Produção','Média'],['Editora Musical e Distribuição','Catálogo','Editora/Distribuição','Média'],['Design Gráfico e Criação','Marketing','Criação','Média'],['Financeiro','Financeiro','Financeiro','Alta'],['Redação & Conteúdo','Marketing','Conteúdo','Média'],['Outros Assuntos','Atendimento','Suporte','Média'],['Contato por Engano','Atendimento','Triagem','Baixa']],escalations:[{minutes:15,level:'supervisor',recipient:'Supervisor',channels:['Sistema'],active:true}]};}
  }
  function crmRefMoney(v){return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
  function crmRefIcon(name){return icon(name,15)}
  function crmRefKpi(title,value,description='',accent='primary'){return `<article class="crm-ref-kpi ${accent}"><div>${crmRefIcon(accent==='success'?'check':accent==='warning'?'clock':accent==='danger'?'alert':'layers')}</div><span>${esc(title)}</span><strong>${esc(String(value))}</strong><small>${esc(description)}</small></article>`;}
  function crmRefEmpty(title,description=''){return `<div class="crm-ref-empty"><div>${icon('database',34)}</div><strong>${esc(title)}</strong>${description?`<span>${esc(description)}</span>`:''}</div>`;}
  function crmRefPage(active,sub,title,description,body){return `<div class="crm-app-shell crm-ref-shell">${crmRelSidebar(active,sub)}<main class="crm-main"><header class="crm-topbar"><div><h1>${esc(title)}</h1><p>${esc(description)}</p></div>${crmHeaderActions(active)}</header><section class="crm-workspace crm-ref-workspace">${body}</section></main></div>`;}
  function crmRefSubtabs(items,current,base){return `<nav class="crm-ref-subtabs">${items.map(([id,label])=>`<a class="${current===id?'active':''}" href="#${base}${id==='overview'||id==='finance'||id==='settings'?'':'/'+id}">${esc(label)}</a>`).join('')}</nav>`;}
  function crmRefToolbar(content){return `<div class="crm-ref-toolbar">${content}</div>`;}
  function crmRefField(label,name,type='text',placeholder='',value=''){return `<label class="crm-ref-field"><span>${esc(label)}</span><input name="${esc(name)}" type="${esc(type)}" placeholder="${esc(placeholder)}" value="${esc(value)}"></label>`;}
  function crmRefSelect(label,name,options,value=''){return `<label class="crm-ref-field"><span>${esc(label)}</span><select name="${esc(name)}">${options.map(([v,l])=>`<option value="${esc(v)}" ${String(v)===String(value)?'selected':''}>${esc(l)}</option>`).join('')}</select></label>`;}
  function crmRefTextarea(label,name,placeholder='',value=''){return `<label class="crm-ref-field full"><span>${esc(label)}</span><textarea name="${esc(name)}" placeholder="${esc(placeholder)}">${esc(value)}</textarea></label>`;}
  function crmRefModal(title,body,formId='crm-ref-form',wide=false){return `<div class="crm-ref-modal-backdrop" data-action="crm-ref-modal-close"></div><section class="crm-ref-modal ${wide?'wide':''}"><header><h2>${esc(title)}</h2><button type="button" data-action="crm-ref-modal-close">×</button></header><form id="${formId}"><div class="crm-ref-modal-body">${body}</div><footer><button type="button" class="secondary" data-action="crm-ref-modal-close">Cancelar</button><button type="submit" class="primary">Salvar</button></footer></form></section>`;}
  function crmRefOpenModal(kind,id=''){
    crmRefEnsureState(); document.getElementById('crm-ref-modal-root')?.remove(); const root=document.createElement('div'); root.id='crm-ref-modal-root'; root.className='crm-ref-modal-root'; let html='';
    if(kind==='transaction') html=crmRefTransactionModal();
    if(kind==='invoice') html=crmRefInvoiceModal();
    if(kind==='category') html=crmRefCategoryModal();
    if(kind==='financial-rule') html=crmRefFinancialRuleModal();
    if(kind==='categorization-rule') html=crmRefCategorizationRuleModal();
    if(kind==='campaign') html=crmRefCampaignModal();
    if(kind==='content') html=crmRefContentModal();
    if(kind==='briefing') html=crmRefBriefingModal();
    if(kind==='task') html=crmRefTaskModal();
    if(kind==='conversation') html=crmRefConversationModal();
    if(kind==='import') html=crmRefImportModal(id||'Entidade');
    if(kind==='user') html=crmRefUserModal();
    root.innerHTML=html; document.body.appendChild(root); document.body.classList.add('crm-rel-modal-open');
  }
  function crmRefCloseModal(){document.getElementById('crm-ref-modal-root')?.remove();document.body.classList.remove('crm-rel-modal-open');}

  function crmRefFinancePage(){crmRefEnsureState();const rows=state.crmRefTransactions;const k=`<div class="crm-ref-kpis five">${crmRefKpi('Receita Mensal',crmRefMoney(0),'receitas pagas','success')}${crmRefKpi('Despesas Mensais',crmRefMoney(0),'despesas pagas','danger')}${crmRefKpi('Lucro Líquido',crmRefMoney(0),'margem 0%','success')}${crmRefKpi('Contas a Receber',crmRefMoney(0),'0 pendentes','warning')}${crmRefKpi('Contas a Pagar',crmRefMoney(0),'0 pendentes','warning')}</div>`;const actions=`<div class="crm-ref-actions"><button>${crmRefIcon('upload')} Importar OFX</button><a href="#/crm/financeiro/rules">Regras</a><a href="#/crm/financeiro/categories">Categorias Financeiras</a><a href="#/crm/financeiro/automations">Automações</a><button class="primary" data-action="crm-ref-open" data-kind="transaction">${crmRefIcon('plus')} Nova Transação</button></div>`;const filters=crmRefToolbar(`<input type="date" aria-label="Data início"><input type="date" aria-label="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar transações…"></label><select><option>Tipo</option><option>Receita</option><option>Despesa</option></select><select><option>Status</option><option>Pago</option><option>Pendente</option></select><select><option>Categoria</option><option>Todas</option><option>Recebimentos externos de direitos</option><option>Produção</option><option>Shows</option><option>Licenciamento</option><option>Operacional</option><option>Marketing</option></select>`);const table=`<section class="crm-ref-table-card"><header><div><h3>Transações</h3><p>Fluxo de receitas e despesas</p></div><span>${rows.length}</span></header>${rows.length?`<div class="crm-ref-table-wrap"><table><thead><tr><th></th><th>Tipo</th><th>Descrição</th><th>Categoria</th><th>Status</th><th>Data</th><th class="right">Valor</th><th class="right">Ações</th></tr></thead><tbody>${rows.map(r=>`<tr><td><input type="checkbox"></td><td><span class="crm-ref-badge">${esc(r.type)}</span></td><td><strong>${esc(r.description)}</strong></td><td>${esc(r.category)}</td><td>${esc(r.status)}</td><td>${esc(r.date)}</td><td class="right">${crmRefMoney(r.value)}</td><td class="right">•••</td></tr>`).join('')}</tbody></table></div>`:crmRefEmpty('Nenhuma transação encontrada')}</section>`;return crmRefPage('accounting','finance','Financeiro','Controle financeiro e fluxo de caixa',`${crmRefSubtabs(CRM_REF_ACCOUNTING_SUB,'finance','#/crm/financeiro')}${actions}${k}${filters}${table}`);}
  function crmRefAccountingPage(){
    const current=state.crmRefAccountingTab||'all';
    const tabItems=[['all','Todos'],['company','P&L Empresa'],['projects','P&L Projetos'],['artists','P&L Artistas']];
    const tabs=`<nav class="crm-ref-pnl-tabs">${tabItems.map(([id,l])=>`<button class="${current===id?'active':''}" data-action="crm-ref-accounting-tab" data-tab="${id}">${l}</button>`).join('')}</nav>`;
    const k=`<div class="crm-ref-kpis four">${crmRefKpi('Receita Total',crmRefMoney(0),'','success')}${crmRefKpi('Despesa Total',crmRefMoney(0),'','danger')}${crmRefKpi('Lucro Líquido',crmRefMoney(0),'','success')}${crmRefKpi('Margem Líquida','0.0%')}</div>`;
    const filters=crmRefToolbar(`<input type="date" aria-label="Data início"><input type="date" aria-label="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por descrição ou categoria…"></label><select><option>Todos</option><option>Receitas</option><option>Despesas</option><option>Lucro</option></select>`);
    const company=`<section class="crm-ref-table-card"><header><div><h3>Demonstrativo de Resultado (P&L)</h3><p>Receitas e despesas por categoria no período</p></div><span>0</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th>Categoria</th><th class="right">Valor</th><th class="right">% Receita</th></tr></thead></table></div>${crmRefEmpty('Nenhum lançamento no período')}</section>`;
    const projects=`<section class="crm-ref-table-card"><header><div><h3>P&L por Projeto</h3><p>Resultado financeiro consolidado por projeto</p></div><span>0</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th>Nome do Projeto</th><th class="right">Receitas</th><th class="right">Despesas</th><th class="right">Resultado</th></tr></thead></table></div>${crmRefEmpty('Nenhum projeto com movimentação no período')}</section>`;
    const artists=`<section class="crm-ref-table-card"><header><div><h3>P&L por Artista</h3><p>Resultado financeiro consolidado por artista</p></div><span>0</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th>Artista</th><th class="right">Receitas</th><th class="right">Despesas</th><th class="right">Resultado</th><th class="right">Margem</th></tr></thead></table></div>${crmRefEmpty('Nenhum artista com movimentação no período')}</section>`;
    const body=current==='company'?company:current==='projects'?projects:current==='artists'?artists:`${company}${projects}${artists}`;
    return crmRefPage('accounting','accounting','Contabilidade','Demonstrativos financeiros consolidados',`${crmRefSubtabs(CRM_REF_ACCOUNTING_SUB,'accounting','#/crm/financeiro')}${tabs}${k}${filters}${body}`);
  }
  function crmRefInvoicesPage(){crmRefEnsureState();const rows=state.crmRefInvoices;const k=`<div class="crm-ref-kpis six">${crmRefKpi('Total',rows.length)}${crmRefKpi('Saídas',0)}${crmRefKpi('Entradas',0)}${crmRefKpi('Valor Saídas',crmRefMoney(0),'','success')}${crmRefKpi('Valor Entradas',crmRefMoney(0),'','warning')}${crmRefKpi('Saldo',crmRefMoney(0))}</div>`;const actions=`<div class="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="invoice">${crmRefIcon('plus')} Registrar Nota</button></div>`;const filters=crmRefToolbar(`<input type="date" placeholder="Data início"><input type="date" placeholder="Data fim"><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por número, cliente ou fornecedor…"></label><select><option>Tipo</option><option>Todas</option><option>Saída</option><option>Entrada</option></select><select><option>Status</option><option>Todos</option><option>Emitida</option><option>Pendente</option><option>Paga</option><option>Cancelada</option></select>`);const table=`<section class="crm-ref-table-card"><header><div><h3>Lista de Notas Fiscais</h3><p>Registro de notas de entrada e saída</p></div><span>${rows.length}</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th></th><th>Número</th><th>Tipo</th><th>Cliente / Fornecedor</th><th>Valor</th><th>Data Emissão</th><th>Status</th><th>PDF</th><th class="right">Ações</th></tr></thead></table></div>${rows.length?'':crmRefEmpty('Nenhuma nota fiscal registrada','Registre a primeira nota para iniciar o controle.')}</section>`;return crmRefPage('accounting','invoices','Notas Fiscais','Registro e controle de notas fiscais de entrada e saída',`${crmRefSubtabs(CRM_REF_ACCOUNTING_SUB,'invoices','#/crm/financeiro')}${actions}${k}${filters}${table}`);}
  function crmRefCategoriesPage(){crmRefEnsureState();const rows=state.crmRefCategories;const actions=`<div class="crm-ref-actions"><a href="#/crm/financeiro">← Voltar ao Financeiro</a><button class="primary" data-action="crm-ref-open" data-kind="category">${crmRefIcon('plus')} Criar</button></div>`;const meta=`<div class="crm-ref-mini-badges"><span>0 categorias</span><span>${rows.length} regras/subcategorias</span></div>`;const table=`<section class="crm-ref-table-card"><header><div><h3>Lista de Categorias Financeiras</h3><p>Categorias e subcategorias cadastradas no sistema</p></div><span>${rows.length}</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th></th><th>Categoria</th><th>Subcategoria</th><th>Tipo</th><th>Contraparte</th><th>Status</th><th class="right">Ações</th></tr></thead><tbody>${rows.map(r=>`<tr><td><input type="checkbox"></td><td>${esc(r.category)}</td><td>${esc(r.subcategory||'—')}</td><td>${esc(r.transaction)}</td><td>${esc(r.counterparty)}</td><td>${r.active?'Ativa':'Inativa'}</td><td class="right">•••</td></tr>`).join('')}</tbody></table></div>${rows.length?'':crmRefEmpty('Nenhuma categoria financeira cadastrada')}</section>`;return crmRefPage('accounting','categories','Categorias Financeiras','Categorias e subcategorias da classificação de receitas e despesas',`${crmRefSubtabs(CRM_REF_ACCOUNTING_SUB,'categories','#/crm/financeiro')}${actions}${meta}${table}`);}
  function crmRefFinancialRulesPage(){crmRefEnsureState();const rows=state.crmRefFinancialRules;const actions=`<div class="crm-ref-actions"><a href="#/crm/financeiro">← Voltar ao Financeiro</a><button class="primary" data-action="crm-ref-open" data-kind="financial-rule">${crmRefIcon('plus')} Nova Regra</button></div>`;const table=`<section class="crm-ref-table-card"><header><div><h3>Regras de Automação</h3><p>Cada regra calcula um valor (percentual ou fixo) e notifica quando um dos eventos selecionados ocorre.</p></div><span>${rows.length}</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th>Nome</th><th>Tipo</th><th>Cálculo</th><th>Eventos</th><th>Status</th><th class="right">Ações</th></tr></thead></table></div>${rows.length?'':crmRefEmpty('Nenhuma regra de automação cadastrada')}</section>`;return crmRefPage('accounting','automations','Automações Financeiras','Regras que disparam automaticamente ao assinar contratos, criar/pagar transações e vencer notas fiscais',`${crmRefSubtabs(CRM_REF_ACCOUNTING_SUB,'automations','#/crm/financeiro')}${actions}${table}`);}
  function crmRefCategorizationRulesPage(){crmRefEnsureState();const rows=state.crmRefCategorizationRules;const actions=`<div c