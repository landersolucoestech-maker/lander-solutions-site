lass="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="categorization-rule">${crmRefIcon('plus')} Nova Regra</button></div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por palavra-chave ou categoria"></label><select><option>Tipo</option><option>Todos os tipos</option><option>Receita</option><option>Despesa</option></select><select><option>Origem</option><option>Todas as origens</option><option>Sistema</option><option>Personalizada</option></select><select><option>Status</option><option>Todos</option><option>Ativas</option><option>Inativas</option></select>`);const table=`<section class="crm-ref-table-card"><header><div><h3>Regras de Categorização</h3><p>Acompanhe regras, palavras-chave, categorias, origem e status</p></div><span>${rows.length}</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th></th><th>Palavras-chave</th><th>Categoria</th><th>Tipo</th><th>Origem</th><th class="right">Ações</th></tr></thead></table></div>${rows.length?'':crmRefEmpty('Nenhuma regra de categorização encontrada')}</section>`;return crmRefPage('accounting','rules','Regras de Categorização Financeira','Categorize receitas e despesas automaticamente por palavras-chave, tipo e prioridade.',`${crmRefSubtabs(CRM_REF_ACCOUNTING_SUB,'rules','#/crm/financeiro')}${actions}${filters}${table}`);}

  function crmRefTransactionModal(){const classification=`<section class="crm-ref-form-section"><h3>Classificação</h3><div class="crm-ref-form-grid">${crmRefSelect('Tipo de Transação','type',[['','Selecione'],['receita','Receita'],['despesa','Despesa'],['investimento','Investimento'],['imposto','Imposto'],['transferencia','Transferência']])}${crmRefSelect('Receber de / Pagar para','counterparty',[['empresa','Empresa'],['artista','Artista'],['pessoa','Pessoa']])}${crmRefSelect('Categoria','category',[['','Selecione a categoria'],['servicos','Serviços'],['produtos','Produtos'],['administrativo','Administrativo'],['marketing','Marketing'],['viagens','Viagens']])}${crmRefSelect('Subcategoria','subcategory',[['','Selecione a subcategoria']])}${crmRefField('Artista Vinculado','artist','text','Selecione o artista')}${crmRefField('Projeto Vinculado','project','text','Selecione o projeto')}${crmRefField('Contrato Vinculado','contract','text','Informe o contrato')}${crmRefField('Show / Evento','event','text','Selecione o evento')}${crmRefField('Centro de custo','costCenter','text','Informe o centro de custo')}${crmRefField('Competência','competence','text','Ex: 05/2026')}${crmRefField('Conta Origem','originAccount','text','Informe a conta de origem')}${crmRefField('Conta Destino','destinationAccount','text','Informe a conta de destino')}${crmRefField('Órgão Arrecadador','collector','text','Informe o órgão arrecadador')}</div></section>`;const payment=`<section class="crm-ref-form-section"><h3>Valores e Pagamento</h3><div class="crm-ref-form-grid">${crmRefField('Valor (R$)','value','number','0,00')}${crmRefSelect('Tipo de Pagamento','paymentType',[['avista','À vista'],['parcelado','Parcelado']])}${crmRefSelect('Método de Pagamento','paymentMethod',[['','Selecione'],['pix','PIX'],['ted','TED'],['boleto','Boleto'],['cartao-credito','Cartão de Crédito'],['cartao-debito','Cartão de Débito'],['dinheiro','Dinheiro'],['cheque','Cheque']])}${crmRefField('Data da Transação','date','date','Selecione a data')}${crmRefSelect('Status','status',[['pendente','Pendente'],['aprovado','Aprovado'],['pago','Pago'],['cancelado','Cancelado'],['atrasado','Atrasado']])}${crmRefField('Quantidade de Parcelas','installments','number','Mínimo 2')}${crmRefSelect('Intervalo','interval',[['mensal','Mensal'],['quinzenal','Quinzenal'],['semanal','Semanal']])}${crmRefField('Data da 1ª Parcela','firstDate','date','Selecione a data')}</div></section>`;const details=`<section class="crm-ref-form-section"><h3>Detalhes</h3><div class="crm-ref-form-grid">${crmRefField('Descrição','description','text',"Ex: Pagamento de produção musical para o single 'Nome da Música'")}${crmRefTextarea('Observações','notes','Informações adicionais sobre a transação...')}<label class="crm-ref-field full"><span>Anexo (Comprovante)</span><input type="file" name="attachment"></label></div></section>`;return crmRefModal('Nova Transação',classification+payment+details,'crm-ref-transaction-form',true);}
  function crmRefInvoiceModal(){const body=`<section class="crm-ref-form-section"><h3>Tipo de Operação</h3><div class="crm-ref-choice-row"><label><input type="radio" name="op" checked> Saída</label><label><input type="radio" name="op"> Entrada</label></div></section><section class="crm-ref-form-section"><h3>Identificação</h3><div class="crm-ref-form-grid">${crmRefField('Número da Nota','number','text','000001234')}${crmRefField('Série','series','text','001')}${crmRefSelect('Tipo de Nota','invoiceType',[['servico','Serviço'],['produto','Produto']])}${crmRefField('Data de Emissão','issueDate','date','Selecione a data')}${crmRefSelect('Status','status',[['emitida','Emitida'],['pendente','Pendente'],['paga','Paga'],['cancelada','Cancelada']])}${crmRefField('Natureza da Operação','nature')}${crmRefField('CFOP','cfop','text','5933')}${crmRefField('Código Serviço Municipal','serviceCode')}${crmRefField('Código Município (IBGE)','ibge','text','3550308')}</div></section><section class="crm-ref-form-section"><h3>Tomador / Cliente</h3><div class="crm-ref-form-grid">${crmRefField('Cliente / Fornecedor','customer','text','Selecione um cliente')}${crmRefField('CNPJ / CPF','document','text','00.000.000/0001-00')}${crmRefField('Inscrição Estadual','ie')}${crmRefField('Inscrição Municipal','im')}${crmRefField('E-mail','email','email')}${crmRefField('Endereço','address','text','Av. Paulista, 1000')}${crmRefField('Cidade','city')}${crmRefField('UF','uf')}${crmRefField('CEP','zip','text','00000-000')}</div></section><section class="crm-ref-form-section"><h3>Serviços</h3>${crmRefTextarea('Descrição dos Serviços','services','Descrição completa dos serviços prestados...')}<div class="crm-ref-form-grid">${crmRefField('Valor dos Serviços','value','number','0,00')}${crmRefField('Deduções','deductions','number','0,00')}${crmRefField('Base de Cálculo','base','number','0,00')}${crmRefField('Alíquota ISS (%)','issRate','number','0')}${crmRefField('Valor ISS','iss','number','0,00')}</div></section><section class="crm-ref-form-section"><h3>Pagamento</h3><div class="crm-ref-form-grid">${crmRefSelect('Forma de Pagamento','payment',[['pix','PIX'],['boleto','Boleto'],['transferencia','Transferência'],['cartao','Cartão']])}${crmRefField('Condição','condition','text','30 dias / À vista / 30/60/90')}${crmRefField('Vencimento','due','date','Selecione a data')}<label class="crm-ref-field"><span>Arquivo PDF da Nota</span><input type="file"></label></div>${crmRefTextarea('Observações','notes','Observações adicionais...')}</section>`;return crmRefModal('Registrar Nota Fiscal',body,'crm-ref-invoice-form',true);}
  function crmRefCategoryModal(){return crmRefModal('Nova Categoria Financeira',`<div class="crm-ref-form-grid">${crmRefSelect('Tipo de Transação','transaction',[['Despesa','Despesa'],['Receita','Receita'],['Investimento','Investimento'],['Imposto','Imposto'],['Transferência','Transferência']])}${crmRefSelect('Tipo de Contraparte','counterparty',[['Empresa','Empresa'],['Pessoa','Pessoa'],['Artista','Artista'],['Governo','Governo'],['Conta Própria','Conta Própria']])}${crmRefField('Categoria *','category')}${crmRefField('Subcategoria','subcategory')}${crmRefField('Ordem','sort','number','0')}<label class="crm-ref-field switch"><span>Categoria ativa</span><input type="checkbox" name="active" checked></label></div>`,'crm-ref-category-form');}
  function crmRefFinancialRuleModal(){return crmRefModal('Nova Regra Financeira',`<div class="crm-ref-form-grid">${crmRefField('Nome *','name','text','Ex.: Comissão de agenciamento')}${crmRefSelect('Tipo','type',[['receita','Receita'],['despesa','Despesa'],['comissao','Comissão'],['imposto','Imposto']])}${crmRefField('Categoria','category','text','Opcional')}${crmRefSelect('Cálculo','calculation',[['percentual','Percentual'],['fixo','Valor fixo']])}${crmRefField('Valor (%) / (R$) *','value','number','0.00')}${crmRefTextarea('Descrição','description','Opcional')}<label class="crm-ref-field full"><span>Eventos que disparam esta regra *</span><div class="crm-ref-checks"><label><input type="checkbox"> Contrato assinado</label><label><input type="checkbox"> Transação criada</label><label><input type="checkbox"> Transação paga</label><label><input type="checkbox"> Nota fiscal vencida</label></div></label><label class="crm-ref-field switch"><span>Regra ativa</span><input type="checkbox" name="active" checked></label></div>`,'crm-ref-financial-rule-form');}
  function crmRefCategorizationRuleModal(){return crmRefModal('Nova regra de categorização',`<div class="crm-ref-form-grid">${crmRefSelect('Tipo da transação','type',[['RECEITA','Receita'],['DESPESA','Despesa']])}${crmRefField('Categoria','category','text','Selecione a categoria')}${crmRefField('Palavras-chave','keywords','text','Ex: spotify, deezer, distribuidora')}${crmRefField('Prioridade','priority','number','0')}</div>`,'crm-ref-categorization-rule-form');}

  function crmRefMarketingOverview(){const k=`<div class="crm-ref-kpis four">${crmRefKpi('Campanhas ativas',0)}${crmRefKpi('Projetos musicais em divulgação',0)}${crmRefKpi('Conteúdos programados',0,'','warning')}${crmRefKpi('Tarefas pendentes',0,'','warning')}${crmRefKpi('Conteúdos publicados',0)}${crmRefKpi('Aprovações pendentes',0,'','danger')}${crmRefKpi('Entregas próximas',0)}${crmRefKpi('Performance do setor','0%','','success')}</div>`;const cols=`<div class="crm-ref-grid two"><section class="crm-ref-panel"><header><h3>Entregas próximas</h3><p>Conteúdos a publicar</p><a href="#/crm/marketing/calendar">Ver calendário</a></header>${crmRefEmpty('Nenhuma entrega próxima')}</section><section class="crm-ref-panel"><header><h3>Aprovações pendentes</h3><p>Conteúdos aguardando aprovação</p></header>${crmRefEmpty('Nenhuma aprovação pendente')}</section></div><div class="crm-ref-grid two"><section class="crm-ref-panel"><header><h3>Atalhos rápidos</h3></header><div class="crm-ref-quick-links"><a href="#/crm/marketing/campaigns">Nova Campanha</a><a href="#/crm/marketing/calendar">Novo Conteúdo</a><a href="#/crm/marketing/tasks">Nova Tarefa</a><a href="#/crm/marketing/ai">IA Criativa</a></div></section><section class="crm-ref-panel"><header><h3>Atividades recentes</h3></header>${crmRefEmpty('Nenhuma atividade recente')}</section></div>`;return crmRefPage('marketing','overview','Visão Geral','Cockpit operacional do setor de marketing',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'overview','#/crm/marketing')}${k}${cols}`);}
  function crmRefCampaignsPage(){crmRefEnsureState();const rows=state.crmRefCampaigns;const actions=`<div class="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="campaign">${crmRefIcon('plus')} Nova Campanha</button></div>`;const k=`<div class="crm-ref-kpis five">${crmRefKpi('Campanhas Ativas',0,'em execução')}${crmRefKpi('Budget Total',crmRefMoney(0),'investimento','success')}${crmRefKpi('Gasto Total',crmRefMoney(0),'executado','danger')}${crmRefKpi('Cliques',0,'total')}${crmRefKpi('CTR Médio','0%','taxa de clique')}</div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar por nome ou descrição..."></label>`);const table=`<section class="crm-ref-table-card"><header><div><h3>Lista de Campanhas</h3><p>Acompanhe campanhas, plataformas, investimento, status e performance</p></div><span>${rows.length}</span></header><div class="crm-ref-table-wrap"><table><thead><tr><th></th><th>Nome</th><th>Contexto</th><th>Plataforma</th><th>Status</th><th>Budget</th><th>Gasto</th><th>Cliques</th><th class="right">Ações</th></tr></thead></table></div>${rows.length?'':crmRefEmpty('Nenhuma campanha encontrada')}</section>`;return crmRefPage('marketing','campaigns','Campanhas de Marketing','Planeje, execute e monitore campanhas e tráfego pago',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'campaigns','#/crm/marketing')}${actions}${k}${filters}${table}`);}
  function crmRefCalendarPage(){const actions=`<div class="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="content">${crmRefIcon('plus')} Novo Conteúdo</button></div>`;const k=`<div class="crm-ref-kpis four">${crmRefKpi('Conteúdos',0,'no total')}${crmRefKpi('Agendados',0,'aguardando publicação','warning')}${crmRefKpi('Publicados',0,'conteúdos publicados','success')}${crmRefKpi('Próximos 7 dias',0,'na próxima semana')}</div>`;const toolbar=crmRefToolbar(`<button>Hoje</button><button>‹</button><button>›</button><span class="crm-ref-period">agosto de 2026</span><label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar conteúdo..."></label><select><option>Mês</option><option>Semana</option><option>Dia</option></select>`);const weekdays=['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];const cal=`<section class="crm-ref-calendar"><div class="crm-ref-weekdays">${weekdays.map(x=>`<span>${x}</span>`).join('')}</div><div class="crm-ref-calendar-grid">${Array.from({length:35},(_,i)=>`<div><b>${i<4?28+i:i-3}</b></div>`).join('')}</div></section>`;return crmRefPage('marketing','calendar','Marketing - Calendário de Conteúdo','Programação de conteúdos',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'calendar','#/crm/marketing')}${actions}${k}${toolbar}${cal}`);}
  function crmRefMetricsPage(){const tabs=`<nav class="crm-ref-pnl-tabs"><button class="active">Visão Geral</button><button>Instagram</button><button>Facebook</button><button>TikTok</button><button>YouTube</button><button>Spotify</button></nav>`;const k=`<div class="crm-ref-kpis six">${crmRefKpi('Alcance',0)}${crmRefKpi('Visualizações',0)}${crmRefKpi('Audiência',0)}${crmRefKpi('Cliques',0)}${crmRefKpi('Conversões',0)}${crmRefKpi('Investimento',crmRefMoney(0))}</div>`;const panels=`<div class="crm-ref-grid two"><section class="crm-ref-panel"><header><h3>Performance por plataforma</h3></header>${crmRefEmpty('Sem dados de performance')}</section><section class="crm-ref-panel"><header><h3>Conteúdos com melhor resultado</h3></header>${crmRefEmpty('Sem dados para o período')}</section></div>`;return crmRefPage('marketing','metrics','Métricas','Performance de marketing por plataforma',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'metrics','#/crm/marketing')}<div class="crm-ref-actions right"><button>Exportar</button></div>${tabs}${k}${panels}`);}
  function crmRefBriefingsPage(){crmRefEnsureState();const rows=state.crmRefBriefings;const actions=`<div class="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="briefing">${crmRefIcon('plus')} Novo Briefing</button></div>`;const k=`<div class="crm-ref-kpis four">${crmRefKpi('Briefings abertos',0)}${crmRefKpi('Em revisao',0)}${crmRefKpi('Aprovados',0)}${crmRefKpi('Entregáveis planejados',0)}</div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar briefing, objetivo, público ou responsável..."></label>`);const table=`<section class="crm-ref-table-card"><header><div><h3>Lista de Briefings</h3><p>Acompanhe briefings, tipos, objetivos, responsáveis e status</p></div><span>${rows.length}</span></header>${crmRefEmpty('Nenhum briefing encontrado','Crie um briefing para documentar a origem estratégica do projeto antes da execução.')}</section>`;return crmRefPage('marketing','briefings','Briefings','Origem estratégica dos projetos',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'briefings','#/crm/marketing')}${actions}${k}${filters}${table}`);}
  function crmRefTasksPage(){crmRefEnsureState();const rows=state.crmRefTasks;const actions=`<div class="crm-ref-actions right"><button class="primary" data-action="crm-ref-open" data-kind="task">${crmRefIcon('plus')} Nova Tarefa</button></div>