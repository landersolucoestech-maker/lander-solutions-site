grid-template-columns:minmax(0,1fr) 290px;overflow-y:auto;padding:14px;gap:12px}.crm-ref-campaign-stage{min-width:0;border:1px solid #e2e7ed;border-radius:9px;background:#fff;padding:14px}.crm-ref-campaign-stage>[data-campaign-step]{display:block}.crm-ref-campaign-stage>[data-campaign-step][hidden]{display:none!important}.crm-ref-campaign-side{display:grid;align-content:start;gap:10px}.crm-ref-campaign-side>section{border:1px solid #e2e7ed;border-radius:9px;background:#fff;padding:12px}.crm-ref-campaign-side h3{margin:0 0 9px;font-size:10px}.crm-ref-campaign-side p{font-size:8px;color:#7a8796}.crm-ref-campaign-side dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:5px 8px;font-size:8px}.crm-ref-campaign-side dt{color:#7a8796}.crm-ref-campaign-side dd{margin:0;text-align:right;font-weight:700}.crm-ref-objective-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:12px}.crm-ref-objective-list{display:grid;gap:7px}.crm-ref-objective-list button,.crm-ref-choice-grid button{border:1px solid #dfe5eb;border-radius:8px;background:#fff;color:#0B1D3A;text-align:left;padding:11px;cursor:pointer}.crm-ref-objective-list button:first-child{border-color:#D4AF37;background:#fffdf4}.crm-ref-objective-list strong,.crm-ref-choice-grid strong{display:block;font-size:9px}.crm-ref-choice-grid small{display:block;margin-top:4px;color:#7a8796;font-size:7px}.crm-ref-choice-grid.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.crm-ref-objective-copy{border:1px solid #e2e7ed;border-radius:8px;background:#f9fafb;padding:16px}.crm-ref-objective-copy h3{margin:0;font-size:13px}.crm-ref-objective-copy p{color:#657385;font-size:9px;line-height:1.55}.crm-ref-objective-copy small{display:block;color:#7a8796;font-size:8px;font-weight:700}.crm-ref-objective-copy>div{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}.crm-ref-objective-copy span{border:1px solid #dfe5eb;background:#fff;border-radius:999px;padding:4px 7px;font-size:7px}.crm-ref-phone-preview{width:128px;min-height:220px;margin:auto;border:4px solid #d6dde5;border-radius:20px;padding:11px;display:flex;flex-direction:column;gap:8px;justify-content:space-between;background:#fafbfc}.crm-ref-phone-preview strong{font-size:8px}.crm-ref-phone-preview span,.crm-ref-phone-preview p,.crm-ref-phone-preview small{font-size:7px!important;color:#7a8796}.crm-ref-campaign-modal footer>div{display:flex;gap:7px}.crm-ref-reports-empty{border:1px dashed #d7dfe7;border-radius:9px;padding:30px;text-align:center;color:#7a8796;font-size:9px}.crm-ref-entity-list article>.crm-ref-entity-copy{width:auto;height:auto;background:transparent;place-items:start;display:grid;gap:2px}.crm-ref-entity-copy small{font-size:7px;color:#8a95a3}.crm-ref-entity-list button:disabled{opacity:.45;cursor:not-allowed}
.crm-ref-workspace input,.crm-ref-workspace select,.crm-ref-workspace textarea{color-scheme:light!important}.crm-ref-workspace option,.crm-ref-modal option{background:#fff!important;color:#0B1D3A!important}.crm-ref-modal-root,.crm-ref-modal-root *{color-scheme:light!important;scrollbar-color:auto!important}.crm-ref-modal-root *::-webkit-scrollbar,.crm-ref-modal-root *::-webkit-scrollbar-thumb,.crm-ref-modal-root *::-webkit-scrollbar-track{all:revert!important}
@media(max-width:1200px){.crm-ref-campaign-layout{grid-template-columns:1fr}.crm-ref-campaign-side{grid-template-columns:repeat(3,minmax(0,1fr))}.crm-ref-stepper{overflow-x:auto;grid-template-columns:repeat(9,minmax(95px,1fr))}.crm-ref-kpis.five,.crm-ref-kpis.six{grid-template-columns:repeat(3,1fr)}.crm-ref-integration-grid{grid-template-columns:repeat(2,1fr)}.crm-ref-plan-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:860px){.crm-ref-campaign-side{grid-template-columns:1fr}.crm-ref-objective-layout{grid-template-columns:1fr}.crm-ref-choice-grid.two{grid-template-columns:1fr}.crm-ref-workspace{padding:16px!important}.crm-ref-kpis.four,.crm-ref-kpis.five,.crm-ref-kpis.six{grid-template-columns:repeat(2,1fr)}.crm-ref-grid.two{grid-template-columns:1fr}.crm-ref-form-grid{grid-template-columns:1fr}.crm-ref-settings-blocks,.crm-ref-integration-grid,.crm-ref-plan-grid{grid-template-columns:1fr}.crm-ref-toolbar{align-items:stretch}.crm-ref-search{min-width:100%}.crm-ref-calendar{overflow:auto}.crm-ref-weekdays,.crm-ref-calendar-grid{min-width:700px}.crm-ref-choice-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.crm-ref-kpis.four,.crm-ref-kpis.five,.crm-ref-kpis.six{grid-template-columns:1fr}.crm-ref-modal-root{padding:8px}.crm-ref-modal{max-height:96vh}.crm-ref-workspace{padding:12px!important}}
