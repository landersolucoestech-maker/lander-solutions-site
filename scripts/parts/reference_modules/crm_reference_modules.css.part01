/* VALTREN CRM REFERENCE MODULES */
.crm-ref-shell,.crm-ref-shell *{box-sizing:border-box}.crm-ref-workspace{padding:22px 28px 40px!important;max-width:none!important;width:100%!important;background:#f7f9fb!important;color:#0B1D3A!important;min-height:calc(100vh - 82px)}
.crm-ref-subtabs{display:flex;gap:5px;flex-wrap:wrap;margin:0 0 18px;border-bottom:1px solid #e4e9ef;padding-bottom:8px}.crm-ref-subtabs a{padding:8px 10px;border-radius:7px;text-decoration:none;color:#697588;font:700 9px Raleway,Arial,sans-serif}.crm-ref-subtabs a.active{background:#0B1D3A;color:#fff}.crm-ref-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:16px}.crm-ref-actions.right{justify-content:flex-end}.crm-ref-actions button,.crm-ref-actions a,.crm-ref-panel button,.crm-ref-panel a,.crm-ref-entity-list button,.crm-ref-import-head button{height:33px;padding:0 11px;border:1px solid #d9e0e8;border-radius:7px;background:#fff;color:#0B1D3A;display:inline-flex;align-items:center;gap:6px;text-decoration:none;font:800 9px Raleway,Arial,sans-serif;cursor:pointer}.crm-ref-actions .primary,.crm-ref-panel .primary{background:#0B1D3A;color:#fff;border-color:#0B1D3A}.crm-ref-kpis{display:grid;gap:10px;margin-bottom:16px}.crm-ref-kpis.four{grid-template-columns:repeat(4,minmax(0,1fr))}.crm-ref-kpis.five{grid-template-columns:repeat(5,minmax(0,1fr))}.crm-ref-kpis.six{grid-template-columns:repeat(6,minmax(0,1fr))}.crm-ref-kpi{background:#fff;border:1px solid #e2e7ed;border-radius:10px;padding:13px;min-height:88px;display:grid;grid-template-columns:32px 1fr;grid-template-rows:auto auto auto;column-gap:9px}.crm-ref-kpi>div{grid-row:1/4;width:32px;height:32px;border-radius:8px;background:#eef2f6;display:grid;place-items:center}.crm-ref-kpi span{font:800 8px Raleway,Arial,sans-serif;color:#728094;text-transform:uppercase;letter-spacing:.05em}.crm-ref-kpi strong{font:800 18px Raleway,Arial,sans-serif;color:#0B1D3A;margin-top:4px}.crm-ref-kpi small{font:8px Montserrat,Arial,sans-serif;color:#8b96a4;margin-top:4px}.crm-ref-kpi.success>div{background:#e9f6ef;color:#27734d}.crm-ref-kpi.warning>div{background:#fff6e5;color:#9b6a1e}.crm-ref-kpi.danger>div{background:#ffeff0;color:#9d3944}
.crm-ref-toolbar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;padding:9px;border:1px solid #e2e7ed;border-radius:9px;background:#eef2f6;margin-bottom:16px}.crm-ref-toolbar input,.crm-ref-toolbar select,.crm-ref-search{height:32px;border:1px solid #d7dee7!important;border-radius:7px!important;background:#fff!important;color:#0B1D3A!important;font:9px Montserrat,Arial,sans-serif!important}.crm-ref-toolbar>input{padding:0 9px}.crm-ref-toolbar select{padding:0 8px;min-width:115px}.crm-ref-search{display:flex;align-items:center;gap:6px;padding:0 9px;flex:1;min-width:210px}.crm-ref-search input{border:0!important;outline:0!important;width:100%;height:30px!important;padding:0!important;background:#fff!important;color:#0B1D3A!important}.crm-ref-period{color:#627084;font-size:10px;font-weight:700;min-width:120px}.crm-ref-table-card,.crm-ref-panel{background:#fff;border:1px solid #e0e6ed;border-radius:10px;overflow:hidden;margin-bottom:14px}.crm-ref-table-card>header,.crm-ref-panel>header{padding:13px 15px;border-bottom:1px solid #e9edf2;display:flex;align-items:center;justify-content:space-between;gap:12px}.crm-ref-table-card>header h3,.crm-ref-panel>header h3{margin:0;color:#0B1D3A;font-size:11px}.crm-ref-table-card>header p,.crm-ref-panel>header p{margin:3px 0 0;color:#7a8696;font:8px Montserrat,Arial,sans-serif}.crm-ref-table-card>header>span{font-size:9px;color:#728094}.crm-ref-table-wrap{overflow:auto}.crm-ref-table-wrap table{width:100%;border-collapse:collapse}.crm-ref-table-wrap th{padding:9px 11px;text-align:left;background:#f8fafc;border-bottom:1px solid #e7ebf0;color:#667487;font-size:8px;text-transform:uppercase;letter-spacing:.04em}.crm-ref-table-wrap td{padding:10px 11px;border-bottom:1px solid #edf0f3;color:#253348;font:9px Montserrat,Arial,sans-serif}.crm-ref-table-wrap .right{text-align:right}.crm-ref-badge,.crm-ref-mini-badges span{display:inline-flex;border:1px solid #dae1e8;border-radius:999px;padding:4px 7px;background:#f8fafc;color:#5c6979;font-size:8px}.crm-ref-mini-badges{display:flex;gap:7px;margin-bottom:13px}.crm-ref-empty{min-height:150px;padding:28px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#8a95a3}.crm-ref-empty>div{opacity:.45}.crm-ref-empty strong{margin-top:8px;font-size:10px;color:#536174}.crm-ref-empty span{margin-top:5px;font:8px Montserrat,Arial,sans-serif;max-width:420px}.crm-ref-grid{display:grid;gap:12px}.crm-ref-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.crm-ref-grid.one{grid-template-columns:1fr}.crm-ref-panel>.crm-ref-form-grid,.crm-ref-panel>.crm-ref-field,.crm-ref-panel>.crm-ref-settings-blocks,.crm-ref-panel>.crm-ref-integration-grid,.crm-ref-panel>.crm-ref-profile-head,.crm-ref-panel>.crm-ref-plan,.crm-ref-panel>.crm-ref-plan-grid{margin:14px}.crm-ref-panel .crm-ref-empty{min-height:120px}.crm-ref-quick-links{padding:13px;display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.crm-ref-quick-links a{justify-content:flex-start}.crm-ref-pnl-tabs,.crm-ref-ai-tabs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px}.crm-ref-pnl-tabs button,.crm-ref-ai-tabs button{height:31px;border:1px solid #dce3ea;border-radius:7px;background:#fff;color:#697688;padding:0 10px;font:700 9px Raleway,Arial,sans-serif;cursor:pointer}.crm-ref-pnl-tabs button.active,.crm-ref-ai-tabs button.active{background:#0B1D3A;color:#fff;border-color:#0B1D3A}
.crm-ref-calendar{background:#fff;border:1px solid #e0e6ed;border-radius:10px;overflow:hidden}.crm-ref-weekdays,.crm-ref-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr)}.crm-ref-weekdays span{padding:9px;text-align:center;background:#f8fafc;border-bottom:1px solid #e7ebf0;color:#7a8797;font-size:8px;font-weight:800}.crm-ref-calendar-grid>div{min-height:96px;border-right:1px solid #edf0f3;border-bottom:1px solid #edf0f3;padding:8px;background:#fff}.crm-ref-calendar-grid>div:nth-child(7n){border-right:0}.crm-ref-calendar-grid b{font-size:9px;color:#657286}.crm-ref-ai-panel{padding:18px}.crm-ref-ai-hero{text-align:center;padding:8px 0 18px}.crm-ref-ai-hero>span{font-size:8px;text-transform:uppercase;color:#9a7d24;font-weight:800}.crm-ref-ai-hero h2{margin:6px 0;color:#0B1D3A;font-size:22px}.crm-ref-ai-hero p{margin:0;color:#788595;font-size:9px}.crm-ref-primary-wide{height:35px;border:0;border-radius:7px;background:#0B1D3A;color:#fff;padding:0 14px;font-size:9px;font-weight:800;margin-top:12px}.crm-ref-stepper{display:flex;gap:6px;overflow:auto;padding-bottom:4px}.crm-ref-stepper span{min-width:90px;padding:8px;border:1px solid #dfe5eb;border-radius:6px;color:#758192;font-size:8px}.crm-ref-stepper span.active{border-color:#0B1D3A;background:#eef2f6;color:#0B1D3A;font-weight:800}.crm-ref-choice-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.crm-ref-choice-grid button,.crm-ref-choice-row label{border:1px solid #dce3ea;border-radius:8px;background:#fff;color:#334155;padding:12px;text-align:left;font-size:9px}.crm-ref-builder-note,.crm-ref-note{border:1px solid #e0e6ed;background:#f8fafc;border-radius:8px;padding:10px 12px;color:#667487;font:8px/1.5 Montserrat,Arial,sans-serif;margin-bottom:13px}
.crm-ref-modal-root{position:fixed;inset:0;z-index:11000;display:grid;place-items:center;padding:22px}.crm-ref-modal-backdrop{position:absolute;inset:0;background:rgba(5,17,34,.55);backdrop-filter:blur(2px)}.crm-ref-modal{position:relative;width:min(720px,100%);max-height:92vh;background:#fff!important;color:#0B1D3A!important;border-radius:12px;box-shadow:0 24px 80px rgba(0,0,0,.26);overflow:hidden;display:flex;flex-direction:column}.crm-ref-modal.wide{width:min(980px,100%)}.crm-ref-modal>header{padding:15px 18px;border-bottom:1px solid #e7ebf0;display:flex;align-items:center;justify-content:space-between}.crm-ref-modal>header h2{margin:0;color:#0B1D3A!important;font-size:17px}.crm-ref-modal>header button{width:30px;height:30px;border:0;border-radius:7px;background:#f1f4f7;color:#586576;font-size:17px}.crm-ref-modal form{display:flex;flex-direction:column;min-height:0}.crm-ref-modal-body{padding:16px 18px;overflow-y:auto;display:grid;gap:15px}.crm-ref-modal footer{display:flex;justify-content:flex-end;gap:7px;padding:11px 18px;border-top:1px solid #e7ebf0;background:#fafbfc}.crm-ref-modal footer button{height:33px;border-radius:7px;padding:0 12px;font-size:9px;font-weight:800}.crm-ref-modal footer .secondary{background:#fff;border:1px solid #d9e0e8;color:#0B1D3A}.crm-ref-modal footer .primary{background:#0B1D3A;border:1px solid #0B1D3A;color:#fff}.crm-ref-form-section{display:grid;gap:10px}.crm-ref-form-section>h3{margin:0;padding-bottom:6px;border-bottom:1px solid #e7ebf0;color:#536174;font-size:9px;text-transform:uppercase;letter-spacing:.06em}.crm-ref-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.crm-ref-field{display:grid;gap:5px;min-width:0}.crm-ref-field.full{grid-column:1/-1}.crm-ref-field>span{color:#4d5968;font-size:9px;font-weight:700}.crm-ref-field input,.crm-ref-field select,.crm-ref-field textarea{width:100%;border:1px solid #d5dde6!important;border-radius:7px!important;background:#fff!important;color:#0B1D3A!important;outline:0!important;font:9px Montserrat,Arial,sans-serif!important;padding:0 9px!important}.crm-ref-field input,.crm-ref-field select{height:35px!important}.crm-ref-field textarea{min-height:74px;padding-top:9px!important;resize:vertical}.crm-ref-field input:focus,.crm-ref-field select:focus,.crm-ref-field textarea:focus{border-color:#D4AF37!important;box-shadow:0 0 0 2px rgba(212,175,55,.12)!important}.crm-ref-field.switch{display:flex;align-items:center;justify-content:space-between;border:1px solid #e0e6ed;border-radius:7px;padding:8px 10px}.crm-ref-checks{display:flex;gap:8px;flex-wrap:wrap}.crm-ref-checks label,.crm-ref-switch{display:flex;align-items:center;gap:5px;font-size:9px;color:#536174}.crm-ref-choice-row{display:flex;gap:8px}.crm-ref-accordion{display:grid;gap:7px;padding:12px}.crm-ref-accordion details{border:1px solid #e0e6ed;border-radius:8px;background:#fff;overflow:hidden}.crm-ref-accordion summary{display:flex;align-items:center;gap:8px;padding:11px;cursor:pointer;list-style:none}.crm-ref-accordion summary::-webkit-details-marker{display:none}.crm-ref-accordion summary b{background:#eef2f6;border-radius:5px;padding:4px 6px;font-size:8px}.crm-ref-accordion summary strong{font-size:9px}.crm-ref-accordion summary span{font-size:8px;color:#7b8796}.crm-ref-accordion summary em,.crm-ref-accordion summary small{font-size:7px;border:1px solid #dfe5eb;border-radius:999px;padding:3px 6px;font-style:normal}.crm-ref-accordion details>.crm-ref-form-grid,.crm-ref-accordion details>.crm-ref-form-section,.crm-ref-accordion details>.crm-ref-checks{padding:12px;border-top:1px solid #e8edf2}.crm-ref-entity-list{background:#fff;border:1px solid #e0e6ed;border-radius:10px;overflow:hidden}.crm-ref-entity-list article{display:flex;align-items:center;gap:9px;padding:10px 12px;border-bottom:1px solid #edf0f3}.crm-ref-entity-list article:last-child{border-bottom:0}.crm-ref-entity-list article>div{width:27px;height:27px;border-radius:7px;background:#eef2f6;display:grid;place-items:center}.crm-ref-entity-list article strong{font-size:9px}.crm-ref-entity-list article>span{flex:1}.crm-ref-dropzone{border:2px dashed #d7dfe7;border-radius:10px;padding:28px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#7c8898;cursor:pointer}.crm-ref-dropzone strong{color:#526073;font-size:10px}.crm-ref-dropzone span{font-size:8px}.crm-ref-import-head{display:flex;justify-content:flex-end}.crm-ref-import-stages{display:flex;gap:6px}.crm-ref-import-stages span{flex:1;border:1px solid #dfe5eb;border-radius:6px;padding:7px;text-align:center;font-size:8px;color:#7d8998}.crm-ref-import-stages span.active{border-color:#0B1D3A;color:#0B1D3A;background:#f4f6f8}.crm-ref-settings-blocks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.crm-ref-settings-blocks article{border:1px solid #e2e7ed;border-radius:8px;padding:11px;display:grid;gap:7px}.crm-ref-settings-blocks h4{margin:0;font-size:9px}.crm-ref-settings-blocks p,.crm-ref-settings-blocks label{font-size:8px;color:#748193}.crm-ref-settings-blocks article.danger{border-color:#f0ced2;background:#fff7f8}.crm-ref-integration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.crm-ref-integration-grid article{border:1px solid #e2e7ed;border-radius:8px;padding:11px;display:grid;gap:8px}.crm-ref-integration-grid strong{font-size:9px}.crm-ref-logo-upload{display:flex;align-items:center;gap:12px}.crm-ref-logo-upload img{width:150px;background:#0B1D3A;border-radius:8px;padding:9px}.crm-ref-profile-head{display:flex;align-items:center;gap:10px}.crm-ref-profile-head>div:first-child{width:48px;height:48px;border-radius:50%;background:#0B1D3A;color:#fff;display:grid;place-items:center;font-weight:800}.crm-ref-profile-head h2{margin:0;font-size:14px}.crm-ref-profile-head p{margin:3px 0 0;font-size:8px;color:#7a8796}.crm-ref-plan{display:flex;align-items:center;justify-content:space-between}.crm-ref-plan>div{display:grid;gap:3px}.crm-ref-plan strong{font-size:10px}.crm-ref-plan span{font-size:8px;color:#7a8796}.crm-ref-plan-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.crm-ref-plan-grid article{border:1px solid #e2e7ed;border-radius:8px;padding:12px;display:grid;gap:7px}.crm-ref-plan-grid h3{margin:0;font-size:11px}.crm-ref-plan-grid p{margin:0;color:#7a8796;font-size:8px}
.crm-ref-chip-select{display:flex;flex-wrap:wrap;gap:5px}.crm-ref-chip-select button{border:1px solid #dfe5eb;border-radius:999px;background:#fff;color:#536174;padding:5px 9px;font-size:8px;font-weight:700}.crm-ref-chip-select button:first-child{border-color:#D4AF37;background:#fffdf4;color:#0B1D3A}.crm-ref-field>small{color:#7a8796;font-size:7px}.crm-ref-advanced{border:1px solid #e1e6ec;border-radius:8px;background:#fff}.crm-ref-advanced summary{padding:10px 11px;display:flex;justify-content:space-between;cursor:pointer;font-size:9px;font-weight:800}.crm-ref-advanced>div{padding:11px;border-top:1px solid #e7ebf0}.crm-ref-campaign-modal{width:min(1100px,100%)!important}.crm-ref-campaign-modal>header{align-items:flex-start}.crm-ref-campaign-modal>header p{margin:4px 0 0;color:#748193;font-size:8px}.crm-ref-campaign-modal form{min-height:0}.crm-ref-stepper{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:3px;padding:10px 14px;border-bottom:1px solid #e7ebf0;background:#fafbfc}.crm-ref-stepper button{border:0;background:transparent;color:#84909f;display:flex;align-items:center;gap:4px;justify-content:center;padding:5px 3px;font-size:7px;font-weight:700}.crm-ref-stepper button b{width:18px;height:18px;border-radius:50%;background:#e9edf2;display:grid;place-items:center}.crm-ref-stepper button.active{color:#0B1D3A}.crm-ref-stepper button.active b{background:#0B1D3A;color:#fff}.crm-ref-campaign-layout{min-height:0;display:grid;