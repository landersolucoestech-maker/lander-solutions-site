t approvedBy',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);const a=e.service.approve(row.id);assert(a.approvedAt);eq(a.approvedBy,'user1');});
test('aprovação congela source hash',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});const hash=row.sourceSnapshotHash;e.service.submitToReview(row.id);const a=e.service.approve(row.id);eq(a.metadata.approvedSourceSnapshotHash,hash);});
test('transição draft direto para approve é inválida',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert.throws(()=>e.service.approve(row.id),/em revisão/);});
test('aprovado não pode voltar ao editor draft',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);assert.throws(()=>e.service.submitToReview(row.id),/Rascunho/);});
test('memória inclui workflow histórico e fontes',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);const m=e.service.memory(row.id);assert(m.history.length>=2);assert(m.sourceSnapshot.hash);});

// Changes, immutability, revisions, duplicate obligation.
test('fonte alterada não muda valor aprovado',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);const amount=row.participationAmount;e.rows.find(r=>r.id==='rev1').contribution=900;e.service.refreshConsistency(row.id);close(row.participationAmount,amount);eq(row.consistencyStatus,'source_changed');});
test('Rateio alterado pode sinalizar source_changed sem sobrescrever aprovado',()=>{const allocations={cost1:{allocation:{id:'alloc1',name:'Rateio',status:'posted',consistencyStatus:'consistent'},lines:[{id:'l1',destinationType:'product',destinationId:'prod1',amount:200}]}};const e=makeEnv({rules:[percentageRule({deductions:['Rateios elegíveis']})],allocations});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);const amount=row.participationAmount;e.rows.find(r=>r.id==='cost1').contribution=-150;e.service.refreshConsistency(row.id);eq(row.consistencyStatus,'source_changed');close(row.participationAmount,amount);});
test('Nota Fiscal alterada pode sinalizar source_changed',()=>{const docs=[{fiscalDocumentId:'nf1',status:'issued',issueDate:'2026-08-05',currency:'BRL',taxes:[{id:'t1',taxType:'ISS',amount:30}],retentions:[],transactionIds:[],productId:'prod1',isDemo:false}];const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})],rows:[{id:'r',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:1000,currency:'BRL',productId:'prod1'}],fiscalDocs:docs});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);docs[0].taxes[0].amount=40;e.service.refreshConsistency(row.id);eq(row.consistencyStatus,'source_changed');});
test('regra contratual alterada sinaliza rule_changed',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);e.rules[0].percentage=25;e.service.refreshConsistency(row.id);eq(row.consistencyStatus,'rule_changed');close(row.participationAmount,185);});
test('nova revisão cria novo ID',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);const rev=e.service.createNewRevision(row.id);assert.notStrictEqual(rev.id,row.id);eq(rev.revisionNumber,2);});
test('nova revisão preserva anterior aprovado até nova aprovação',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);const rev=e.service.createNewRevision(row.id);eq(row.workflowStatus,'approved');eq(rev.workflowStatus,'draft');});
test('aprovar nova revisão substitui anterior sem apagar',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);const rev=e.service.createNewRevision(row.id);e.service.submitToReview(rev.id);e.service.approve(rev.id);eq(row.workflowStatus,'superseded');eq(row.supersededBy,rev.id);assert(e.service.getCalculation(row.id));});
test('duplicidade ativa da mesma obrigação é bloqueada',()=>{const e=makeEnv({rules:[percentageRule()]});e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert.throws(()=>e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}),/cálculo ativo/);});
test('revisão explícita não é confundida com duplicidade ilegítima',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);e.service.approve(row.id);assert(e.service.createNewRevision(row.id));});

// Batch and future payout feed.
test('preview em lote encontra famílias elegíveis',()=>{const e=makeEnv({rules:[percentageRule(),percentageRule({contractId:'ctr2',contractNumber:'CTR-2',ruleId:'r2',participantPartyId:'p2'})]});eq(e.service.previewEligible({from:'2026-08-01',to:'2026-08-31'}).length,2);});
test('cálculo em lote cria Rascunhos e não aprova',()=>{const e=makeEnv({rules:[percentageRule(),percentageRule({contractId:'ctr2',contractNumber:'CTR-2',ruleId:'r2',participantPartyId:'p2'})]});const rows=e.service.createBatch({from:'2026-08-01',to:'2026-08-31'});eq(rows.length,2);assert(rows.every(r=>r.workflowStatus==='draft'));});
test('feed de Repasses inclui somente approved consistente',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(e.service.obligationsFeed().length,0);e.service.submitToReview(row.id);eq(e.service.obligationsFeed().length,0);e.service.approve(row.id);eq(e.service.obligationsFeed().length,1);});
test('draft não entra no feed',()=>{const e=makeEnv({rules:[percentageRule()]});e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(e.service.obligationsFeed().length,0);});
test('review não entra no feed',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(r.id);eq(e.service.obligationsFeed().length,0);});
test('rejected não entra no feed',()=>{const e=makeEnv({rules:[percentageRule()]});const r=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(r.id);e.service.reject(r.id,'x');eq(e.service.obligationsFeed().length,0);});
test('superseded não entra no feed',()=>{const e=makeEnv({rules:[percentageRule()]});const a=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(a.id);e.service.approve(a.id);const b=e.service.crea