:'r1'});assert(!p.deductions.some(d=>d.sourceType==='cost_allocation'));});
test('Rateio inconsistente necessário bloqueia',()=>{const allocations={cost1:{allocation:{id:'alloc1',status:'posted',consistencyStatus:'needs_review'},lines:[]}};const e=makeEnv({rules:[percentageRule({deductions:['Rateios elegíveis']})],allocations});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');eq(p.consistencyStatus,'needs_review');});
test('custo e Rateio da mesma despesa não sofrem double counting',()=>{const allocations={cost1:{allocation:{id:'alloc1',name:'Rateio custo',status:'posted',consistencyStatus:'consistent'},lines:[{id:'line1',destinationType:'product',destinationId:'prod1',amount:200}]}};const e=makeEnv({rules:[percentageRule({deductions:['Custos elegíveis','Rateios elegíveis']})],allocations});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,200);});

// Rule calculation types and cents.
test('percentage calcula valor final em centavos',()=>{const e=makeEnv({rules:[percentageRule({percentage:20})],rows:[{id:'r',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:100.03,currency:'BRL',productId:'prod1'}]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.participationAmount,20.01);});
test('aritmética não persiste ruído 0.30000000000000004',()=>{eq(Core.fromCents(Core.toCents(0.1)+Core.toCents(0.2)),0.3);});
test('NaN monetário é rejeitado',()=>{assert.throws(()=>Core.toCents(NaN),/inválido/);});
test('Infinity monetário é rejeitado',()=>{assert.throws(()=>Core.toCents(Infinity),/inválido/);});
test('fixed completo funciona',()=>{const e=makeEnv({rules:[percentageRule({type:'fixed',percentage:null,fixedValue:500,basisType:'gross_revenue'})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.participationAmount,500);});
test('fixed mensal parcial sem prorrata bloqueia',()=>{const e=makeEnv({rules:[percentageRule({type:'fixed',percentage:null,fixedValue:500,metadata:{fixedFrequency:'monthly'}})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-15',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');assert(/prorrata/.test(p.message));});
test('fixed mensal parcial com prorrata diária explícita funciona',()=>{const e=makeEnv({rules:[percentageRule({type:'fixed',percentage:null,fixedValue:310,metadata:{fixedFrequency:'monthly',prorationPolicy:'daily'}})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-15',economicRuleId:'r1'});close(p.participationAmount,150);});
test('tiered sem tiers bloqueia',()=>{const e=makeEnv({rules:[percentageRule({type:'tiered',percentage:null,metadata:{}})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});
test('tiered com tiers completos calcula deterministicamente',()=>{const e=makeEnv({rules:[percentageRule({type:'tiered',percentage:null,metadata:{tiers:[{from:0,to:999,percentage:10},{from:1000,to:null,percentage:20}]}})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.participationAmount,92.5);});
test('tiers sobrepostos bloqueiam',()=>{const e=makeEnv({rules:[percentageRule({type:'tiered',percentage:null,metadata:{tiers:[{from:0,to:1000,percentage:10},{from:900,to:2000,percentage:20}]}})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});
test('custom sem resolver bloqueia',()=>{const e=makeEnv({rules:[percentageRule({type:'custom',percentage:null})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});
test('custom com resolver formal calcula',()=>{const e=makeEnv({rules:[percentageRule({type:'custom',percentage:null})],customRuleResolver:()=>({amount:77.77,currency:'BRL',resolverReference:'formal-v1'})});close(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).participationAmount,77.77);});
test('custom não aceita moeda divergente',()=>{const e=makeEnv({rules:[percentageRule({type:'custom',percentage:null})],customRuleResolver:()=>({amount:77,currency:'USD'})});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});

// Memory, persistence and workflow.
test('criação persiste como Rascunho',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(row.workflowStatus,'draft');eq(row.calculationStatus,'calculated');});
test('cálculo persiste segmentos',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(e.service.getSegments(row.id).length,1);});
test('cálculo persiste componentes da base',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(e.service.getBaseComponents(row.id).length>0);});
test('cálculo persiste memória de deduções',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(e.service.getDeductions(row.id).length>0);});
test('sourceSnapshotHash é determinístico',()=>{const e=makeEnv({rules:[percentageRule()]});const a=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}),b=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(a.sourceSnapshotHash,b.sourceSnapshotHash);eq(a.ruleSnapshotHash,b.ruleSnapshotHash);});
test('snapshot preserva regra contratual usada',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(row.ruleSnapshot[0].economicRuleId,'r1');eq(row.ruleSnapshot[0].percentage,20);});
test('snapshot preserva participante histórico',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(row.participantSnapshot.name,'João Silva');});
test('Rascunho envia para Em revisão',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(e.service.submitToReview(row.id).workflowStatus,'review');});
test('bloqueado não envia para revisão',()=>{const e=makeEnv({rules:[percentageRule({basisType:'custom_reference'})]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert.throws(()=>e.service.submitToReview(row.id),/bloqueado/);});
test('Em revisão pode ser rejeitado com motivo',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);const rejected=e.service.reject(row.id,'Base incorreta');eq(rejected.workflowStatus,'rejected');eq(rejected.rejectionReason,'Base incorreta');});
test('rejeição sem motivo é bloqueada',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);assert.throws(()=>e.service.reject(row.id,''),/obrigatório/);});
test('Em revisão pode ser aprovada',()=>{const e=makeEnv({rules:[percentageRule()]});const row=e.service.createCalculation({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});e.service.submitToReview(row.id);eq(e.service.approve(row.id).workflowStatus,'approved');});
