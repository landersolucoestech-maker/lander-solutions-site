'use strict';
const assert=require('assert');
const fs=require('fs');
const path=require('path');
const browser=fs.readFileSync(path.resolve(__dirname,'crm_economic_participations_browser.js'),'utf8');
const css=fs.readFileSync(path.resolve(__dirname,'crm_economic_participations.css'),'utf8');
const materializer=fs.readFileSync(path.resolve(__dirname,'crm_economic_participations.py'),'utf8');
const materializePath=path.resolve(__dirname,'materialize.py');
const materialize=fs.existsSync(materializePath)?fs.readFileSync(materializePath,'utf8'):'';
let passed=0;
function test(name,fn){try{fn();passed++;console.log(`PASS ${passed} ${name}`);}catch(error){console.error(`FAIL ${name}`);throw error;}}
function hasAll(source,items){for(const item of items)assert(source.includes(item),`ausente: ${item}`);}

test('página oficial chama Participações',()=>{assert(browser.includes("crmFidelityPage('accounting','participacoes','Participações'"));});
test('breadcrumb é Financeiro / Participações',()=>{hasAll(browser,["label:'Financeiro',href:'#/crm/financeiro'","label:'Participações',href:'#/crm/financeiro/participacoes'"]);});
test('ação principal é Calcular Participações',()=>{assert(browser.includes('Calcular Participações'));assert(browser.includes('crm-part-calculate'));});
test('página não se transforma em Dashboard',()=>{const start=browser.indexOf('function crmEconomicParticipationsPage()'),end=browser.indexOf('function crmParticipationModalRoot',start),page=browser.slice(start,end);assert(!page.includes('Dashboard'));});
test('tabs oficiais existem',()=>{hasAll(browser,['Todos','Rascunhos','Em revisão','Aprovadas','Substituídas']);});
test('busca cobre participante contrato produto serviço período valor regra',()=>{assert(browser.includes('Buscar participante, contrato, produto, serviço, período, valor ou regra'));});
test('filtro Período existe',()=>{assert(browser.includes('crm-part-period'));});
test('período suporta mês trimestre ano personalizado',()=>{hasAll(browser,['Este mês','Este trimestre','Este ano','Personalizado']);});
test('filtro Contrato existe',()=>{assert(browser.includes('crm-part-contract'));});
test('filtro Participante usa identidade canônica',()=>{assert(browser.includes('crmParticipationPartyOptions'));assert(browser.includes('crmCanonicalPartyService()'));});
test('filtro Workflow existe',()=>{assert(browser.includes('crm-part-status'));});
test('filtro Consistência existe',()=>{assert(browser.includes('crm-part-consistency'));});
test('filtros Produto Serviço Unidade existem',()=>{hasAll(browser,['crm-part-product','crm-part-service','crm-part-unit']);});
test('filtros Base e Regra existem',()=>{hasAll(browser,['crm-part-basis','crm-part-rule']);});
test('TableView possui colunas operacionais',()=>{hasAll(browser,['Período</th>','Participante</th>','Contrato</th>','Produto/Serviço</th>','Base</th>','Percentual/Regra</th>','Valor</th>','Status</th>','Consistência</th>','Ação</th>']);});
test('paginação é limitada pelo domínio',()=>{assert(browser.includes('crm-part-pagination'));});
test('estado vazio não inventa Participações',()=>{hasAll(browser,['Nenhuma Participação calculada.','regras econômicas contratuais elegíveis']);});
test('resumo compacto tem quatro indicadores',()=>{const start=browser.indexOf('function crmParticipationSummary()'),end=browser.indexOf('function crmEconomicParticipationsPage',start),block=browser.slice(start,end);hasAll(block,['Participações calculadas','Valor aprovado','Pendentes de revisão','Cálculos bloqueados']);});
test('cálculo começa por período',()=>{hasAll(browser,['crm-part-calc-from','crm-part-calc-to']);});
test('cálculo pode ser restringido a Contrato',()=>{assert(browser.includes('crm-part-calc-contract'));});
test('prévia é obrigatória antes de persistir pela UI',()=>{hasAll(browser,['Prévia obrigatória','Pré-visualizar cálculo','Gere a prévia antes de criar o cálculo.']);});
test('prévia mostra Contrato Participante Base Regra Resultado',()=>{const start=browser.indexOf('function crmParticipationPreviewList'),end=browser.indexOf('function crmParticipationRunPreview',start),block=browser.slice(start,end);hasAll(block,['Base','Regra','Resultado','contractNumber','participantPartyId']);});
test('prévia exibe cálculo bloqueado',()=>{assert(browser.includes("p.calculationStatus==='blocked'"));assert(browser.includes('p.message'));});
test('prévia exibe segmentos quando regra muda',()=>{hasAll(browser,['Segmentos','p.segmentCount>1','p.segments.map']);});
test('cálculo em lote existe',()=>{assert(browser.includes('Criar rascunhos calculados'));assert(browser.includes('.createBatch(input)'));});
test('cálculo individual existe',()=>{assert(browser.includes('crm-part-create-one'));assert(browser.includes('.createCalculation('));});
test('gerado não é automaticamente aprovado',()=>{const start=browser.indexOf('function crmParticipationCreatePreview'),end=browser.indexOf('function crmParticipationSourceLink',start),block=browser.slice(start,end);assert(!block.includes('.approve('));});
test('regra vem do feed de Contratos',()=>{hasAll(browser,['crmContractEconomicRulesFeed','crmLegalContractService','rawRules']);});
test('resolver por período de Contratos é conectado',()=>{assert(browser.includes('crmContractResolveEconomicRuleForPeriod(input)'));});
test('metadata contratual é apenas enriquecida para cálculo',()=>{assert(browser.includes('metadata:JSON.parse(JSON.stringify(raw.metadata||{}))'));});
test('Contabilidade é dependência canônica',()=>{assert(browser.includes('accountingService:()=>crmAccountingService()'));});
test('Notas Fiscais é adapter read-only opcional',()=>{assert(browser.includes("fiscalService:()=>typeof crmFiscalService==='function'?crmFiscalService():null"));});
test('Rateios é adapter read-only opcional',()=>{assert(browser.includes("costAllocationService:()=>typeof crmCostAllocationService==='function'?crmCostAllocationService():null"));});
test('Pessoas/Organizações é owner de identidade',()=>{assert(browser.includes('partyService:()=>crmCanonicalPartyService()'));});
test('UI não pede percentual manual no fluxo de cálculo',()=>{const start=browser.indexOf('function crmParticipationOpenCalculator'),end=browser.indexOf('function crmParticipationSourceLink',start),block=browser.slice(start,end);assert(!block.includes('input id="percentage'));assert(!block.includes('Percentual<input'));});
test('UI não pede participante manual quando vem da regra',()=>{const start=browser.indexOf('function crmParticipationOpenCalculator'),end=browser.indexOf('function crmParticipationSourceLink',start),block=browser.slice(start,end);assert(!block.includes('crm-part-calc-participant'));});
test('UI não pede base manual quando vem da regra',()=>{const start=browser.indexOf('function crmParticipationOpenCalculator'),end=browser.indexOf('function crmParticipationSourceLink',start),block=browser.slice(start,end);assert(!block.includes('crm-part-calc-basis'));});
test('detalhe possui Resumo operacional',()=>{assert(browser.includes('crm-part-detail-summary'));});
test('detalhe possui Contrato e Regra',()=>{assert(browser.includes('<h3>Contrato e Regra</h3>'));});
test('detalhe possui Participante',()=>{assert(browser.includes('<span>Participante</span>'));});
test('detalhe possui Período e Segmentos',()=>{assert(browser.includes('<h3>Período e Segmentos</h3>'));});
test('detalhe possui Memória de Cálculo',()=>{assert(browser.includes('<h3>Memória de Cálculo</h3>'));});
test('detalhe possui Base de Cálculo',()=>{assert(browser.includes('Base de Cálculo · componentes'));});
test('detalhe possui Deduções',()=>{assert(browser.includes('<h3>Deduções</h3>'));});
test('detalhe possui Fontes e Snapshot',()=>{assert(browser.includes('<h3>Fontes e Snapshot</h3>'));});
test('detalhe possui Workflow',()=>{ass