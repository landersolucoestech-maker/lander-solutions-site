Id:'r1'});close(p.calculationBase,400);});
test('service_result exige serviceId',()=>{const e=makeEnv({rules:[percentageRule({basisType:'service_result',productId:'',serviceId:''})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});
test('distributable_base exige origem explícita',()=>{const e=makeEnv({rules:[percentageRule({basisType:'distributable_base',metadata:{accountingBasis:'accrual'}})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');assert(/origem explícita/.test(p.message));});
test('distributable_base usa baseSource contratual',()=>{const e=makeEnv({rules:[percentageRule({basisType:'distributable_base',metadata:{baseSource:'gross_revenue',accountingBasis:'accrual'}})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,925);});
test('custom_reference sem resolver bloqueia',()=>{const e=makeEnv({rules:[percentageRule({basisType:'custom_reference'})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');assert(/configuração explícita/.test(p.message));});
test('custom_reference com resolver formal funciona',()=>{const e=makeEnv({rules:[percentageRule({basisType:'custom_reference'})],customBaseResolver:()=>({amount:333,currency:'BRL',components:[{sourceType:'formal_resolver',sourceId:'resolver1',sourceKey:'resolver:1',description:'Referência formal',amount:333,signedAmount:333,sign:1}]})});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,333);close(p.participationAmount,66.6);});
test('pendência contábil bloqueia cálculo oficial',()=>{const rows=[{id:'r',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:100,currency:'BRL',productId:'prod1',issues:['unclassified']}];const e=makeEnv({rules:[percentageRule()],rows});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');eq(p.consistencyStatus,'needs_review');});
test('moeda incompatível na Contabilidade bloqueia',()=>{const rows=[{id:'usd',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita USD',contribution:100,currency:'USD',productId:'prod1'}];const e=makeEnv({rules:[percentageRule({currency:'BRL'})],rows});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');assert(/Moeda incompatível/.test(p.message));});

// Deductions and double counting.
test('imposto permitido é deduzido de gross_revenue',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,100);close(p.distributableBase,825);});
test('imposto não permitido não é deduzido',()=>{const e=makeEnv({rules:[percentageRule()]});close(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).deductionsTotal,0);});
test('custo elegível é deduzido quando permitido',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Custos elegíveis']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,200);});
test('custo não elegível não é deduzido',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(!p.deductions.some(d=>d.deductionType==='costs'));});
test('dedução é rastreável até a origem',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})]});const d=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).deductions[0];assert(d.sourceType);assert(d.sourceId);assert(d.description);assert(d.contractPermission);});
test('soma das deduções reconcilia',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos','Custos elegíveis']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,p.deductions.reduce((s,d)=>s+Number(d.appliedAmount||0),0));});
test('base distribuível reconcilia base menos deduções',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos','Custos elegíveis']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.distributableBase,p.calculationBase-p.deductionsTotal);});
test('net_revenue não deduz novamente imposto já contido',()=>{const e=makeEnv({rules:[percentageRule({basisType:'net_revenue',deductions:['Impostos']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,825);close(p.deductionsTotal,0);assert(p.deductions.some(d=>d.alreadyIncludedInBase));});
test('product_result não deduz novamente custo já contido',()=>{const e=makeEnv({rules:[percentageRule({basisType:'product_result',deductions:['Custos elegíveis']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,0);assert(p.deductions.some(d=>d.alreadyIncludedInBase));});
test('Nota Fiscal só contribui com imposto quando permitido',()=>{const docs=[{fiscalDocumentId:'nf1',status:'issued',issueDate:'2026-08-05',currency:'BRL',taxes:[{id:'t1',taxType:'ISS',amount:30}],retentions:[],transactionIds:[],productId:'prod1',isDemo:false}];const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})],rows:[{id:'r',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:1000,currency:'BRL',productId:'prod1'}],fiscalDocs:docs});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,30);});
test('imposto fiscal vinculado a dedução contábil não duplica',()=>{const docs=[{fiscalDocumentId:'nf1',status:'issued',issueDate:'2026-08-05',currency:'BRL',taxes:[{id:'t1',taxType:'ISS',amount:100}],retentions:[],transactionIds:['tax1'],productId:'prod1',isDemo:false}];const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})],fiscalDocs:docs});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.deductionsTotal,100);assert(p.deductions.some(d=>d.sourceType==='fiscal_document'&&d.appliedAmount===0));});
test('moeda fiscal incompatível bloqueia dedução',()=>{const docs=[{fiscalDocumentId:'nf1',status:'issued',issueDate:'2026-08-05',currency:'USD',taxes:[{id:'t1',taxType:'Tax',amount:10}],retentions:[],transactionIds:[],productId:'prod1',isDemo:false}];const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})],fiscalDocs:docs});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});
test('Rateio postado consistente pode representar custo elegível',()=>{const allocations={cost1:{allocation:{id:'alloc1',name:'Rateio custo',status:'posted',consistencyStatus:'consistent'},lines:[{id:'line1',destinationType:'product',destinationId:'prod1',amount:200}]}};const e=makeEnv({rules:[percentageRule({deductions:['Rateios elegíveis']})],allocations});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(p.deductions.some(d=>d.sourceType==='cost_allocation'&&d.sourceId==='alloc1'));close(p.deductionsTotal,200);});
test('Rateio estornado não é consumido como posted',()=>{const allocations={cost1:{allocation:{id:'alloc1',status:'reversed',consistencyStatus:'consistent'},lines:[]}};const e=makeEnv({rules:[percentageRule({deductions:['Rateios elegíveis']})],allocations});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId