est('Organization canônica pode ser participante',()=>{const e=makeEnv({rules:[percentageRule({participantPartyType:'organization',participantPartyId:'o1'})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.participantPartyType,'organization');eq(p.participantPartyId,'o1');});

// Contract, version, rule and period resolution.
test('cálculo referencia Contrato',()=>{const e=makeEnv({rules:[percentageRule()]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).contractId,'ctr1');});
test('cálculo referencia ContractVersion',()=>{const e=makeEnv({rules:[percentageRule()]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).contractVersionId,'v1');});
test('cálculo referencia EconomicRule',()=>{const e=makeEnv({rules:[percentageRule()]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).economicRuleId,'r1');});
test('percentual vem da regra contratual',()=>{const e=makeEnv({rules:[percentageRule({percentage:23})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).percentage,23);});
test('base vem da regra contratual',()=>{const e=makeEnv({rules:[percentageRule({basisType:'net_revenue'})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).basisType,'net_revenue');});
test('deduções vêm da regra contratual',()=>{const e=makeEnv({rules:[percentageRule({deductions:['Impostos']})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(p.deductions.some(d=>d.contractPermission==='taxes'));});
test('regra fora da vigência não é elegível',()=>{const e=makeEnv({rules:[percentageRule({effectiveUntil:'2026-07-31'})]});eq(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationStatus,'blocked');});
test('versão histórica superseded pode ser fornecida pelo feed para período histórico',()=>{const e=makeEnv({rules:[percentageRule({versionId:'v_old',versionNumber:1,effectiveFrom:'2026-01-01',effectiveUntil:'2026-06-30'})]});const p=e.service.preview({from:'2026-03-01',to:'2026-03-31',economicRuleId:'r1'});eq(p.contractVersionId,'v_old');});
test('mudança de versão no período gera segmentos',()=>{const r1=percentageRule({versionId:'v1',ruleId:'r1',percentage:20,effectiveUntil:'2026-06-30'}),r2=percentageRule({versionId:'v2',versionNumber:2,ruleId:'r2',percentage:25,effectiveFrom:'2026-07-01'});const e=makeEnv({rules:[r1,r2],rows:[{id:'jun',date:'2026-06-20',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:1000,currency:'BRL',productId:'prod1'},{id:'jul',date:'2026-07-20',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:2000,currency:'BRL',productId:'prod1'}]});const p=e.service.preview({from:'2026-06-01',to:'2026-07-31',economicRuleId:'r1'});eq(p.segmentCount,2);eq(p.segments[0].percentage,20);eq(p.segments[1].percentage,25);close(p.segments[0].participationAmount,200);close(p.segments[1].participationAmount,500);close(p.participationAmount,700);});
test('segmentação não usa média simples dos percentuais',()=>{const r1=percentageRule({versionId:'v1',ruleId:'r1',percentage:20,effectiveUntil:'2026-08-15'}),r2=percentageRule({versionId:'v2',versionNumber:2,ruleId:'r2',percentage:30,effectiveFrom:'2026-08-16'});const e=makeEnv({rules:[r1,r2],rows:[{id:'a',date:'2026-08-10',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:100,currency:'BRL',productId:'prod1'},{id:'b',date:'2026-08-20',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:300,currency:'BRL',productId:'prod1'}]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.participationAmount,110);assert.notStrictEqual(p.participationAmount,100);});
test('conflito de vigência bloqueia cálculo',()=>{const e=makeEnv({rules:[percentageRule(),percentageRule({ruleId:'r_conflict',percentage:30})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');eq(p.consistencyStatus,'conflict');eq(p.message,'Conflito contratual de vigência.');});
test('lacuna de regra no período bloqueia cálculo',()=>{const e=makeEnv({rules:[percentageRule({effectiveFrom:'2026-08-10',effectiveUntil:'2026-08-31'})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');assert(/intervalo sem regra/.test(p.message));});

// Bases and canonical Accounting behavior.
test('gross_revenue usa Receita Bruta canônica',()=>{const e=makeEnv({rules:[percentageRule()]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,925);});
test('pending não contamina gross_revenue',()=>{const e=makeEnv({rules:[percentageRule()]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(p.calculationBase<1800);});
test('transferência não entra como receita',()=>{const e=makeEnv({rules:[percentageRule()]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(p.calculationBase<1700);});
test('excluded não entra na base',()=>{const e=makeEnv({rules:[percentageRule()]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(p.calculationBase<1600);});
test('demo não entra na base',()=>{const e=makeEnv({rules:[percentageRule()]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});assert(p.calculationBase<1500);});
test('estorno reduz gross_revenue',()=>{const e=makeEnv({rules:[percentageRule()]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,925);});
test('chargeback reduz gross_revenue',()=>{const rows=[{id:'r',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita',contribution:1000,currency:'BRL',productId:'prod1'},{id:'c',date:'2026-08-06',status:'posted',isDemo:false,nature:'chargeback',section:'gross_revenue',name:'Chargeback',contribution:-100,currency:'BRL',productId:'prod1'}];const e=makeEnv({rules:[percentageRule()],rows});close(e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'}).calculationBase,900);});
test('net_revenue reutiliza Receita Líquida da Contabilidade',()=>{const e=makeEnv({rules:[percentageRule({basisType:'net_revenue'})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,825);});
test('product_result reutiliza resultado dimensional final',()=>{const e=makeEnv({rules:[percentageRule({basisType:'product_result'})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});close(p.calculationBase,625);});
test('product_result exige productId',()=>{const e=makeEnv({rules:[percentageRule({basisType:'product_result',productId:''})]});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRuleId:'r1'});eq(p.calculationStatus,'blocked');assert(/productId/.test(p.message));});
test('service_result reutiliza resultado dimensional de Serviço',()=>{const rows=[{id:'sr',date:'2026-08-05',status:'posted',isDemo:false,nature:'revenue',section:'gross_revenue',name:'Receita Serviço',contribution:500,currency:'BRL',serviceId:'svc1'},{id:'sc',date:'2026-08-06',status:'posted',isDemo:false,nature:'expense',section:'costs',name:'Custo Serviço',contribution:-100,currency:'BRL',serviceId:'svc1'}];const e=makeEnv({rules:[percentageRule({basisType:'service_result',productId:'',serviceId:'svc1'})],rows});const p=e.service.preview({from:'2026-08-01',to:'2026-08-31',economicRule