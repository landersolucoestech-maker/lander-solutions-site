`;const k=`<div class="crm-ref-kpis five">${crmRefKpi('Total de Tarefas',0,'demandas cadastradas')}${crmRefKpi('Concluídas',0,'finalizadas','success')}${crmRefKpi('A Fazer',0,'backlog e a fazer')}${crmRefKpi('Em Andamento',0,'em execução','warning')}${crmRefKpi('Revisão',0,'em revisão','danger')}</div>`;const filters=crmRefToolbar(`<label class="crm-ref-search">${icon('search',14)}<input placeholder="Buscar tarefa..."></label><select><option>Tipo</option><option>Todos os tipos</option></select>`);const table=`<section class="crm-ref-table-card"><header><div><h3>Lista de Tarefas</h3><p>Acompanhe tarefas, tipos, responsáveis, prazos e status</p></div><span>${rows.length}</span></header>${crmRefEmpty('Nenhuma tarefa encontrada','Crie tarefas operacionais para organizar as demandas do marketing.')}</section>`;return crmRefPage('marketing','tasks','Marketing · Tarefas','Núcleo operacional de tarefas',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'tasks','#/crm/marketing')}${actions}${k}${filters}${table}`);}
  function crmRefAIPage(){const tabs=['Ideias','Perfil','Pitching','Tendências','Analytics','Planejamento','Histórico'];const active=state.crmRefAiTab||'Ideias';let content='';if(active==='Ideias')content=`<div class="crm-ref-ai-hero"><span>IA Criativa</span><h2>O que você quer criar?</h2><p>Selecione o contexto, defina o objetivo e descreva o briefing.</p></div><div class="crm-ref-form-grid">${crmRefSelect('Contexto','context',[['empresa','Empresa'],['artista','Artista'],['projeto','Projeto Musical']])}${crmRefSelect('Objetivo','objective',[['conteudo','Ideias de conteúdo'],['campanha','Campanha'],['posicionamento','Posicionamento']])}${crmRefTextarea('Briefing','briefing','Descreva o que precisa criar...')}</div><button class="crm-ref-primary-wide">Gerar ideias</button>`;else if(active==='Planejamento')content=`<div class="crm-ref-form-grid">${crmRefField('Artista opcional','artist','text','Selecionar artista')}${crmRefField('Lançamento opcional','release','text','Selecionar lançamento')}${crmRefField('Objetivo','objective')}${crmRefField('Plataforma','platform')}${crmRefSelect('Período','period',[['7','7 dias'],['30','30 dias'],['60','60 dias'],['90','90 dias']])}</div><button class="crm-ref-primary-wide">Gerar planejamento</button>`;else if(active==='Pitching')content=`<div class="crm-ref-form-grid">${crmRefField('Artista','artist','text','Selecione o artista')}${crmRefField('Lançamento','release','text','Selecione o lançamento')}${crmRefTextarea('Letra','lyrics','Letra pendente no cadastro. Revise apenas se necessário.')}${crmRefTextarea('Referências','references','Referências pendentes no cadastro. Ajuste se necessário.')}${crmRefTextarea('Diferenciais','differentials','Opcional: gancho editorial, contexto de carreira, feat, campanha, bastidores...')}</div><button class="crm-ref-primary-wide">Gerar pitching</button>`;else content=crmRefEmpty(`Nenhum resultado em ${active}`,'Execute uma análise para visualizar os resultados aqui.');return crmRefPage('marketing','ai','IA Criativa','Criação, perfil, pitching, tendências, métricas e histórico.',`${crmRefSubtabs(CRM_REF_MARKETING_SUB,'ai','#/crm/marketing')}<nav class="crm-ref-ai-tabs">${tabs.map(t=>`<button class="${active===t?'active':''}" data-action="crm-ref-ai-tab" data-tab="${esc(t)}">${esc(t)}</button>`).join('')}</nav><section class="crm-ref-panel crm-ref-ai-panel">${content}</section>`);}
  function crmRefCampaignModal(){
    const steps=['Objetivo','Resultado','Dados','Público','Plataformas','Posicionamentos','Criativos','Orçamento','Revisao'];
    const objectives=[['Alcance','Aumentar a exposição da campanha para o maior número possível de pessoas.'],['Tráfego','Levar pessoas para um site, landing page, smart link ou canal externo.'],['Engajamento','Gerar curtidas, comentários, mensagens, compartilhamentos e interações.'],['Conversões','Gerar vendas, inscrições, cadastros, pré-saves ou outras ações específicas.']];
    const outcomes=['Alcance','Reconhecimento de marca','Visualizações de vídeo','Cliques no link','Visualizações da landing page','Visitas ao site','Cliques no smart link','Cliques no WhatsApp','Visitas ao perfil','Engajamento em post','Mensagens','Comentários','Compartilhamentos','Seguidores','Engajamento em vídeo','Leads','Vendas','Pré-save','Streams','Inscrições','Downloads','Contato via WhatsApp','Envio de formulário'];
    const platforms=['Meta Ads','Google Ads','YouTube Ads','TikTok Ads','Spotify Ads'];
    const placements=['Meta Ads · Feed · 1:1','Meta Ads · Stories · 9:16','Meta Ads · Reels · 9:16','Meta Ads · Explore · 1:1','Meta Ads · Carrossel · 1:1','Google Ads · Search · texto','Google Ads · Display · 1.91:1','Google Ads · Discovery · 1.91:1','YouTube Ads · In-stream · 16:9','YouTube Ads · Shorts · 9:16','YouTube Ads · Search · 16:9','YouTube Ads · Discovery · 16:9','TikTok Ads · For You · 9:16','TikTok Ads · Search · 9:16','TikTok Ads · Profile feed · 9:16','Spotify Ads · Audio','Spotify Ads · Vídeo','Spotify Ads · Homepage','Spotify Ads · Overlay'];
    return `<div class="crm-ref-modal-backdrop" data-action="crm-ref-modal-close"></div><section class="crm-ref-modal crm-ref-campaign-modal" role="dialog" aria-modal="true"><header><div><h2>Nova campanha</h2><p>Configure a campanha em etapas com regras do Campaign Builder.</p></div><button type="button" data-action="crm-ref-modal-close">×</button></header><form id="crm-ref-campaign-form"><div class="crm-ref-stepper">${steps.map((s,i)=>`<button type="button" class="${i===0?'active':''}" data-campaign-step-button="${i+1}"><b>${i+1}</b><span>${esc(s)}</span></button>`).join('')}</div><div class="crm-ref-campaign-layout"><main class="crm-ref-campaign-stage">
      <section data-campaign-step="1"><div class="crm-ref-objective-layout"><div class="crm-ref-objective-list">${objectives.map(([l])=>`<button type="button"><strong>${esc(l)}</strong></button>`).join('')}</div><article class="crm-ref-objective-copy"><h3>Alcance</h3><p>${esc(objectives[0][1])}</p><small>Bom para:</small><div><span>Alcance</span><span>Reconhecimento de marca</span><span>Visualizações de vídeo</span></div></article></div></section>
      <section data-campaign-step="2" hidden><div class="crm-ref-choice-grid two">${outcomes.map(o=>`<button type="button"><strong>${esc(o)}</strong><small>Resultado esperado para o objetivo selecionado.</small></button>`).join('')}</div></section>
      <section data-campaign-step="3" hidden><div class="crm-ref-form-grid">${crmRefSelect('Contexto','context',[['empresa','Empresa'],['artista','Artista']])}${crmRefField('Nome da campanha','name')}${crmRefField('Plataformas de publicação (seleção múltipla)','publishChannels','text','Instagram, Facebook, TikTok…')}${crmRefField('Responsável','owner','text','Selecione um usuário')}${crmRefSelect('O que sera promovido','promotedType',[['ARTIST','Artista'],['MUSIC_PROJECT','Projeto musical'],['RELEASE','Lançamento'],['EVENT','Evento'],['PRODUCT','Produto'],['SERVICE','Serviço'],['COMPANY','Empresa'],['OTHER','Outro']])}${crmRefField('Entidade vinculada','promotedEntity','text','Selecione uma entidade cadastrada')}${crmRefField('URL de destino','destination','url','https://...')}${crmRefField('Projeto vinculado','project','text','Selecione um projeto')}${crmRefField('Conteúdo publicado para promoção','content','text','Selecione um conteúdo publicado')}${crmRefSelect('Fase','phase',[['pre_lancamento','Pré-lançamento'],['lancamento','Lançamento'],['sustentacao','Sustentação'],['catalogo','Catálogo']])}${crmRefField('Tags','tags')}${crmRefTextarea('Descrição interna','internalDescription')}</div></section>
      <section data-campaign-step="4" hidden><div class="crm-ref-form-grid">${crmRefField('Países','countries','text','Selecione um pais')}${crmRefField('Estados / Cidades','cities','text','Busque localizações')}${crmRefField('Idade mínima','minAge','number','18')}${crmRefField('Idade máxima','maxAge','number','65')}${crmRefSelect('Gênero','gender',[['todos','Todos'],['feminino','Feminino'],['masculino','Masculino'],['nao_binario','Não binário'],['nao_informado','Não informado']])}${crmRefField('Idioma','language','text','Selecione um idioma')}${crmRefField('Segmentação geográfica','geo','text','Mapa + raio')}${crmRefField('Interesses','interests','text','Música, entretenimento…')}${crmRefField('Exclusões / remarketing','exclusions','text','Públicos excluídos ou remarketing')}</div></section>
      <section data-campaign-step="5" hidden><div class="crm-ref-choice-grid two">${platforms.map(p=>`<button type="button"><strong>${esc(p)}</strong><small>Selecionar plataforma</small></button>`).join('')}</div></section>
      <section data-campaign-step="6" hidden><div class="crm-ref-choice-grid two">${placements.map(p=>`<button type="button"><strong>${esc(p)}</strong></button>`).join('')}</div></section>
      <section data-campaign-step="7" hidden><section class="crm-ref-form-section"><h3>Conteúdos existentes</h3><p>Nenhum conteúdo cadastrado para selecionar. Crie conteúdos no Calendário de Conteúdo.</p></section><section class="crm-ref-form-section"><h3>Criativo</h3><div class="crm-ref-form-grid">${crmRefField('Nome','creativeName')}${crmRefSelect('Tipo','creativeType',[['video','video'],['imagem','imagem'],['audio','audio'],['texto','texto']])}${crmRefField('Formato','format','text','Posicionamento / proporção')}${crmRefField('Arquivo','file','file')}${crmRefTextarea('Copy principal','primaryCopy')}${crmRefField('Headline','headline')}${crmRefField('CTA','cta','text','Saiba mais')}${crmRefField('URL destino','creativeUrl','url')}${crmRefField('UTM final','utm')}</div></section></section>
      <section data-campaign-step="8" hidden><div class="crm-ref-form-grid">${crmRefField('Orçamento total','totalBudget','number')}${crmRefField('Orçamento diário','dailyBudget','number')}${crmRefField('Moeda','currency','text','BRL','BRL')}${crmRefField('Data inicial','startDate','date')}${crmRefField('Data final','endDate','date')}${crmRefSelect('Estratégia','strategy',[['menor_custo','Menor custo'],['limite_custo','Limite de custo'],['custo_alvo','Custo alvo']])}</div></section>
      <section data-campaign-step="9" hidden><div class="crm-ref-grid two"><section class="crm-ref-panel"><header><h3>Erros bloqueantes</h3></header><p>Nenhum item.</p></section><section class="crm-ref-panel"><header><h3>Avisos</h3></header><p>Nenhum item.</p></section><section class="crm-ref-panel"><header><h3>Links/UTMs</h3></header><p>Nenhum item.</p></section><section class="crm-ref-panel"><header><h3>Criativos pendentes</h3></header><p>Nenhum item.</p></section></div></section>
    </main><aside class="crm-ref-campaign-side"><section><h3>Investimento</h3><div class="crm-ref-form-grid">${crmRefField('Valor total','sideBudget','number')}${crmRefField('Dias','sideDays','number','','1')}</div><p>Diario estimado: BRL 0</p></section><section><h3>Resumo</h3><dl><dt>Objetivo</dt><dd>Alcance</dd><dt>Resultado</dt><dd>Pendente</dd><dt>Entidade</dt><dd>Pendente</dd><dt>Plataformas</dt><dd>Pendente</dd><dt>Posicionamentos</dt><dd>Pendente</dd></dl></section><section><h3>Preview</h3><div class="crm-ref-phone-preview"><strong>Preview criativo</strong><span>9:16</span><p>Nova campanha</p><small>Mídia / arquivo</small></div></section></aside></div><footer><button type="button" class="secondary" data-action="crm-ref-campaign-prev" disabled>Voltar</button><div><button type="submit" class="secondary">${icon('save',13)} Salvar rascunho</button><button type="button" class="primary" data-action="crm-ref-campaign-next">Próximo</button></div></footer></form></section>`;
  }
  function crmRefContentModal(){return `<div class="crm-ref-modal-backdrop" data-action="crm-ref-modal-close"></div><section class="crm-ref-modal wide" role="dialog" aria-modal="true"><header><h2>Novo Conteúdo</h2><button type="button" data-action="crm-ref-modal-close">×</button></header><form id="crm-ref-content-form"><div class="crm-ref-modal-body"><div class="crm-ref-form-grid">${crmRefField('Título *','title','text','Ex: Post de lançamento do novo single')}${crmRefSelect('Contexto *','context',[['empresa','Empresa'],['artista','Artista']])}${crmRefField('Artista *','artist','text','Selecione o artista')}<label class="crm-ref-field full"><span>Plataformas (publicação multiplataforma) *</span><div class="crm-ref-chip-select">${['Instagram','Facebook','TikTok','YouTube','Reels','Stories'].map(x=>`<button type="button">${x}</button>`).join('')}</div><small>A primeira plataforma selecionada define o formato e a prévia.</small></label>${crmRefSelect('Tipo de conteudo *','type',[['post','Post'],['video','Vídeo'],['story','Story'],['reel','Reel'],['carrossel','Carrossel'],['short','Short']])}${crmRefField('Data *','date','date','Selecionar data')}${crmRefField('Hora *','time','time')}${crmRefTextarea('Legenda / Copy *','copy','Escreva a legenda da publicação...')}<details class="crm-ref-advanced full"><summary>Configurações avançadas <span>⌄</span></summary><div class="crm-ref-form-grid">${crmRefSelect('Conta integrada (publicação)','account',[['none','Nenhuma (apenas agendar)']])}${crmRefSelect('Status','status',[['rascunho','Rascunho'],['agendado','Agendado'],['publicado','Publicado'],['cancelado','Cancelado']])}${crmRefField('Campanha relacionada','campaign','text','Nome da campanha...')}${crmRefField('Hashtags','hashtags','text','#musica #lançamento...')}${crmRefField('Localização','location','text','Ex: São Paulo, Brasil')}</div></details></div></div><footer><button type="button" class="secondary" data-action="crm-ref-modal-close">Cancelar</button><button type="submit" class="secondary">Agendar Conteúdo</button><button type="button" class="primary">Publicar via Integração</button></footer></form></section>`;}
  function crmRefBriefingModal(){return crmRefModal('Novo Briefing',`<div class="crm-ref-form-grid">${crmRefField('Título *','title')}${crmRefSelect('Tipo','type',[['campanha','Campanha'],['conteudo','Conteúdo'],['projeto','Projeto']])}${crmRefSelect('Status','status',[['rascunho','Rascunho'],['revisao','Em revisão'],['aprovado','Aprovado']])}${crmRefField('Prazo','deadline','date')}${crmRefField('Responsáveis','owners','text','Separe por vírgulas')}${crmRefTextarea('Objetivo','objective')}${crmRefTextarea('Contexto / necessidade','context')}</div>`,'crm-ref-briefing-form',true);}
  function crmRefTaskModal(){return crmRefModal('Nova Tarefa',`<div class="crm-ref-form-grid">${crmRefField('Título *','title')}${crmRefSelect('Contexto','context',[['empresa','Empresa'],['artista','Artista'],['projeto_musical','Projeto Musical']])}${crmRefField('Projeto musical, artista ou empresa','target','text','Busque por projeto, artista ou empresa')}${crmRefField('Setor','sector','text','Selecione antes o contexto')}${crmRefField('Tipo','type','text','Selecione um setor primeiro')}${crmRefField('Responsável','owner')}${crmRefSelect('Prioridade','priority',[['baixa','Baixa'],['media','Média'],['alta','Alta'],['critica','Crítica']])}${crmRefField('Prazo','deadline','date')}</div>`,'crm-ref-task-form');}

  function crmRefMusicChatPage(){crmRefEnsureState();const d=state.crmRefMusicChat;const tab=d.tab||'messages';let body='';if(tab==='messages')body=`<div class="crm-ref-grid one"><section class="crm-ref-panel"><header><h3>Fluxo inicial</h3><label class="crm-ref-switch"><input type="checkbox" ${d.enabled?'checked':''}> Automação ativa</label></header>${crmRefTextarea('Mensagem inicial de boas-vindas','welcome','',d.welcome)}${crmRefTextarea('Menu principal de triagem','menu','',d.menu)}</section><section class="crm-ref-panel"><header><h3>Mensagens de exceção e encerramento</h3></header><div class="crm-ref-form-grid">${crmRefTextarea('Opção inválida','invalid','',d.invalid)}${crmRefTextarea('Ausência de resposta','absence','',d.absence)}${crmRefTextarea('Fora do horário de atendimento','out','',d.outHours)}${crmRefTextarea('Encerramento','closing','',d.closing)}</div></section></div>`;if(tab==='menu')body=`<section class="crm-ref-pan